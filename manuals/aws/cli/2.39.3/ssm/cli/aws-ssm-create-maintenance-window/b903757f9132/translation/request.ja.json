    },
    {
      "id": "s0152",
      "kind": "paragraph",
      "text": "The following [[p0]] example creates a new maintenance window that only runs one time on the specified date and time.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "create-maintenance-window"
