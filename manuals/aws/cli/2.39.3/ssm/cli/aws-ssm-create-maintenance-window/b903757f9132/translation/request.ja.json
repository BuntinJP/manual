    {
      "id": "s0003",
      "kind": "heading",
      "text": "Description¶",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "Creates a new maintenance window.",
      "protected": []
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "Note",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "The value you specify for [[p0]] determines the specific end time for the maintenance window based on the time it begins. No maintenance window tasks are permitted to start after the resulting endtime minus the number of hours you specify for [[p1]] . For example, if the maintenance window starts at 3 PM, the duration is three hours, and the value you specify for [[p2]] is one hour, no maintenance window tasks can start after 5 PM.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Duration"
        },
        {
          "token": "[[p1]]",
          "text": "Cutoff"
        },
        {
          "token": "[[p2]]",
          "text": "Cutoff"
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "See also: [[p0]]",
      "protected": [
