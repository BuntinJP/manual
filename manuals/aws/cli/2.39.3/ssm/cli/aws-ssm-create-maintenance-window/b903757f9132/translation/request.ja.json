          "token": "[[p0]]",
          "text": "--start-date"
        }
      ]
    },
    {
      "id": "s0022",
      "kind": "paragraph",
      "text": "The date and time, in ISO-8601 Extended format, for when you want the maintenance window to become active. [[p0]] allows you to delay activation of the maintenance window until the specified future date.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "StartDate"
        }
      ]
    },
    {
      "id": "s0023",
      "kind": "heading",
