      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--ca-bundle"
          }
        }
      ]
    },
    {
      "id": "s0076",
      "kind": "paragraph",
      "text": "The CA certificate bundle to use when verifying SSL certificates. Overrides config/env settings.",
      "protected": []
    },
    {
      "id": "s0077",
      "kind": "paragraph",
      "text": "[[p0]] (int)",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--cli-read-timeout"
          }
        }
      ]
    },
    {
      "id": "s0078",
      "kind": "paragraph",
      "text": "The maximum socket read time in seconds. If the value is set to 0, the socket read will be blocking and not timeout. The default value is 60 seconds.",
      "protected": []
    },
    {
      "id": "s0079",
      "kind": "paragraph",
      "text": "[[p0]] (int)",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--cli-connect-timeout"
          }
        }
      ]
    },
    {
      "id": "s0080",
      "kind": "paragraph",
      "text": "The maximum socket connect time in seconds. If the value is set to 0, the socket connect will be blocking and not timeout. The default value is 60 seconds.",
      "protected": []
    },
    {
      "id": "s0081",
      "kind": "paragraph",
      "text": "[[p0]] (string)",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--cli-binary-format"
          }
        }
      ]
    },
    {
      "id": "s0082",
      "kind": "paragraph",
      "text": "The formatting style to be used for binary blobs. The default format is base64. The base64 format expects binary blobs to be provided as a base64 encoded string. The raw-in-base64-out format preserves compatibility with AWS CLI V1 behavior and binary values must be passed literally. When providing contents from a file that map to a binary blob [[p0]] will always be treated as binary and use the file contents directly regardless of the [[p1]] setting. When using [[p2]] the file contents will need to properly formatted for the configured [[p3]].",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "fileb://"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
