    {
      "id": "s0110",
      "kind": "paragraph",
      "text": "The following [[p0]] example sends an Approve signal to an Automation execution.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "send-automation-signal"
          }
        }
      ]
    },
