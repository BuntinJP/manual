      "id": "s0170",
      "kind": "paragraph",
      "text": "pattern: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "^[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}$"
