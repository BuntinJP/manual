      "protected": []
    },
    {
      "id": "s0159",
      "kind": "paragraph",
      "text": "WindowId -> (string)",
      "protected": []
    },
    {
      "id": "s0160",
      "kind": "paragraph",
      "text": "The maintenance window ID specified in the update request.",
      "protected": []
    },
    {
      "id": "s0161",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0162",
      "kind": "paragraph",
      "text": "min: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "20"
        }
      ]
    },
    {
      "id": "s0163",
      "kind": "paragraph",
      "text": "max: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "20"
        }
      ]
    },
    {
      "id": "s0164",
      "kind": "paragraph",
      "text": "pattern: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "^mw-[0-9a-f]{17}$"
        }
      ]
    },
    {
      "id": "s0165",
