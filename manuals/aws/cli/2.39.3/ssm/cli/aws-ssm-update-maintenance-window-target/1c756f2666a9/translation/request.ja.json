    {
      "id": "s0151",
      "kind": "heading",
      "text": "Note",
      "protected": []
    },
    {
      "id": "s0152",
      "kind": "paragraph",
      "text": "To use the following examples, you must have the AWS CLI installed and configured. See the [[p0]] in the [[p1]]AWS CLI User Guide[[p2]] for more information.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Getting started guide"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0153",
      "kind": "paragraph",
      "text": "Unless otherwise stated, all examples have unix-like quotation rules. These examples will need to be adapted to your terminal’s quoting rules. See [[p0]] in the [[p1]]AWS CLI User Guide[[p2]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Using quotation marks with strings"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0154",
      "kind": "paragraph",
      "text": "[[p0]]To update a maintenance window target[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<strong>"
        },
        {
          "token": "[[p1]]",
          "text": "</strong>"
        }
      ]
    },
    {
      "id": "s0155",
      "kind": "paragraph",
      "text": "The following [[p0]] example updates only the name of a maintenance window target.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "update-maintenance-window-target"
        }
      ]
    },
    {
      "id": "s0156",
      "kind": "paragraph",
      "text": "Output:",
      "protected": []
    },
    {
      "id": "s0157",
      "kind": "paragraph",
      "text": "For more information, see [[p0]] in the [[p1]]AWS Systems Manager User Guide[[p2]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Update a Maintenance Window (AWS CLI)"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
