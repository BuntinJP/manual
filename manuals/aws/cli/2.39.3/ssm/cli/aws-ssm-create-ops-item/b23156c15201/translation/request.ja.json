          "token": "[[p0]]",
          "text": "/aws/issue"
        }
      ]
    },
    {
      "id": "s0020",
      "kind": "paragraph",
      "text": "[[p0]] This type of OpsItem is used by OpsCenter for aggregating and reporting on duplicate OpsItems.",
      "protected": [
