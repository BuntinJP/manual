      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "Creates a new OpsItem. You must have permission in Identity and Access Management (IAM) to create a new OpsItem. For more information, see [[p0]] in the [[p1]]Amazon Web Services Systems Manager User Guide[[p2]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Set up OpsCenter"
