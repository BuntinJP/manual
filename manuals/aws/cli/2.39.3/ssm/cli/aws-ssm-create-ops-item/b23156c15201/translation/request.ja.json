        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "paragraph",
      "text": "Operations engineers and IT professionals use Amazon Web Services Systems Manager OpsCenter to view, investigate, and remediate operational issues impacting the performance and health of their Amazon Web Services resources. For more information, see [[p0]] in the [[p1]]Amazon Web Services Systems Manager User Guide[[p2]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Amazon Web Services Systems Manager OpsCenter"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "See also: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
