    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "The type of OpsItem to create. Systems Manager supports the following types of OpsItems:",
      "protected": []
    },
    {
      "id": "s0019",
      "kind": "paragraph",
      "text": "[[p0]] This type of OpsItem is used for default OpsItems created by OpsCenter.",
      "protected": [
