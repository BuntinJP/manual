          "token": "[[p0]]",
          "text": "/aws/insight"
        }
      ]
    },
    {
      "id": "s0021",
      "kind": "paragraph",
      "text": "[[p0]] This type of OpsItem is used by Change Manager for reviewing and approving or rejecting change requests.",
