    {
      "id": "s0088",
      "kind": "heading",
      "text": "Examples¶",
      "protected": []
    },
    {
      "id": "s0089",
      "kind": "heading",
      "text": "Note",
      "protected": []
    },
    {
      "id": "s0090",
      "kind": "paragraph",
      "text": "To use the following examples, you must have the AWS CLI installed and configured. See the [[p0]] in the [[p1]]AWS CLI User Guide[[p2]] for more information.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Getting started guide"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0091",
      "kind": "paragraph",
      "text": "Unless otherwise stated, all examples have unix-like quotation rules. These examples will need to be adapted to your terminal’s quoting rules. See [[p0]] in the [[p1]]AWS CLI User Guide[[p2]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Using quotation marks with strings"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0092",
      "kind": "paragraph",
      "text": "[[p0]]Example 1: To view your inventory schema[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<strong>"
        },
        {
          "token": "[[p1]]",
          "text": "</strong>"
        }
      ]
    },
    {
      "id": "s0093",
      "kind": "paragraph",
      "text": "The following [[p0]] example returns a list of inventory type names for the account.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "get-inventory-schema"
        }
      ]
    },
    {
      "id": "s0094",
      "kind": "paragraph",
      "text": "Output:",
      "protected": []
    },
    {
      "id": "s0095",
      "kind": "paragraph",
      "text": "For more information, see [[p0]] in the [[p1]]AWS Systems Manager User Guide[[p2]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Metadata collected by Inventory"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0096",
      "kind": "paragraph",
      "text": "[[p0]]Example 2: To view the inventory schema for a specific inventory type[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<strong>"
        },
        {
          "token": "[[p1]]",
          "text": "</strong>"
        }
      ]
    },
    {
      "id": "s0097",
      "kind": "paragraph",
      "text": "The following [[p0]] example returns the inventory schema for the [[p1]] inventory type.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "get-inventory-schema"
        },
        {
          "token": "[[p1]]",
          "text": "AWS:AWSComponent"
        }
      ]
    },
    {
      "id": "s0098",
      "kind": "paragraph",
      "text": "Output:",
      "protected": []
    },
    {
      "id": "s0099",
      "kind": "paragraph",
      "text": "For more information, see [[p0]] in the [[p1]]AWS Systems Manager User Guide[[p2]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Metadata collected by Inventory"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0100",
      "kind": "heading",
      "text": "Output¶",
      "protected": []
    },
    {
      "id": "s0101",
      "kind": "paragraph",
      "text": "Schemas -> (list)",
      "protected": []
    },
    {
      "id": "s0102",
      "kind": "paragraph",
      "text": "Inventory schemas returned by the request.",
      "protected": []
    },
    {
      "id": "s0103",
      "kind": "paragraph",
      "text": "(structure)",
      "protected": []
    },
    {
      "id": "s0104",
      "kind": "paragraph",
      "text": "The inventory item schema definition. Users can use this to compose inventory query filters.",
      "protected": []
    },
    {
      "id": "s0105",
      "kind": "paragraph",
      "text": "TypeName -> (string) [required]",
      "protected": []
    },
    {
      "id": "s0106",
      "kind": "paragraph",
      "text": "The name of the inventory type. Default inventory item type names start with Amazon Web Services. Custom inventory type names will start with Custom. Default inventory item types include the following: [[p0]] , [[p1]] , [[p2]] , [[p3]] , and [[p4]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "AWS:AWSComponent"
        },
        {
          "token": "[[p1]]",
          "text": "AWS:Application"
        },
        {
          "token": "[[p2]]",
          "text": "AWS:InstanceInformation"
        },
        {
          "token": "[[p3]]",
          "text": "AWS:Network"
        },
        {
          "token": "[[p4]]",
          "text": "AWS:WindowsUpdate"
        }
      ]
    },
    {
      "id": "s0107",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0108",
      "kind": "paragraph",
      "text": "min: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "1"
        }
      ]
    },
    {
      "id": "s0109",
      "kind": "paragraph",
      "text": "max: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "100"
        }
      ]
    },
    {
      "id": "s0110",
      "kind": "paragraph",
      "text": "pattern: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "^(AWS|Custom):.*$"
        }
      ]
    },
    {
      "id": "s0111",
      "kind": "paragraph",
      "text": "Version -> (string)",
      "protected": []
    },
    {
      "id": "s0112",
      "kind": "paragraph",
      "text": "The schema version for the inventory item.",
      "protected": []
    },
    {
      "id": "s0113",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0114",
      "kind": "paragraph",
      "text": "pattern: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "^([0-9]{1,6})(\\.[0-9]{1,6})$"
        }
      ]
    },
    {
      "id": "s0115",
      "kind": "paragraph",
      "text": "Attributes -> (list) [required]",
      "protected": []
    },
    {
      "id": "s0116",
      "kind": "paragraph",
      "text": "The schema attributes for inventory. This contains data type and attribute name.",
      "protected": []
    },
    {
      "id": "s0117",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0118",
      "kind": "paragraph",
      "text": "min: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "1"
        }
      ]
    },
    {
      "id": "s0119",
      "kind": "paragraph",
      "text": "max: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "50"
        }
      ]
    },
    {
      "id": "s0120",
      "kind": "paragraph",
      "text": "(structure)",
      "protected": []
    },
    {
      "id": "s0121",
      "kind": "paragraph",
      "text": "Attributes are the entries within the inventory item content. It contains name and value.",
      "protected": []
    },
    {
      "id": "s0122",
      "kind": "paragraph",
      "text": "Name -> (string) [required]",
      "protected": []
    },
    {
      "id": "s0123",
      "kind": "paragraph",
      "text": "Name of the inventory item attribute.",
      "protected": []
    },
    {
      "id": "s0124",
      "kind": "paragraph",
      "text": "DataType -> (string) [required]",
      "protected": []
    },
    {
      "id": "s0125",
      "kind": "paragraph",
      "text": "The data type of the inventory item attribute.",
      "protected": []
    },
    {
      "id": "s0126",
      "kind": "paragraph",
      "text": "Possible values:",
      "protected": []
    },
    {
      "id": "s0127",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "string"
        }
      ]
    },
    {
      "id": "s0128",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "number"
        }
      ]
    },
    {
      "id": "s0129",
      "kind": "paragraph",
      "text": "DisplayName -> (string)",
      "protected": []
    },
    {
      "id": "s0130",
      "kind": "paragraph",
      "text": "The alias name of the inventory type. The alias name is used for display purposes.",
      "protected": []
    },
    {
      "id": "s0131",
      "kind": "paragraph",
      "text": "NextToken -> (string)",
      "protected": []
    },
    {
      "id": "s0132",
      "kind": "paragraph",
      "text": "The token to use when requesting the next set of items. If there are no additional items to return, the string is empty.",
      "protected": []
    }
  ]
}
