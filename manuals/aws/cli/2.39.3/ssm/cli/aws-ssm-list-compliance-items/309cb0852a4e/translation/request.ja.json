    {
      "id": "s0122",
      "kind": "heading",
      "text": "Examples¶",
      "protected": []
    },
    {
      "id": "s0123",
      "kind": "heading",
      "text": "Note",
      "protected": []
    },
    {
      "id": "s0124",
      "kind": "paragraph",
      "text": "To use the following examples, you must have the AWS CLI installed and configured. See the [[p0]] in the [[p1]]AWS CLI User Guide[[p2]] for more information.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Getting started guide"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0125",
      "kind": "paragraph",
      "text": "Unless otherwise stated, all examples have unix-like quotation rules. These examples will need to be adapted to your terminal’s quoting rules. See [[p0]] in the [[p1]]AWS CLI User Guide[[p2]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Using quotation marks with strings"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0126",
      "kind": "paragraph",
      "text": "[[p0]]Example 1: To list compliance items for a specific instance[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<strong>"
        },
        {
          "token": "[[p1]]",
          "text": "</strong>"
        }
      ]
    },
    {
      "id": "s0127",
      "kind": "paragraph",
      "text": "The following [[p0]] example lists all compliance items for the specified instance.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "list-compliance-items"
        }
      ]
    },
    {
      "id": "s0128",
      "kind": "paragraph",
      "text": "Output:",
      "protected": []
    },
    {
      "id": "s0129",
      "kind": "paragraph",
      "text": "For more information, see [[p0]] in the [[p1]]AWS Systems Manager User Guide[[p2]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Learn details about Compliance"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0130",
      "kind": "paragraph",
      "text": "[[p0]]Example 2: To list compliance items for a specific instance and association ID[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<strong>"
        },
        {
          "token": "[[p1]]",
          "text": "</strong>"
        }
      ]
    },
    {
      "id": "s0131",
      "kind": "paragraph",
      "text": "The following [[p0]] example lists all compliance items for the specified instance and association ID.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "list-compliance-items"
        }
      ]
    },
    {
      "id": "s0132",
      "kind": "paragraph",
      "text": "Output:",
      "protected": []
    },
    {
      "id": "s0133",
      "kind": "paragraph",
      "text": "For more information, see [[p0]] in the [[p1]]AWS Systems Manager User Guide[[p2]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Learn details about Compliance"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0134",
      "kind": "paragraph",
      "text": "[[p0]]Example 3: To list compliance items for an instance after a specific date and time[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<strong>"
        },
        {
          "token": "[[p1]]",
          "text": "</strong>"
        }
      ]
    },
    {
      "id": "s0135",
      "kind": "paragraph",
      "text": "The following [[p0]] example lists all compliance items for an instance after the specified date and time.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "list-compliance-items"
        }
      ]
    },
    {
      "id": "s0136",
      "kind": "paragraph",
      "text": "Output:",
      "protected": []
    },
    {
      "id": "s0137",
      "kind": "paragraph",
      "text": "For more information, see [[p0]] in the [[p1]]AWS Systems Manager User Guide[[p2]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Learn details about Compliance"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0138",
      "kind": "heading",
      "text": "Output¶",
      "protected": []
    },
    {
      "id": "s0139",
      "kind": "paragraph",
      "text": "ComplianceItems -> (list)",
      "protected": []
    },
    {
      "id": "s0140",
      "kind": "paragraph",
      "text": "A list of compliance information for the specified resource ID.",
      "protected": []
    },
    {
      "id": "s0141",
      "kind": "paragraph",
      "text": "(structure)",
      "protected": []
    },
    {
      "id": "s0142",
      "kind": "paragraph",
      "text": "Information about the compliance as defined by the resource type. For example, for a patch resource type, [[p0]] includes information about the PatchSeverity, Classification, and so on.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Items"
        }
      ]
    },
    {
      "id": "s0143",
      "kind": "paragraph",
      "text": "ComplianceType -> (string)",
      "protected": []
    },
    {
      "id": "s0144",
      "kind": "paragraph",
      "text": "The compliance type. For example, Association (for a State Manager association), Patch, or Custom:[[p0]] are all valid compliance types.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "string"
        }
      ]
    },
    {
      "id": "s0145",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0146",
      "kind": "paragraph",
      "text": "min: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "1"
        }
      ]
    },
    {
      "id": "s0147",
      "kind": "paragraph",
      "text": "max: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "100"
        }
      ]
    },
    {
      "id": "s0148",
      "kind": "paragraph",
      "text": "pattern: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "^([A-Za-z0-9_\\-]\\w+|Custom:[a-zA-Z0-9_\\-]\\w+)$"
        }
      ]
    },
    {
      "id": "s0149",
      "kind": "paragraph",
      "text": "ResourceType -> (string)",
      "protected": []
    },
    {
      "id": "s0150",
      "kind": "paragraph",
      "text": "The type of resource. [[p0]] is currently the only supported resource type.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "ManagedInstance"
        }
      ]
    },
    {
      "id": "s0151",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0152",
      "kind": "paragraph",
      "text": "min: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "1"
        }
      ]
    },
    {
      "id": "s0153",
      "kind": "paragraph",
      "text": "max: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "50"
        }
      ]
    },
    {
      "id": "s0154",
      "kind": "paragraph",
      "text": "ResourceId -> (string)",
      "protected": []
    },
    {
      "id": "s0155",
      "kind": "paragraph",
      "text": "An ID for the resource. For a managed node, this is the node ID.",
      "protected": []
    },
    {
      "id": "s0156",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0157",
      "kind": "paragraph",
      "text": "min: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "1"
        }
      ]
    },
    {
      "id": "s0158",
      "kind": "paragraph",
      "text": "max: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "100"
        }
      ]
    },
    {
      "id": "s0159",
      "kind": "paragraph",
      "text": "Id -> (string)",
      "protected": []
    },
    {
      "id": "s0160",
      "kind": "paragraph",
      "text": "An ID for the compliance item. For example, if the compliance item is a Windows patch, the ID could be the number of the KB article; for example: KB4010320.",
      "protected": []
    },
    {
      "id": "s0161",
      "kind": "paragraph",
      "text": "Title -> (string)",
      "protected": []
    },
    {
      "id": "s0162",
      "kind": "paragraph",
      "text": "A title for the compliance item. For example, if the compliance item is a Windows patch, the title could be the title of the KB article for the patch; for example: Security Update for Active Directory Federation Services.",
      "protected": []
    },
    {
      "id": "s0163",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0164",
      "kind": "paragraph",
      "text": "max: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "500"
        }
      ]
    },
    {
      "id": "s0165",
      "kind": "paragraph",
      "text": "Status -> (string)",
      "protected": []
    },
    {
      "id": "s0166",
      "kind": "paragraph",
      "text": "The status of the compliance item. An item is either COMPLIANT, NON_COMPLIANT, or an empty string (for Windows patches that aren’t applicable).",
      "protected": []
    },
    {
      "id": "s0167",
      "kind": "paragraph",
      "text": "Possible values:",
      "protected": []
    },
    {
      "id": "s0168",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "COMPLIANT"
        }
      ]
    },
    {
      "id": "s0169",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "NON_COMPLIANT"
        }
      ]
    },
    {
      "id": "s0170",
      "kind": "paragraph",
      "text": "Severity -> (string)",
      "protected": []
    },
    {
      "id": "s0171",
      "kind": "paragraph",
      "text": "The severity of the compliance status. Severity can be one of the following: Critical, High, Medium, Low, Informational, Unspecified.",
      "protected": []
    },
    {
      "id": "s0172",
      "kind": "paragraph",
      "text": "Possible values:",
      "protected": []
    },
    {
      "id": "s0173",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "CRITICAL"
        }
      ]
    },
    {
      "id": "s0174",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "HIGH"
        }
      ]
    },
    {
      "id": "s0175",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "MEDIUM"
        }
      ]
    },
    {
      "id": "s0176",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "LOW"
        }
      ]
    },
    {
      "id": "s0177",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "INFORMATIONAL"
        }
      ]
    },
    {
      "id": "s0178",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "UNSPECIFIED"
        }
      ]
    },
    {
      "id": "s0179",
      "kind": "paragraph",
      "text": "ExecutionSummary -> (structure)",
      "protected": []
    },
    {
      "id": "s0180",
      "kind": "paragraph",
      "text": "A summary for the compliance item. The summary includes an execution ID, the execution type (for example, command), and the execution time.",
      "protected": []
    },
    {
      "id": "s0181",
      "kind": "heading",
      "text": "Warning",
      "protected": []
    },
    {
      "id": "s0182",
      "kind": "paragraph",
      "text": "For State Manager associations, the [[p0]] value represents when the compliance status was captured and aggregated by the Systems Manager service, not necessarily when the underlying association was executed on the managed node. State Manager updates compliance status for all associations on an instance whenever any association executes, which means multiple associations may show the same execution time even if they were executed at different times.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "ExecutionTime"
        }
      ]
    },
    {
      "id": "s0183",
      "kind": "paragraph",
      "text": "ExecutionTime -> (timestamp) [required]",
      "protected": []
    },
    {
      "id": "s0184",
      "kind": "paragraph",
      "text": "The time the execution ran as a datetime object that is saved in the following format: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "yyyy-MM-dd'T'HH:mm:ss'Z'"
        }
      ]
    },
    {
      "id": "s0185",
      "kind": "heading",
      "text": "Warning",
      "protected": []
    },
    {
      "id": "s0186",
      "kind": "paragraph",
      "text": "For State Manager associations, this timestamp represents when the compliance status was captured and reported by the Systems Manager service, not when the underlying association was actually executed on the managed node. To track actual association execution times, use the DescribeAssociationExecutionTargets command or check the association execution history in the Systems Manager console.",
      "protected": []
    },
    {
      "id": "s0187",
      "kind": "paragraph",
      "text": "ExecutionId -> (string)",
      "protected": []
    },
    {
      "id": "s0188",
      "kind": "paragraph",
      "text": "An ID created by the system when [[p0]] was called. For example, [[p1]] is a valid execution ID. You can use this ID in subsequent calls.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "PutComplianceItems"
        },
        {
          "token": "[[p1]]",
          "text": "CommandID"
        }
      ]
    },
    {
      "id": "s0189",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0190",
      "kind": "paragraph",
      "text": "max: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "100"
        }
      ]
    },
    {
      "id": "s0191",
      "kind": "paragraph",
      "text": "ExecutionType -> (string)",
      "protected": []
    },
    {
      "id": "s0192",
      "kind": "paragraph",
      "text": "The type of execution. For example, [[p0]] is a valid execution type.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Command"
        }
      ]
    },
    {
      "id": "s0193",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0194",
      "kind": "paragraph",
      "text": "max: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "50"
        }
      ]
    },
    {
      "id": "s0195",
      "kind": "paragraph",
      "text": "Details -> (map)",
      "protected": []
    },
    {
      "id": "s0196",
      "kind": "paragraph",
      "text": "A “Key”: “Value” tag combination for the compliance item.",
      "protected": []
    },
    {
      "id": "s0197",
      "kind": "paragraph",
      "text": "key -> (string)",
      "protected": []
    },
    {
      "id": "s0198",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0199",
      "kind": "paragraph",
      "text": "min: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "1"
        }
      ]
    },
    {
      "id": "s0200",
      "kind": "paragraph",
      "text": "max: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "64"
        }
      ]
    },
