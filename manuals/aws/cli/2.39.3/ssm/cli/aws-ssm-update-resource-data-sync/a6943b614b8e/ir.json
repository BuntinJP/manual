    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "Update a resource data sync. After you create a resource data sync for a Region, you can’t change the account options for that sync. For example, if you create a sync in the us-east-2 (Ohio) Region and you choose the [[p0]] option, you can’t edit that sync later and choose the [[p1]] option. Instead, you must delete the first resource data sync, and create a new one.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "Include only the current account"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "Include all accounts from my Organizations configuration"
          }
        }
      ]
    },
