          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0109",
      "kind": "paragraph",
      "text": "[[p0]]Example 1: To list all maintenance windows[[p1]]",
