    },
    {
      "id": "s0089",
      "kind": "paragraph",
      "text": "InstancesWithInstalledRejectedPatches -> (integer)",
      "protected": []
    },
    {
      "id": "s0090",
      "kind": "paragraph",
      "text": "The number of managed nodes with patches installed that are specified in a [[p0]] list. Patches with a status of [[p1]] were typically installed before they were added to a [[p2]] list.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "RejectedPatches"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "INSTALLED_REJECTED"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "code",
            "text": "RejectedPatches"
          }
        }
      ]
    },
    {
      "id": "s0091",
      "kind": "heading",
      "text": "Note",
      "protected": []
    },
    {
      "id": "s0092",
      "kind": "paragraph",
      "text": "If [[p0]] is the specified option for [[p1]] , the value of [[p2]] will always be [[p3]] (zero).",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "ALLOW_AS_DEPENDENCY"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "RejectedPatchesAction"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "code",
            "text": "InstancesWithInstalledRejectedPatches"
          }
        },
        {
          "token": "[[p3]]",
          "inline": {
            "tag": "code",
            "text": "0"
          }
        }
      ]
    },
    {
      "id": "s0093",
      "kind": "paragraph",
      "text": "InstancesWithMissingPatches -> (integer)",
      "protected": []
    },
    {
      "id": "s0094",
      "kind": "paragraph",
      "text": "The number of managed nodes with missing patches from the patch baseline.",
      "protected": []
    },
    {
      "id": "s0095",
      "kind": "paragraph",
      "text": "InstancesWithFailedPatches -> (integer)",
      "protected": []
    },
    {
      "id": "s0096",
      "kind": "paragraph",
      "text": "The number of managed nodes with patches from the patch baseline that failed to install.",
      "protected": []
    },
    {
      "id": "s0097",
      "kind": "paragraph",
      "text": "InstancesWithNotApplicablePatches -> (integer)",
      "protected": []
    },
    {
      "id": "s0098",
      "kind": "paragraph",
      "text": "The number of managed nodes with patches that aren’t applicable.",
      "protected": []
    },
    {
      "id": "s0099",
      "kind": "paragraph",
      "text": "InstancesWithUnreportedNotApplicablePatches -> (integer)",
      "protected": []
    },
    {
      "id": "s0100",
      "kind": "paragraph",
      "text": "The number of managed nodes with [[p0]] patches beyond the supported limit, which aren’t reported by name to Inventory. Inventory is a tool in Amazon Web Services Systems Manager.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "NotApplicable"
          }
        }
      ]
    },
    {
      "id": "s0101",
      "kind": "paragraph",
      "text": "InstancesWithCriticalNonCompliantPatches -> (integer)",
      "protected": []
    },
    {
      "id": "s0102",
      "kind": "paragraph",
      "text": "The number of managed nodes where patches that are specified as [[p0]] for compliance reporting in the patch baseline aren’t installed. These patches might be missing, have failed installation, were rejected, or were installed but awaiting a required managed node reboot. The status of these managed nodes is [[p1]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "Critical"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "NON_COMPLIANT"
          }
        }
      ]
    },
    {
      "id": "s0103",
      "kind": "paragraph",
      "text": "InstancesWithSecurityNonCompliantPatches -> (integer)",
      "protected": []
    },
    {
      "id": "s0104",
      "kind": "paragraph",
      "text": "The number of managed nodes where patches that are specified as [[p0]] in a patch advisory aren’t installed. These patches might be missing, have failed installation, were rejected, or were installed but awaiting a required managed node reboot. The status of these managed nodes is [[p1]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "Security"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "NON_COMPLIANT"
          }
        }
      ]
    },
    {
      "id": "s0105",
      "kind": "paragraph",
      "text": "InstancesWithOtherNonCompliantPatches -> (integer)",
      "protected": []
    },
    {
      "id": "s0106",
      "kind": "paragraph",
      "text": "The number of managed nodes with patches installed that are specified as other than [[p0]] or [[p1]] but aren’t compliant with the patch baseline. The status of these managed nodes is [[p2]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "Critical"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "Security"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "code",
            "text": "NON_COMPLIANT"
          }
        }
      ]
    },
    {
      "id": "s0107",
      "kind": "paragraph",
      "text": "InstancesWithAvailableSecurityUpdates -> (integer)",
      "protected": []
    },
    {
      "id": "s0108",
      "kind": "paragraph",
      "text": "The number of managed nodes for which security-related patches are available but not approved because because they didn’t meet the patch baseline requirements. For example, an updated version of a patch might have been released before the specified auto-approval period was over.",
      "protected": []
    },
    {
      "id": "s0109",
      "kind": "paragraph",
      "text": "Applies to Windows Server managed nodes only.",
      "protected": []
    }
  ],
