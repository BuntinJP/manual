    {
      "id": "s0104",
      "kind": "heading",
      "text": "Examples¶",
      "protected": []
    },
    {
      "id": "s0105",
      "kind": "heading",
      "text": "Note",
      "protected": []
    },
    {
      "id": "s0106",
      "kind": "paragraph",
      "text": "To use the following examples, you must have the AWS CLI installed and configured. See the [[p0]] in the [[p1]]AWS CLI User Guide[[p2]] for more information.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Getting started guide"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0107",
      "kind": "paragraph",
      "text": "Unless otherwise stated, all examples have unix-like quotation rules. These examples will need to be adapted to your terminal’s quoting rules. See [[p0]] in the [[p1]]AWS CLI User Guide[[p2]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Using quotation marks with strings"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0108",
      "kind": "paragraph",
      "text": "[[p0]]Example 1: To list resource-level compliance summary counts[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<strong>"
        },
        {
          "token": "[[p1]]",
          "text": "</strong>"
        }
      ]
    },
    {
      "id": "s0109",
      "kind": "paragraph",
      "text": "The following [[p0]] example lists resource-level compliance summary counts.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "list-resource-compliance-summaries"
        }
      ]
    },
    {
      "id": "s0110",
      "kind": "paragraph",
      "text": "Output:",
      "protected": []
    },
    {
      "id": "s0111",
      "kind": "paragraph",
      "text": "For more information, see [[p0]] in the [[p1]]AWS Systems Manager User Guide[[p2]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Learn details about Compliance"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0112",
      "kind": "paragraph",
      "text": "[[p0]]Example 2: To list resource-level compliance summaries for a specific compliance type[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<strong>"
        },
        {
          "token": "[[p1]]",
          "text": "</strong>"
        }
      ]
    },
    {
      "id": "s0113",
      "kind": "paragraph",
      "text": "The following [[p0]] example lists resource-level compliance summaries for the Patch compliance type.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "list-resource-compliance-summaries"
        }
      ]
    },
    {
      "id": "s0114",
      "kind": "paragraph",
      "text": "Output:",
      "protected": []
    },
    {
      "id": "s0115",
      "kind": "paragraph",
      "text": "For more information, see [[p0]] in the [[p1]]AWS Systems Manager User Guide[[p2]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Learn details about Compliance"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0116",
      "kind": "heading",
      "text": "Output¶",
      "protected": []
    },
    {
      "id": "s0117",
      "kind": "paragraph",
      "text": "ResourceComplianceSummaryItems -> (list)",
      "protected": []
    },
    {
      "id": "s0118",
      "kind": "paragraph",
      "text": "A summary count for specified or targeted managed nodes. Summary count includes information about compliant and non-compliant State Manager associations, patch status, or custom items according to the filter criteria that you specify.",
      "protected": []
    },
    {
      "id": "s0119",
      "kind": "paragraph",
      "text": "(structure)",
      "protected": []
    },
    {
      "id": "s0120",
      "kind": "paragraph",
      "text": "Compliance summary information for a specific resource.",
      "protected": []
    },
    {
      "id": "s0121",
      "kind": "paragraph",
      "text": "ComplianceType -> (string)",
      "protected": []
    },
    {
      "id": "s0122",
      "kind": "paragraph",
      "text": "The compliance type.",
      "protected": []
    },
    {
      "id": "s0123",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0124",
      "kind": "paragraph",
      "text": "min: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "1"
        }
      ]
    },
    {
      "id": "s0125",
      "kind": "paragraph",
      "text": "max: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "100"
        }
      ]
    },
    {
      "id": "s0126",
      "kind": "paragraph",
      "text": "pattern: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "^([A-Za-z0-9_\\-]\\w+|Custom:[a-zA-Z0-9_\\-]\\w+)$"
        }
      ]
    },
    {
      "id": "s0127",
      "kind": "paragraph",
      "text": "ResourceType -> (string)",
      "protected": []
    },
    {
      "id": "s0128",
      "kind": "paragraph",
      "text": "The resource type.",
      "protected": []
    },
    {
      "id": "s0129",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0130",
      "kind": "paragraph",
      "text": "min: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "1"
        }
      ]
    },
    {
      "id": "s0131",
      "kind": "paragraph",
      "text": "max: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "50"
        }
      ]
    },
    {
      "id": "s0132",
      "kind": "paragraph",
      "text": "ResourceId -> (string)",
      "protected": []
    },
    {
      "id": "s0133",
      "kind": "paragraph",
      "text": "The resource ID.",
      "protected": []
    },
    {
      "id": "s0134",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0135",
      "kind": "paragraph",
      "text": "min: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "1"
        }
      ]
    },
    {
      "id": "s0136",
      "kind": "paragraph",
      "text": "max: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "100"
        }
      ]
    },
    {
      "id": "s0137",
      "kind": "paragraph",
      "text": "Status -> (string)",
      "protected": []
    },
    {
      "id": "s0138",
      "kind": "paragraph",
      "text": "The compliance status for the resource.",
      "protected": []
    },
    {
      "id": "s0139",
      "kind": "paragraph",
      "text": "Possible values:",
      "protected": []
    },
    {
      "id": "s0140",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "COMPLIANT"
        }
      ]
    },
    {
      "id": "s0141",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "NON_COMPLIANT"
        }
      ]
    },
    {
      "id": "s0142",
      "kind": "paragraph",
      "text": "OverallSeverity -> (string)",
      "protected": []
    },
    {
      "id": "s0143",
      "kind": "paragraph",
      "text": "The highest severity item found for the resource. The resource is compliant for this item.",
      "protected": []
    },
    {
      "id": "s0144",
      "kind": "paragraph",
      "text": "Possible values:",
      "protected": []
    },
    {
      "id": "s0145",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "CRITICAL"
        }
      ]
    },
    {
      "id": "s0146",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "HIGH"
        }
      ]
    },
    {
      "id": "s0147",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "MEDIUM"
        }
      ]
    },
    {
      "id": "s0148",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "LOW"
        }
      ]
    },
