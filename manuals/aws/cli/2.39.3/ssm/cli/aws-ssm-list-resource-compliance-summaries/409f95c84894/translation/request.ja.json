    {
      "id": "s0151",
      "kind": "paragraph",
      "text": "ExecutionSummary -> (structure)",
      "protected": []
    },
    {
      "id": "s0152",
      "kind": "paragraph",
      "text": "Information about the execution.",
      "protected": []
    },
    {
      "id": "s0153",
      "kind": "paragraph",
      "text": "ExecutionTime -> (timestamp) [required]",
      "protected": []
    },
    {
      "id": "s0154",
      "kind": "paragraph",
      "text": "The time the execution ran as a datetime object that is saved in the following format: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "yyyy-MM-dd'T'HH:mm:ss'Z'"
        }
      ]
    },
    {
      "id": "s0155",
      "kind": "heading",
      "text": "Warning",
      "protected": []
    },
    {
      "id": "s0156",
      "kind": "paragraph",
      "text": "For State Manager associations, this timestamp represents when the compliance status was captured and reported by the Systems Manager service, not when the underlying association was actually executed on the managed node. To track actual association execution times, use the DescribeAssociationExecutionTargets command or check the association execution history in the Systems Manager console.",
      "protected": []
    },
    {
      "id": "s0157",
      "kind": "paragraph",
      "text": "ExecutionId -> (string)",
      "protected": []
    },
    {
      "id": "s0158",
      "kind": "paragraph",
      "text": "An ID created by the system when [[p0]] was called. For example, [[p1]] is a valid execution ID. You can use this ID in subsequent calls.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "PutComplianceItems"
        },
        {
          "token": "[[p1]]",
          "text": "CommandID"
        }
      ]
    },
    {
      "id": "s0159",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0160",
      "kind": "paragraph",
      "text": "max: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "100"
        }
      ]
    },
    {
      "id": "s0161",
      "kind": "paragraph",
      "text": "ExecutionType -> (string)",
      "protected": []
    },
    {
      "id": "s0162",
      "kind": "paragraph",
      "text": "The type of execution. For example, [[p0]] is a valid execution type.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Command"
        }
      ]
    },
    {
      "id": "s0163",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0164",
      "kind": "paragraph",
      "text": "max: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "50"
        }
      ]
    },
    {
      "id": "s0165",
      "kind": "paragraph",
      "text": "CompliantSummary -> (structure)",
      "protected": []
    },
    {
      "id": "s0166",
      "kind": "paragraph",
      "text": "A list of items that are compliant for the resource.",
      "protected": []
    },
    {
      "id": "s0167",
      "kind": "paragraph",
      "text": "CompliantCount -> (integer)",
      "protected": []
    },
    {
      "id": "s0168",
      "kind": "paragraph",
      "text": "The total number of resources that are compliant.",
      "protected": []
    },
    {
      "id": "s0169",
      "kind": "paragraph",
      "text": "SeveritySummary -> (structure)",
      "protected": []
    },
    {
      "id": "s0170",
      "kind": "paragraph",
      "text": "A summary of the compliance severity by compliance type.",
      "protected": []
    },
    {
      "id": "s0171",
      "kind": "paragraph",
      "text": "CriticalCount -> (integer)",
      "protected": []
    },
    {
      "id": "s0172",
      "kind": "paragraph",
      "text": "The total number of resources or compliance items that have a severity level of [[p0]] . Critical severity is determined by the organization that published the compliance items.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Critical"
        }
      ]
    },
    {
      "id": "s0173",
      "kind": "paragraph",
      "text": "HighCount -> (integer)",
      "protected": []
    },
    {
      "id": "s0174",
      "kind": "paragraph",
      "text": "The total number of resources or compliance items that have a severity level of high. High severity is determined by the organization that published the compliance items.",
      "protected": []
    },
    {
      "id": "s0175",
      "kind": "paragraph",
      "text": "MediumCount -> (integer)",
      "protected": []
    },
    {
      "id": "s0176",
      "kind": "paragraph",
      "text": "The total number of resources or compliance items that have a severity level of medium. Medium severity is determined by the organization that published the compliance items.",
      "protected": []
    },
    {
      "id": "s0177",
