      "protected": []
    },
    {
      "id": "s0183",
      "kind": "paragraph",
      "text": "NonCompliantSummary -> (structure)",
      "protected": []
    },
    {
      "id": "s0184",
      "kind": "paragraph",
      "text": "A list of items that aren’t compliant for the resource.",
      "protected": []
    },
    {
      "id": "s0185",
      "kind": "paragraph",
      "text": "NonCompliantCount -> (integer)",
      "protected": []
    },
    {
      "id": "s0186",
      "kind": "paragraph",
      "text": "The total number of compliance items that aren’t compliant.",
      "protected": []
    },
    {
      "id": "s0187",
      "kind": "paragraph",
      "text": "SeveritySummary -> (structure)",
      "protected": []
    },
    {
      "id": "s0188",
      "kind": "paragraph",
      "text": "A summary of the non-compliance severity by compliance type",
      "protected": []
    },
    {
      "id": "s0189",
      "kind": "paragraph",
      "text": "CriticalCount -> (integer)",
      "protected": []
    },
    {
      "id": "s0190",
      "kind": "paragraph",
      "text": "The total number of resources or compliance items that have a severity level of [[p0]] . Critical severity is determined by the organization that published the compliance items.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Critical"
        }
      ]
    },
    {
      "id": "s0191",
      "kind": "paragraph",
      "text": "HighCount -> (integer)",
      "protected": []
    },
    {
      "id": "s0192",
      "kind": "paragraph",
      "text": "The total number of resources or compliance items that have a severity level of high. High severity is determined by the organization that published the compliance items.",
      "protected": []
    },
    {
      "id": "s0193",
      "kind": "paragraph",
      "text": "MediumCount -> (integer)",
      "protected": []
    },
    {
      "id": "s0194",
      "kind": "paragraph",
      "text": "The total number of resources or compliance items that have a severity level of medium. Medium severity is determined by the organization that published the compliance items.",
      "protected": []
    },
    {
      "id": "s0195",
      "kind": "paragraph",
      "text": "LowCount -> (integer)",
      "protected": []
    },
    {
      "id": "s0196",
      "kind": "paragraph",
      "text": "The total number of resources or compliance items that have a severity level of low. Low severity is determined by the organization that published the compliance items.",
      "protected": []
    },
    {
      "id": "s0197",
      "kind": "paragraph",
      "text": "InformationalCount -> (integer)",
      "protected": []
    },
    {
      "id": "s0198",
      "kind": "paragraph",
      "text": "The total number of resources or compliance items that have a severity level of informational. Informational severity is determined by the organization that published the compliance items.",
      "protected": []
    },
    {
      "id": "s0199",
      "kind": "paragraph",
      "text": "UnspecifiedCount -> (integer)",
      "protected": []
    },
    {
      "id": "s0200",
      "kind": "paragraph",
      "text": "The total number of resources or compliance items that have a severity level of unspecified. Unspecified severity is determined by the organization that published the compliance items.",
      "protected": []
    },
    {
      "id": "s0201",
      "kind": "paragraph",
      "text": "NextToken -> (string)",
      "protected": []
