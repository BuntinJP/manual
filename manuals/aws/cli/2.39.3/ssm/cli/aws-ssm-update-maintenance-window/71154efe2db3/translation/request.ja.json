        }
      ]
    },
    {
      "id": "s0032",
      "kind": "paragraph",
      "text": "The date and time, in ISO-8601 Extended format, for when you want the maintenance window to become inactive. [[p0]] allows you to set a date and time in the future when the maintenance window will no longer run.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "EndDate"
        }
