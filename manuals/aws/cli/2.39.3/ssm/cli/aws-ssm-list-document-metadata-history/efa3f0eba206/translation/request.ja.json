    },
    {
      "id": "s0116",
      "kind": "paragraph",
      "text": "ReviewStatus -> (string)",
      "protected": []
    },
    {
      "id": "s0117",
      "kind": "paragraph",
      "text": "The current review status of a new custom SSM document created by a member of your organization, or of the latest version of an existing SSM document.",
      "protected": []
    },
    {
      "id": "s0118",
      "kind": "paragraph",
      "text": "Only one version of a document can be in the APPROVED state at a time. When a new version is approved, the status of the previous version changes to REJECTED.",
      "protected": []
    },
    {
      "id": "s0119",
      "kind": "paragraph",
      "text": "Only one version of a document can be in review, or PENDING, at a time.",
      "protected": []
    },
    {
      "id": "s0120",
      "kind": "paragraph",
      "text": "Possible values:",
      "protected": []
    },
    {
      "id": "s0121",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "APPROVED"
        }
      ]
    },
    {
      "id": "s0122",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "NOT_REVIEWED"
        }
      ]
    },
    {
      "id": "s0123",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "PENDING"
        }
      ]
    },
    {
      "id": "s0124",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "REJECTED"
        }
      ]
    },
    {
