      ]
    },
    {
      "id": "s0100",
      "kind": "paragraph",
      "text": "DocumentVersion -> (string)",
      "protected": []
    },
    {
      "id": "s0101",
      "kind": "paragraph",
      "text": "The version of the change template.",
      "protected": []
    },
    {
      "id": "s0102",
      "kind": "paragraph",
      "text": "Constraints:",
