      "id": "s0136",
      "kind": "paragraph",
      "text": "Content -> (string)",
      "protected": []
    },
    {
      "id": "s0137",
      "kind": "paragraph",
      "text": "The content of a comment entered by a user who requests a review of a new document version, or who reviews the new version.",
