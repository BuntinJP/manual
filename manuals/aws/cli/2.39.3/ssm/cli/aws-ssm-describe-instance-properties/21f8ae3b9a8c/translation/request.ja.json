      "id": "s0147",
      "kind": "paragraph",
      "text": "An object containing various properties of a managed node.",
      "protected": []
    },
    {
      "id": "s0148",
      "kind": "paragraph",
      "text": "Name -> (string)",
      "protected": []
    },
    {
      "id": "s0149",
      "kind": "paragraph",
      "text": "The value of the EC2 [[p0]] tag associated with the node. If a [[p1]] tag hasn’t been applied to the node, this value is blank.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Name"
        },
        {
          "token": "[[p1]]",
          "text": "Name"
        }
      ]
    },
    {
      "id": "s0150",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0151",
      "kind": "paragraph",
      "text": "max: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "255"
        }
      ]
    },
    {
      "id": "s0152",
      "kind": "paragraph",
      "text": "InstanceId -> (string)",
