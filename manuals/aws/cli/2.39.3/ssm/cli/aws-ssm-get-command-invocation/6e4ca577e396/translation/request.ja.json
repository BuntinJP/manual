          "token": "[[p0]]",
          "text": "AWS-RunShellScript"
        }
      ]
    },
    {
      "id": "s0105",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0106",
      "kind": "paragraph",
      "text": "pattern: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "^[a-zA-Z0-9_\\-.]{3,128}$"
        }
      ]
    },
    {
      "id": "s0107",
      "kind": "paragraph",
      "text": "DocumentVersion -> (string)",
      "protected": []
    },
    {
      "id": "s0108",
      "kind": "paragraph",
      "text": "The Systems Manager document (SSM document) version used in the request.",
      "protected": []
    },
    {
      "id": "s0109",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0110",
      "kind": "paragraph",
      "text": "pattern: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "([$]LATEST|[$]DEFAULT|^[1-9][0-9]*$)"
        }
      ]
    },
    {
      "id": "s0111",
      "kind": "paragraph",
      "text": "PluginName -> (string)",
      "protected": []
    },
    {
      "id": "s0112",
      "kind": "paragraph",
      "text": "The name of the plugin, or [[p0]]step name[[p1]] , for which details are reported. For example, [[p2]] is a plugin.",
      "protected": [
