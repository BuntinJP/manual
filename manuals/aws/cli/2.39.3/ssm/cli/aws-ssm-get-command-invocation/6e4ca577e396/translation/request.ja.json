    {
      "id": "s0115",
      "kind": "paragraph",
      "text": "ResponseCode -> (integer)",
      "protected": []
    },
    {
      "id": "s0116",
      "kind": "paragraph",
      "text": "The error level response code for the plugin script. If the response code is [[p0]] , then the command hasn’t started running on the managed node, or it wasn’t received by the node.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-1"
        }
      ]
    },
    {
      "id": "s0117",
      "kind": "paragraph",
      "text": "ExecutionStartDateTime -> (string)",
      "protected": []
    },
    {
      "id": "s0118",
      "kind": "paragraph",
      "text": "The date and time the plugin started running. Date and time are written in ISO 8601 format. For example, June 7, 2017 is represented as 2017-06-7. The following sample Amazon Web Services CLI command uses the [[p0]] filter.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "InvokedBefore"
        }
      ]
    },
    {
      "id": "s0119",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "aws ssm list-commands --filters key=InvokedBefore,value=2017-06-07T00:00:00Z"
        }
      ]
    },
    {
      "id": "s0120",
      "kind": "paragraph",
      "text": "If the plugin hasn’t started to run, the string is empty.",
      "protected": []
    },
    {
      "id": "s0121",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0122",
      "kind": "paragraph",
      "text": "pattern: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "^([\\-]?\\d{4}(?!\\d{2}\\b))((-?)((0[1-9]|1[0-2])(\\3([12]\\d|0[1-9]|3[01]))?|W([0-4]\\d|5[0-2])(-?[1-7])?|(00[1-9]|0[1-9]\\d|[12]\\d{2}|3([0-5]\\d|6[1-6])))([T\\s]((([01]\\d|2[0-3])((:?)[0-5]\\d)?|24\\:?00)([\\.,]\\d(?!:))?)?(\\17[0-5]\\d([\\.,]\\d)?)?([zZ]|([\\-])([01]\\d|2[0-3]):?([0-5]\\d)?)?)?)?$"
        }
      ]
    },
    {
      "id": "s0123",
      "kind": "paragraph",
      "text": "ExecutionElapsedTime -> (string)",
      "protected": []
    },
    {
      "id": "s0124",
      "kind": "paragraph",
      "text": "Duration since [[p0]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "ExecutionStartDateTime"
        }
      ]
    },
    {
      "id": "s0125",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0126",
      "kind": "paragraph",
      "text": "pattern: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "^([\\-]?\\d{4}(?!\\d{2}\\b))((-?)((0[1-9]|1[0-2])(\\3([12]\\d|0[1-9]|3[01]))?|W([0-4]\\d|5[0-2])(-?[1-7])?|(00[1-9]|0[1-9]\\d|[12]\\d{2}|3([0-5]\\d|6[1-6])))([T\\s]((([01]\\d|2[0-3])((:?)[0-5]\\d)?|24\\:?00)([\\.,]\\d(?!:))?)?(\\17[0-5]\\d([\\.,]\\d)?)?([zZ]|([\\-])([01]\\d|2[0-3]):?([0-5]\\d)?)?)?)?$"
        }
      ]
    },
    {
      "id": "s0127",
      "kind": "paragraph",
      "text": "ExecutionEndDateTime -> (string)",
      "protected": []
    },
    {
      "id": "s0128",
      "kind": "paragraph",
      "text": "The date and time the plugin finished running. Date and time are written in ISO 8601 format. For example, June 7, 2017 is represented as 2017-06-7. The following sample Amazon Web Services CLI command uses the [[p0]] filter.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "InvokedAfter"
        }
      ]
    },
    {
      "id": "s0129",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "aws ssm list-commands --filters key=InvokedAfter,value=2017-06-07T00:00:00Z"
        }
      ]
    },
    {
      "id": "s0130",
      "kind": "paragraph",
      "text": "If the plugin hasn’t started to run, the string is empty.",
      "protected": []
    },
    {
      "id": "s0131",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0132",
      "kind": "paragraph",
      "text": "pattern: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "^([\\-]?\\d{4}(?!\\d{2}\\b))((-?)((0[1-9]|1[0-2])(\\3([12]\\d|0[1-9]|3[01]))?|W([0-4]\\d|5[0-2])(-?[1-7])?|(00[1-9]|0[1-9]\\d|[12]\\d{2}|3([0-5]\\d|6[1-6])))([T\\s]((([01]\\d|2[0-3])((:?)[0-5]\\d)?|24\\:?00)([\\.,]\\d(?!:))?)?(\\17[0-5]\\d([\\.,]\\d)?)?([zZ]|([\\-])([01]\\d|2[0-3]):?([0-5]\\d)?)?)?)?$"
        }
      ]
    },
    {
      "id": "s0133",
      "kind": "paragraph",
      "text": "Status -> (string)",
      "protected": []
    },
    {
      "id": "s0134",
      "kind": "paragraph",
      "text": "The status of this invocation plugin. This status can be different than [[p0]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "StatusDetails"
        }
      ]
    },
    {
      "id": "s0135",
      "kind": "paragraph",
      "text": "Possible values:",
      "protected": []
