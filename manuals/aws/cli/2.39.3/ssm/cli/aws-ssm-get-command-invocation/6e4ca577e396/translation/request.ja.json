        }
      ]
    },
    {
      "id": "s0103",
      "kind": "paragraph",
      "text": "DocumentName -> (string)",
      "protected": []
    },
    {
      "id": "s0104",
      "kind": "paragraph",
      "text": "The name of the document that was run. For example, [[p0]] .",
      "protected": [
