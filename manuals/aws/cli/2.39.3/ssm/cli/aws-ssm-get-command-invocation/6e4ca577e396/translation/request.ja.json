      "protected": []
    },
    {
      "id": "s0092",
      "kind": "paragraph",
      "text": "Constraints:",
      "protected": []
    },
    {
      "id": "s0093",
      "kind": "paragraph",
      "text": "min: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "36"
        }
      ]
