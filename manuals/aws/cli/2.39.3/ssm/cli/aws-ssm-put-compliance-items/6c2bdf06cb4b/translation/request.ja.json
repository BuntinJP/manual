    {
      "id": "s0002",
      "kind": "heading",
      "text": "put-compliance-items¶",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Description¶",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "Registers a compliance type and other compliance details on a designated resource. This operation lets you register custom compliance details with a resource. This call overwrites existing compliance information on the resource, so you must provide a full list of compliance items each time that you send the request.",
      "protected": []
    },
    {
      "id": "s0005",
      "kind": "paragraph",
      "text": "ComplianceType can be one of the following:",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "ExecutionId: The execution ID when the patch, association, or custom compliance item was applied.",
      "protected": []
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "ExecutionType: Specify patch, association, or Custom:[[p0]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "string"
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "ExecutionTime. The time the patch, association, or custom compliance item was applied to the managed node.",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "heading",
      "text": "Warning",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "For State Manager associations, this represents the time when compliance status was captured by the Systems Manager service during its internal compliance aggregation workflow, not necessarily when the association was executed on the managed node. State Manager updates compliance information for all associations on an instance whenever any association executes, which may result in multiple associations showing the same execution time.",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "paragraph",
      "text": "Id: The patch, association, or custom compliance ID.",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "Title: A title.",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "paragraph",
      "text": "Status: The status of the compliance item. For example, [[p0]] for patches, or [[p1]] for associations.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "approved"
        },
        {
          "token": "[[p1]]",
          "text": "Failed"
        }
      ]
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "Severity: A patch severity. For example, [[p0]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Critical"
        }
      ]
    },
    {
      "id": "s0015",
      "kind": "paragraph",
      "text": "DocumentName: An SSM document name. For example, [[p0]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "AWS-RunPatchBaseline"
        }
      ]
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "DocumentVersion: An SSM document version number. For example, 4.",
      "protected": []
    },
    {
      "id": "s0017",
      "kind": "paragraph",
      "text": "Classification: A patch classification. For example, [[p0]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "security updates"
        }
      ]
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "PatchBaselineId: A patch baseline ID.",
      "protected": []
    },
    {
      "id": "s0019",
      "kind": "paragraph",
      "text": "PatchSeverity: A patch severity. For example, [[p0]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Critical"
        }
      ]
    },
    {
      "id": "s0020",
      "kind": "paragraph",
      "text": "PatchState: A patch state. For example, [[p0]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "InstancesWithFailedPatches"
        }
      ]
    },
    {
      "id": "s0021",
      "kind": "paragraph",
      "text": "PatchGroup: The name of a patch group.",
      "protected": []
    },
    {
      "id": "s0022",
      "kind": "paragraph",
      "text": "InstalledTime: The time the association, patch, or custom compliance item was applied to the resource. Specify the time by using the following format: [[p0]]",
      "protected": [
