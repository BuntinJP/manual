          "text": "Key=resource-groups:ResourceTypeFilters,Values=AWS::EC2::INSTANCE,AWS::EC2::VPC"
        }
      ]
    },
    {
      "id": "s0037",
      "kind": "paragraph",
      "text": "For more information about these examples formats, including the best use case for each one, see [[p0]] in the [[p1]]Amazon Web Services Systems Manager User Guide[[p2]] .",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "Examples: Register targets with a maintenance window"
