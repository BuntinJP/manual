          "token": "[[p0]]",
          "text": "Key=resource-groups:Name,Values=<resource-group-name>"
        }
      ]
    },
    {
      "id": "s0032",
      "kind": "paragraph",
      "text": "[[p0]]Example 5[[p1]] : Use filters for resource group types",
