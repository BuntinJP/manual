    {
      "id": "s0005",
      "kind": "paragraph",
      "text": "[[p0]] [[[p1]]] [[[p2]] {[[p3]] | [[p4]] | [[p5]] | [[p6]]}] [[[p7]] {[[p8]] | [[p9]] | [[p10]]}]",
      "protected": [
        {
