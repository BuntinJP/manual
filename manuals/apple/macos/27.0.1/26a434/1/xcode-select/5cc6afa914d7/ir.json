        }
      ]
    },
    {
      "id": "s0019",
      "kind": "paragraph",
      "text": "Unsets any user-specified developer directory, so that the developer directory will be found via the default search mechanism. This command must be run with superuser permissions (see [[p0]]), and will affect all users on the system.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "sudo(8)"
          }
        }
      ]
    },
