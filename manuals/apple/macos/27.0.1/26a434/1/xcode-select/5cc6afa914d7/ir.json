      "kind": "term",
      "text": "[[p0]][[p1]], [[p2]][[p3]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "strong"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
