            "tag": "style-close",
            "style": "strong"
          }
        }
      ]
    },
    {
      "id": "s0017",
      "kind": "paragraph",
      "text": "Prints the path to the currently selected developer directory. This is useful for inspection, but scripts and other tools should use [[p0]] to locate tool inside the active developer directory.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "xcrun(1)"
          }
        }
      ]
    },
    {
      "id": "s0018",
      "kind": "term",
      "text": "[[p0]][[p1]], [[p2]][[p3]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
