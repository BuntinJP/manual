      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "xcode-select - Manages the active developer directory for Xcode and BSD tools.",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "SYNOPSIS",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]] [[[p1]]|[[p2]]] [[[p3]]|[[p4]] <path>] [[[p5]]|[[p6]]] [[[p7]]|[[p8]]]",
      "protected": [
        {
