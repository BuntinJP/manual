          }
        }
      ]
    },
    {
      "id": "s0013",
      "kind": "paragraph",
      "text": "Prints the usage message.",
      "protected": []
    },
    {
      "id": "s0014",
      "kind": "term",
      "text": "[[p0]][[p1]] <path>, [[p2]] <path>[[p3]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "strong"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
