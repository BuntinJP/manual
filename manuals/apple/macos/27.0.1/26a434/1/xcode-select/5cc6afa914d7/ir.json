          }
        }
      ]
    },
    {
      "id": "s0015",
      "kind": "paragraph",
      "text": "Sets the active developer directory to the given path, for example [[p0]]. This command must be run with superuser permissions (see [[p1]]), and will affect all users on the system. To set the path without superuser permissions or only for the current shell session, use the DEVELOPER_DIR environment variable instead (see [[p2]]).",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "/Applications/Xcode-beta.app"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "strong",
            "text": "sudo(8)"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "em",
            "text": "ENVIRONMENT"
          }
        }
      ]
    },
