    },
    {
      "id": "s0039",
      "kind": "heading",
      "text": "STANDARDS",
      "protected": []
    },
    {
      "id": "s0040",
      "kind": "paragraph",
      "text": "The [[p0]] utility conforms to IEEE Std 1003.2-1992 (“POSIX.2”).",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "cut"
        }
      ]
    },
    {
      "id": "s0041",
      "kind": "paragraph",
      "text": "The [[p0]] flag is an extension to the specification.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-w"
        }
      ]
    },
    {
      "id": "s0042",
      "kind": "heading",
