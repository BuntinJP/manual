            "text": "cut"
          }
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "paragraph",
      "text": "[[p0]] [[p1]] [[[p2]]] [[[p3]]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
