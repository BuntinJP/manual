            "text": "cut"
          }
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "[[p0]] [[p1]] [[[p2]]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-c"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "em",
            "text": "list"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "em",
            "text": "file ..."
          }
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "cut"
          }
        }
      ]
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "[[p0]] [[p1]] [[[p2]] | [[p3]] [[p4]]] [[[p5]]] [[[p6]]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-f"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "em",
            "text": "list"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "code",
            "text": "-w"
          }
        },
        {
          "token": "[[p3]]",
          "inline": {
            "tag": "code",
            "text": "-d"
          }
        },
        {
          "token": "[[p4]]",
          "inline": {
            "tag": "em",
            "text": "delim"
          }
        },
        {
          "token": "[[p5]]",
          "inline": {
            "tag": "code",
            "text": "-s"
          }
        },
        {
          "token": "[[p6]]",
