    {
      "id": "s0035",
      "kind": "heading",
      "text": "HISTORY",
      "protected": []
    },
    {
      "id": "s0036",
      "kind": "paragraph",
      "text": "[[p0]] was introduced in macOS Catalina 10.15.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "systemextensionsctl"
          }
        }
      ]
