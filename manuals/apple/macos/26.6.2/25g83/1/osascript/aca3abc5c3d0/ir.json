            "tag": "code",
            "text": "osascript"
          }
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "paragraph",
      "text": "[[[p0]] [[p1]]] [[[p2]]] [[[p3]] [[p4]]] [[[p5]] [[p6]] | [[p7]]] [[[p8]]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-l"
          }
        },
        {
          "token": "[[p1]]",
