      "id": "s0001",
      "kind": "heading",
      "text": "NAME",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "[[p0]] — execute OSA scripts (AppleScript, JavaScript, etc.)",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "osascript"
          }
        }
      ]
    },
    {
