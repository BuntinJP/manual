  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "NAME",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "[[p0]] — compile AppleScripts and other OSA language scripts",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "osacompile"
        }
      ]
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "SYNOPSIS",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "osacompile"
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "paragraph",
      "text": "[[[p0]] [[p1]]] [[[p2]] [[p3]]] [[[p4]] [[p5]]] [[[p6]]] [[[p7]] [[p8]]] [[[p9]] [[p10]]] [[[p11]] [[p12]]] [[[p13]]] [[[p14]]] [[[p15]]] [[[p16]]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-l"
        },
        {
          "token": "[[p1]]",
          "text": "language"
        },
        {
          "token": "[[p2]]",
          "text": "-e"
        },
        {
