        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "-memtrace"
          }
        }
      ]
    },
    {
      "id": "s0071",
      "kind": "paragraph",
      "text": "Trace all memory allocations.",
      "protected": []
    },
    {
      "id": "s0072",
      "kind": "term",
      "text": "[[p0]][[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "-newline"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "em",
            "text": "sep"
          }
        }
      ]
    },
    {
      "id": "s0073",
      "kind": "paragraph",
      "text": "Set output row separator. Default is '\\n'.",
      "protected": []
    },
    {
      "id": "s0074",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "-nofollow"
          }
        }
      ]
    },
    {
      "id": "s0075",
      "kind": "paragraph",
      "text": "Refuse to open paths containing symbolic links.",
      "protected": []
    },
    {
      "id": "s0076",
      "kind": "term",
      "text": "[[p0]][[p1]] string[[p2]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "strong"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "-nonce"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "strong"
          }
        }
      ]
    },
    {
      "id": "s0077",
      "kind": "paragraph",
      "text": "Set the safe-mode escape nonce to [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "em",
            "text": "string"
          }
        }
      ]
    },
    {
      "id": "s0078",
      "kind": "term",
      "text": "[[p0]][[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "-nullvalue"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "em",
            "text": "string"
          }
        }
      ]
    },
    {
      "id": "s0079",
      "kind": "paragraph",
      "text": "Set string used to represent NULL values. Default is '' (empty string).",
      "protected": []
    },
    {
      "id": "s0080",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "-quote"
          }
        }
      ]
    },
    {
      "id": "s0081",
      "kind": "paragraph",
      "text": "Set output mode to quote.",
      "protected": []
    },
    {
      "id": "s0082",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "-readonly"
          }
        }
      ]
    },
    {
      "id": "s0083",
      "kind": "paragraph",
      "text": "Open the database read-only.",
      "protected": []
    },
    {
      "id": "s0084",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "-safe"
          }
        }
      ]
    },
    {
      "id": "s0085",
      "kind": "paragraph",
      "text": "Enable safe-mode.",
      "protected": []
    },
    {
      "id": "s0086",
      "kind": "term",
      "text": "[[p0]][[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "-separator"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "em",
            "text": "separator"
          }
        }
      ]
    },
    {
      "id": "s0087",
      "kind": "paragraph",
      "text": "Set output field separator. Default is '|'.",
      "protected": []
    },
    {
      "id": "s0088",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "-stats"
          }
        }
      ]
    },
    {
      "id": "s0089",
      "kind": "paragraph",
      "text": "Print memory stats before each finalize.",
      "protected": []
    },
    {
      "id": "s0090",
      "kind": "term",
      "text": "[[p0]][[p1]] PASSPHRASE[[p2]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "strong"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "-textkey"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "strong"
          }
        }
      ]
    },
    {
      "id": "s0091",
      "kind": "paragraph",
      "text": "Text to be hashed into the encryption key.",
      "protected": []
    },
    {
      "id": "s0092",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "-table"
          }
        }
      ]
    },
    {
      "id": "s0093",
      "kind": "paragraph",
      "text": "Set output mode to 'table'.",
      "protected": []
    },
    {
      "id": "s0094",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "-tabs"
          }
        }
      ]
    },
    {
      "id": "s0095",
      "kind": "paragraph",
      "text": "Set output mode to 'tabs'.",
      "protected": []
    },
    {
      "id": "s0096",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "-version"
          }
        }
      ]
    },
    {
      "id": "s0097",
      "kind": "paragraph",
      "text": "Show SQLite version.",
      "protected": []
    },
    {
      "id": "s0098",
      "kind": "term",
      "text": "[[p0]][[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "-vfs"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "em",
            "text": "name"
          }
        }
      ]
    },
    {
      "id": "s0099",
      "kind": "paragraph",
      "text": "Use [[p0]] as the default VFS.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "em",
            "text": "name"
          }
        }
      ]
    },
    {
      "id": "s0100",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "-zip"
          }
        }
      ]
    },
    {
      "id": "s0101",
      "kind": "paragraph",
      "text": "Open the file as a zip archive.",
      "protected": []
    },
    {
      "id": "s0102",
      "kind": "heading",
      "text": "INIT FILE",
      "protected": []
    },
    {
      "id": "s0103",
      "kind": "paragraph",
      "text": "[[p0]] reads an initialization file to set the configuration of the interactive environment. Throughout initialization, any previously specified setting can be overridden. The sequence of initialization is as follows:",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "sqlite3"
          }
        }
      ]
    },
    {
      "id": "s0104",
      "kind": "paragraph",
      "text": "o The default configuration is established as follows:",
      "protected": []
    },
    {
      "id": "s0105",
      "kind": "paragraph",
      "text": "o If the file [[p0]] or [[p1]] exists, the first of those to be found is processed during startup. It should generally only contain meta-commands.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "${XDG_CONFIG_HOME}/sqlite3/sqliterc"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "strong",
            "text": "~/.sqliterc"
          }
        }
      ]
    },
    {
      "id": "s0106",
      "kind": "paragraph",
      "text": "o If the [[p0]] option is present, the specified file is processed.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-init"
          }
        }
      ]
    },
    {
      "id": "s0107",
      "kind": "paragraph",
      "text": "o All other command line options are processed.",
      "protected": []
    },
    {
      "id": "s0108",
      "kind": "heading",
      "text": "SEE ALSO",
      "protected": []
    },
    {
      "id": "s0109",
      "kind": "paragraph",
      "text": "https://sqlite.org/cli.html [[p0]] https://sqlite.org/fiddle (a WebAssembly build of the CLI app) [[p1]] The sqlite3-doc package.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "br"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "br"
          }
        }
      ]
    },
    {
      "id": "s0110",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0111",
      "kind": "paragraph",
      "text": "This manual page was originally written by Andreas Rottmann <rotty@debian.org>, for the Debian GNU/Linux system (but may be used by others). It was subsequently revised by Bill Bumgarner <bbum@mac.com>, Laszlo Boszormenyi <gcs@debian.hu>, Scott Perry <sqlite@numist.net>, and the sqlite3 developers.",
      "protected": []
    }
  ],
