      "kind": "term",
      "text": "[[p0]][[p1]] ARGS...[[p2]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "strong"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "-A"
