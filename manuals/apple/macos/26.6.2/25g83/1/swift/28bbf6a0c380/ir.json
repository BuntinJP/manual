      "text": "NAME",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "swift -- Safe, fast, and expressive general-purpose programming language",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "SYNOPSIS",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "To invoke the Swift REPL (Read-Eval-Print-Loop):",
      "protected": []
    },
    {
      "id": "s0005",
      "kind": "paragraph",
      "text": "[[p0]] repl",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "swift"
          }
        }
      ]
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "To execute a Swift program:",
      "protected": []
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "[[p0]] program.swift <arguments>",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "swift"
          }
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "To work with the Swift Package Manager:",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "[[p0]] build|package|run|test [options] <inputs>",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "swift"
          }
        }
      ]
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "To invoke the Swift compiler:",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "paragraph",
      "text": "[[p0]] [options] <inputs>",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "strong",
            "text": "swiftc"
          }
        }
      ]
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "A list of supported options is available through the \"[[p0]]\" option:",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-help"
          }
        }
      ]
    },
