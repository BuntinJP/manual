        }
      ]
    },
    {
      "id": "s0062",
      "kind": "paragraph",
      "text": "Do not discard the last [[p0]] lines of the common prefix and the first [[p1]] lines of the common suffix. See [[p2]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "lines"
        },
        {
          "token": "[[p1]]",
          "text": "lines"
        },
        {
          "token": "[[p2]]",
          "text": "diff Performance Tradeoffs"
