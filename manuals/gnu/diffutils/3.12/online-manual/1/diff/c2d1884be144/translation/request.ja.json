          "token": "[[p1]]",
          "text": "file"
        }
      ]
    },
    {
      "id": "s0059",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--help"
        }
      ]
    },
    {
      "id": "s0060",
      "kind": "paragraph",
      "text": "Output a summary of usage and then exit.",
      "protected": []
    },
    {
