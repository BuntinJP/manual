      ]
    },
    {
      "id": "s0051",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-f"
        }
      ]
    },
    {
      "id": "s0052",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--forward-ed"
        }
      ]
    },
    {
      "id": "s0053",
      "kind": "paragraph",
      "text": "Make output that looks vaguely like an [[p0]] script but has changes in the order they appear in the file. See [[p1]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "ed"
        },
        {
          "token": "[[p1]]",
          "text": "Forward ed Scripts"
        }
      ]
    },
    {
      "id": "s0054",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-F regexp"
        }
      ]
