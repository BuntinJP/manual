            "text": "-p"
          }
        }
      ]
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "The port which [[p0]] shall listen on, default is port 9922.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "smb_prometheus_endpoint"
          }
        }
      ]
    },
