      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This tool is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "samba(8)",
            "href": "https://www.samba.org/samba/docs/current/man-html/samba.8.html"
          }
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "Make the Samba profiling information available to prometheus via http.",
      "protected": []
    },
    {
      "id": "s0008",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "term",
      "text": "[[p0]] ADDRESS",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-a"
          }
        }
      ]
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "The address which [[p0]] shall listen on, default is 127.0.0.1.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "smb_prometheus_endpoint"
          }
        }
      ]
    },
    {
