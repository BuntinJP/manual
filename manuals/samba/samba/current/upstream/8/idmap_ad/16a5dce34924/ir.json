      "id": "s0024",
      "kind": "term",
      "text": "allow ous",
      "protected": []
    },
    {
      "id": "s0025",
      "kind": "paragraph",
      "text": "This parameter is a list of OUs from which objects will be mapped via the ad idmap module. If [[p0]][[p1]][[p2]] is set but [[p3]][[p4]][[p5]] is not set, every object outside the OUs [[p6]][[p7]][[p8]] is denied.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
