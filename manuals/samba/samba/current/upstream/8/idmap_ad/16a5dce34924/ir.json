    {
      "type": "heading",
      "level": 3,
      "anchor": "EXAMPLES",
      "segment": "s0028"
    },
    {
      "type": "paragraph",
      "segment": "s0029"
    },
    {
      "type": "literal",
      "text": "\t[global]\n\tworkgroup = CORP\n\n\tidmap config * : backend = tdb\n\tidmap config * : range = 1000000-1999999\n\n\tidmap config CORP : backend  = ad\n\tidmap config CORP : range = 1000-999999"
