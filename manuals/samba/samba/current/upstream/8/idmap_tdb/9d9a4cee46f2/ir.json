      "segment": "s0010"
    },
    {
      "type": "literal",
      "text": "\t[global]\n\t# \"backend = tdb\" is redundant here since it is the default\n\tidmap config * : backend = tdb\n\tidmap config * : range = 1000000-2000000"
    },
