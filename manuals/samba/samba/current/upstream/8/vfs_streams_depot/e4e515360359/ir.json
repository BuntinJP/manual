  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "vfs_streams_depot — EXPERIMENTAL module to store alternate data streams in a central directory.",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "vfs objects = streams_depot"
          }
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This [[p0]]EXPERIMENTAL[[p1]] VFS module is part of the [[p2]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "link",
            "text": "samba(7)",
            "href": "https://www.samba.org/samba/docs/current/man-html/samba.7.html"
          }
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "The [[p0]] enables storing of NTFS alternate data streams in the file system. As a normal posix file system does not support the concept of multiple data streams per file, the streams_depot module stores the data in files in a separate directory.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "vfs_streams_depot"
          }
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "term",
      "text": "streams_depot:directory = PATH",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "Path of the directory where the alternate data streams should be stored. Defaults to the sharepath/.streams.",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "term",
      "text": "streams_depot:delete_lost = [ yes | no ]",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "In the case of an already existing data streams directory for a newly created file the streams directory will be renamed to \"lost-[[p0]]u\", random(). With this option lost stream directories will be removed instead of renamed.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "%l"
          }
        }
      ]
    },
    {
      "id": "s0013",
      "kind": "paragraph",
      "text": "[[p0]] - rename lost streams to \"lost-[[p1]]u\", random().",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "no(default)"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "%l"
          }
        }
      ]
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "[[p0]] - remove lost streams.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "yes"
          }
        }
      ]
    },
    {
      "id": "s0015",
      "kind": "heading",
      "text": "EXAMPLES",
      "protected": []
    },
    {
      "id": "s0016",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0017",
      "kind": "paragraph",
      "text": "The original Samba software and related utilities were created by Andrew Tridgell. Samba is now developed by the Samba Team as an Open Source project similar to the way the Linux kernel is developed.",
      "protected": []
    }
  ],
