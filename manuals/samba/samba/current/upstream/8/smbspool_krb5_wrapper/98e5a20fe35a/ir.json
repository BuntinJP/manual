    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "smbspool_krb5_wrapper — This is a CUPS printing backend which calls smbspool",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
