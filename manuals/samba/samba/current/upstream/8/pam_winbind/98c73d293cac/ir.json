{
  "schemaVersion": 1,
  "parserVersion": 1,
  "sourceSha256": "98c73d293cac4de607b465bc1bb12dd51c77e90d814a1304183bd16520ca89f3",
  "extraction": {
    "selector": ".refentry",
    "kind": "semantic-html",
