  "blocks": [
    {
      "type": "heading",
      "level": 3,
      "anchor": "Name",
      "segment": "s0001"
    },
    {
      "type": "paragraph",
      "segment": "s0002"
    },
    {
      "type": "heading",
      "level": 3,
      "anchor": "DESCRIPTION",
      "segment": "s0003"
    },
    {
      "type": "paragraph",
      "segment": "s0004"
    },
    {
      "type": "paragraph",
      "segment": "s0005"
    },
    {
      "type": "heading",
      "level": 3,
      "anchor": "SYNOPSIS",
      "segment": "s0006"
    },
    {
      "type": "paragraph",
      "segment": "s0007"
    },
    {
      "type": "literal",
      "text": "\t\t\t    ...\n\t\t\t    auth      required        pam_env.so\n\t\t\t    auth      sufficient      pam_unix2.so\n\t\t\t+++ auth      required        pam_winbind.so  use_first_pass\n\t\t\t    account   requisite       pam_unix2.so\n\t\t\t+++ account   required        pam_winbind.so  use_first_pass\n\t\t\t+++ password  sufficient      pam_winbind.so\n\t\t\t    password  requisite       pam_pwcheck.so  cracklib\n\t\t\t    password  required        pam_unix2.so    use_authtok\n\t\t\t    session   required        pam_unix2.so\n\t\t\t+++ session   required        pam_winbind.so\n\t\t\t    ..."
    },
    {
      "type": "paragraph",
      "segment": "s0008"
