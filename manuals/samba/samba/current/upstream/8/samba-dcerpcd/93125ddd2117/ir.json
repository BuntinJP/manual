  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "samba-dcerpcd — This is one of Samba's DCERPC server processes that can listen on sockets where RPC services are offered and is the parent process of the DCERPC services it invokes. Unless separately invoked it is started on demand from [[p0]] or [[p1]] and serves DCERPC only over named pipes (np) as a helper process. This will be the standard setup for most installations (standalone/member server/AD server) unless they modify their startup scripts. Note in when Samba is configured as an Active Directory Domain controller the [[p2]] process that invokes [[p3]] will still provide its normal DCERPC services, not [[p4]]. When separately invoked by system startup scripts or a daemon, the global smb.conf option [[p5]] MUST be set to allow [[p6]] to start standalone.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "smbd"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "winbind"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "code",
            "text": "samba"
          }
        },
        {
          "token": "[[p3]]",
          "inline": {
            "tag": "code",
            "text": "smbd"
          }
        },
        {
          "token": "[[p4]]",
          "inline": {
            "tag": "code",
            "text": "samba-dcerpcd"
          }
        },
        {
          "token": "[[p5]]",
          "inline": {
            "tag": "link",
            "text": "rpc start on demand helpers = false",
            "href": "https://www.samba.org/samba/docs/current/man-html/smb.conf.5.html#RPCSTARTONDEMANDHELPERS"
          }
        },
        {
          "token": "[[p6]]",
          "inline": {
            "tag": "code",
            "text": "samba-dcerpcd"
          }
        }
      ]
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]] [[[p1]]|[[p2]]] [[[p3]]|[[p4]]] [[[p5]]|[[p6]]] [[[p7]]] [[[p8]] <debug level>] [[[p9]]] [[[p10]]=<configuration file>] [[[p11]]=<name>=<value>] [[[p12]]] [[[p13]]] [[[p14]]|[[p15]]] [[[p16]]] [[[p17]]] [[[p18]]] [[[p19]]=<fd>] [<SERVICE_1>] [<SERVICE_2>] [<...>]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "samba-dcerpcd"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
