    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This tool is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "samba(7)"
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "The pdbedit program is used to manage the users accounts stored in the sam database and can only be run by root.",
      "protected": []
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "The pdbedit tool uses the passdb modular interface and is independent from the kind of users database used (currently there are smbpasswd, ldap, nis+ and tdb based and more can be added without changing the tool).",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "There are five main ways to use pdbedit: adding a user account, removing a user account, modifying a user account, listing user accounts, importing users accounts.",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-L"
        },
        {
          "token": "[[p1]]",
          "text": "--list"
        }
      ]
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "This option lists all the user accounts present in the users database. This option prints a list of user/uid pairs separated by the ':' character.",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "pdbedit -L"
        }
      ]
    },
    {
      "id": "s0014",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-v"
        },
        {
          "token": "[[p1]]",
          "text": "--verbose"
        }
      ]
    },
    {
      "id": "s0015",
      "kind": "paragraph",
      "text": "This option enables the verbose listing format. It causes pdbedit to list the users in the database, printing out the account fields in a descriptive format. Used together with [[p0]] also shows passwords hashes.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-w"
        }
      ]
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "pdbedit -L -v"
        }
      ]
    },
    {
      "id": "s0017",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-w"
        },
        {
          "token": "[[p1]]",
          "text": "--smbpasswd-style"
        }
      ]
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "This option sets the \"smbpasswd\" listing format. It will make pdbedit list the users in the database, printing out the account fields in a format compatible with the [[p0]] file format. (see the [[p1]] for details). Instead used together with ([[p2]]) displays the passwords hashes in verbose output.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "smbpasswd"
        },
        {
          "token": "[[p1]]",
          "text": "smbpasswd(5)"
        },
        {
          "token": "[[p2]]",
          "text": "-v"
        }
      ]
    },
    {
      "id": "s0019",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "pdbedit -L -w"
        }
      ]
    },
    {
      "id": "s0020",
      "kind": "term",
      "text": "[[p0]]|[[p1]] username",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-u"
        },
        {
          "token": "[[p1]]",
          "text": "--user"
        }
      ]
    },
    {
      "id": "s0021",
      "kind": "paragraph",
      "text": "This option specifies the username to be used for the operation requested (listing, adding, removing). It is [[p0]]required[[p1]] in add, remove and modify operations and [[p2]]optional[[p3]] in list operations.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "</em>"
        },
        {
          "token": "[[p2]]",
          "text": "<em>"
        },
        {
          "token": "[[p3]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0022",
      "kind": "term",
      "text": "[[p0]]|[[p1]] fullname",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-f"
        },
        {
          "token": "[[p1]]",
          "text": "--fullname"
        }
      ]
    },
    {
      "id": "s0023",
      "kind": "paragraph",
      "text": "This option can be used while adding or modifying a user account. It will specify the user's full name.",
      "protected": []
    },
    {
      "id": "s0024",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-f \"Simo Sorce\""
        }
      ]
    },
    {
      "id": "s0025",
      "kind": "term",
      "text": "[[p0]]|[[p1]] homedir",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-h"
        },
        {
          "token": "[[p1]]",
          "text": "--homedir"
        }
      ]
    },
    {
      "id": "s0026",
      "kind": "paragraph",
      "text": "This option can be used while adding or modifying a user account. It will specify the user's home directory network path.",
      "protected": []
    },
    {
      "id": "s0027",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-h \"\\\\\\\\BERSERKER\\\\sorce\""
        }
      ]
    },
    {
      "id": "s0028",
      "kind": "term",
      "text": "[[p0]]|[[p1]] drive",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-D"
        },
        {
          "token": "[[p1]]",
          "text": "--drive"
        }
      ]
    },
    {
      "id": "s0029",
      "kind": "paragraph",
      "text": "This option can be used while adding or modifying a user account. It will specify the windows drive letter to be used to map the home directory.",
      "protected": []
    },
    {
      "id": "s0030",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-D \"H:\""
        }
      ]
    },
    {
      "id": "s0031",
      "kind": "term",
      "text": "[[p0]]|[[p1]] script",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-S"
        },
        {
          "token": "[[p1]]",
          "text": "--script"
        }
      ]
    },
    {
      "id": "s0032",
      "kind": "paragraph",
      "text": "This option can be used while adding or modifying a user account. It will specify the user's logon script path.",
      "protected": []
    },
    {
      "id": "s0033",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-S \"\\\\\\\\BERSERKER\\\\netlogon\\\\sorce.bat\""
        }
      ]
    },
    {
      "id": "s0034",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--set-nt-hash"
        }
      ]
    },
    {
      "id": "s0035",
      "kind": "paragraph",
      "text": "This option can be used while modifying a user account. It will set the user's password using the nt-hash value given as hexadecimal string. Useful to synchronize passwords.",
      "protected": []
    },
    {
      "id": "s0036",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--set-nt-hash 8846F7EAEE8FB117AD06BDD830B7586C"
        }
      ]
    },
    {
      "id": "s0037",
      "kind": "term",
      "text": "[[p0]]|[[p1]] profile",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-p"
        },
        {
          "token": "[[p1]]",
          "text": "--profile"
        }
      ]
    },
    {
      "id": "s0038",
      "kind": "paragraph",
      "text": "This option can be used while adding or modifying a user account. It will specify the user's profile directory.",
      "protected": []
    },
    {
      "id": "s0039",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-p \"\\\\\\\\BERSERKER\\\\netlogon\""
        }
      ]
    },
    {
      "id": "s0040",
      "kind": "term",
      "text": "[[p0]]|'[[p1]] SID' SID|rid",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-M"
        },
        {
          "token": "[[p1]]",
          "text": "--machine"
        }
      ]
    },
    {
      "id": "s0041",
      "kind": "paragraph",
      "text": "This option can be used while adding or modifying a machine account. It will specify the machines' new primary group SID (Security Identifier) or rid.",
      "protected": []
    },
    {
      "id": "s0042",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-M S-1-5-21-2447931902-1787058256-3961074038-1201"
        }
      ]
    },
    {
      "id": "s0043",
      "kind": "term",
      "text": "[[p0]]|'[[p1]] SID' SID|rid",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-U"
        },
        {
          "token": "[[p1]]",
          "text": "--user"
        }
      ]
    },
    {
      "id": "s0044",
      "kind": "paragraph",
      "text": "This option can be used while adding or modifying a user account. It will specify the users' new SID (Security Identifier) or rid.",
      "protected": []
    },
    {
      "id": "s0045",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-U S-1-5-21-2447931902-1787058256-3961074038-5004"
        }
      ]
    },
    {
      "id": "s0046",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "'--user SID' S-1-5-21-2447931902-1787058256-3961074038-5004"
        }
      ]
    },
    {
      "id": "s0047",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-U 5004"
        }
      ]
    },
    {
      "id": "s0048",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "'--user SID' 5004"
        }
      ]
    },
    {
      "id": "s0049",
      "kind": "term",
      "text": "[[p0]]|[[p1]] account-control",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-c"
        },
        {
          "token": "[[p1]]",
          "text": "--account-control"
        }
      ]
    },
    {
      "id": "s0050",
      "kind": "paragraph",
      "text": "This option can be used while adding or modifying a user account. It will specify the users' account control property. Possible flags are listed below.",
      "protected": []
    },
    {
      "id": "s0051",
      "kind": "paragraph",
      "text": "N: No password required",
      "protected": []
    },
    {
      "id": "s0052",
      "kind": "paragraph",
      "text": "D: Account disabled",
      "protected": []
    },
    {
      "id": "s0053",
      "kind": "paragraph",
      "text": "H: Home directory required",
      "protected": []
    },
    {
      "id": "s0054",
      "kind": "paragraph",
      "text": "T: Temporary duplicate of other account",
      "protected": []
    },
    {
      "id": "s0055",
      "kind": "paragraph",
      "text": "U: Regular user account",
      "protected": []
    },
    {
      "id": "s0056",
      "kind": "paragraph",
      "text": "M: MNS logon user account",
      "protected": []
    },
    {
      "id": "s0057",
      "kind": "paragraph",
      "text": "W: Workstation Trust Account",
      "protected": []
    },
    {
      "id": "s0058",
      "kind": "paragraph",
      "text": "S: Server Trust Account",
      "protected": []
    },
    {
      "id": "s0059",
      "kind": "paragraph",
      "text": "L: Automatic Locking",
      "protected": []
    },
    {
      "id": "s0060",
      "kind": "paragraph",
      "text": "X: Password does not expire",
      "protected": []
    },
    {
      "id": "s0061",
      "kind": "paragraph",
      "text": "I: Domain Trust Account",
      "protected": []
    },
    {
      "id": "s0062",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-c \"[X ]\""
        }
      ]
    },
    {
      "id": "s0063",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-K"
        },
        {
          "token": "[[p1]]",
          "text": "--kickoff-time"
        }
      ]
    },
    {
      "id": "s0064",
      "kind": "paragraph",
      "text": "This option is used to modify the kickoff time for a certain user. Use \"never\" as argument to set the kickoff time to unlimited.",
      "protected": []
    },
    {
      "id": "s0065",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "pdbedit -K never user"
        }
      ]
    },
    {
      "id": "s0066",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-a"
        },
        {
          "token": "[[p1]]",
          "text": "--create"
        }
      ]
    },
    {
      "id": "s0067",
      "kind": "paragraph",
      "text": "This option is used to add a user into the database. This command needs a user name specified with the [[p0]] switch. When adding a new user, pdbedit will also ask for the password to be used.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-u"
        }
      ]
    },
    {
      "id": "s0068",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "pdbedit -a -u sorce"
        }
      ]
    },
    {
      "id": "s0069",
      "kind": "heading",
      "text": "Note",
      "protected": []
    },
    {
      "id": "s0070",
      "kind": "paragraph",
      "text": "pdbedit does not call the unix password synchronization script if [[p0]] has been set. It only updates the data in the Samba user database.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "unix password sync"
        }
      ]
    },
    {
      "id": "s0071",
      "kind": "paragraph",
      "text": "If you wish to add a user and synchronise the password that immediately, use [[p0]]'s [[p1]] option.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "smbpasswd"
        },
        {
          "token": "[[p1]]",
          "text": "-a"
        }
      ]
    },
    {
      "id": "s0072",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-t"
        },
        {
          "token": "[[p1]]",
          "text": "--password-from-stdin"
        }
      ]
    },
    {
      "id": "s0073",
      "kind": "paragraph",
      "text": "This option causes pdbedit to read the password from standard input, rather than from /dev/tty (like the [[p0]] program does). The password has to be submitted twice and terminated by a newline each.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "passwd(1)"
        }
      ]
    },
    {
      "id": "s0074",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-r"
        },
        {
          "token": "[[p1]]",
          "text": "--modify"
        }
      ]
    },
    {
      "id": "s0075",
      "kind": "paragraph",
      "text": "This option is used to modify an existing user in the database. This command needs a user name specified with the [[p0]] switch. Other options can be specified to modify the properties of the specified user. This flag is kept for backwards compatibility, but it is no longer necessary to specify it.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-u"
        }
      ]
    },
    {
      "id": "s0076",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-m"
        },
        {
          "token": "[[p1]]",
          "text": "--machine"
        }
      ]
    },
    {
      "id": "s0077",
      "kind": "paragraph",
      "text": "This option may only be used in conjunction with the [[p0]][[p1]][[p2]] option. It will make pdbedit to add a machine trust account instead of a user account ([[p3]] username will provide the machine name).",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "-a"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        },
        {
          "token": "[[p3]]",
          "text": "-u"
        }
      ]
    },
    {
      "id": "s0078",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "pdbedit -a -m -u w2k-wks"
        }
      ]
    },
    {
      "id": "s0079",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-x"
        },
        {
          "token": "[[p1]]",
          "text": "--delete"
        }
      ]
    },
    {
      "id": "s0080",
      "kind": "paragraph",
      "text": "This option causes pdbedit to delete an account from the database. It needs a username specified with the [[p0]] switch.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-u"
        }
      ]
    },
    {
      "id": "s0081",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "pdbedit -x -u bob"
        }
      ]
    },
    {
      "id": "s0082",
      "kind": "term",
      "text": "[[p0]]|[[p1]] passdb-backend",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-i"
        },
        {
          "token": "[[p1]]",
          "text": "--import"
        }
      ]
    },
    {
      "id": "s0083",
      "kind": "paragraph",
      "text": "Use a different passdb backend to retrieve users than the one specified in smb.conf. Can be used to import data into your local user database.",
      "protected": []
    },
    {
      "id": "s0084",
      "kind": "paragraph",
      "text": "This option will ease migration from one passdb backend to another.",
      "protected": []
    },
    {
      "id": "s0085",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "pdbedit -i smbpasswd:/etc/smbpasswd.old"
        }
      ]
    },
    {
      "id": "s0086",
      "kind": "term",
      "text": "[[p0]]|[[p1]] passdb-backend",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-e"
        },
        {
          "token": "[[p1]]",
          "text": "--export"
        }
      ]
    },
    {
      "id": "s0087",
      "kind": "paragraph",
      "text": "Exports all currently available users to the specified password database backend.",
      "protected": []
    },
    {
      "id": "s0088",
      "kind": "paragraph",
      "text": "This option will ease migration from one passdb backend to another and will ease backing up.",
      "protected": []
    },
    {
      "id": "s0089",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "pdbedit -e smbpasswd:/root/samba-users.backup"
        }
      ]
    },
    {
      "id": "s0090",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-g"
        },
        {
          "token": "[[p1]]",
          "text": "--group"
        }
      ]
    },
    {
      "id": "s0091",
      "kind": "paragraph",
      "text": "If you specify [[p0]][[p1]][[p2]], then [[p3]][[p4]][[p5]] applies to the group mapping instead of the user database.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "-g"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        },
        {
          "token": "[[p3]]",
          "text": "<em>"
        },
        {
          "token": "[[p4]]",
          "text": "-i in-backend -e out-backend"
        },
        {
          "token": "[[p5]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0092",
      "kind": "paragraph",
      "text": "This option will ease migration from one passdb backend to another and will ease backing up.",
      "protected": []
    },
    {
      "id": "s0093",
      "kind": "term",
      "text": "[[p0]]|[[p1]] passdb-backend",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-b"
        },
        {
          "token": "[[p1]]",
          "text": "--backend"
        }
      ]
    },
    {
      "id": "s0094",
      "kind": "paragraph",
      "text": "Use a different default passdb backend.",
      "protected": []
    },
    {
      "id": "s0095",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "pdbedit -b xml:/root/pdb-backup.xml -l"
        }
      ]
    },
    {
      "id": "s0096",
      "kind": "term",
      "text": "[[p0]]|[[p1]] account-policy",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-P"
        },
        {
          "token": "[[p1]]",
          "text": "--account-policy"
        }
      ]
    },
    {
      "id": "s0097",
      "kind": "paragraph",
      "text": "Display an account policy",
      "protected": []
    },
    {
      "id": "s0098",
      "kind": "paragraph",
      "text": "Valid policies are: minimum password age, reset count minutes, disconnect time, user must logon to change password, password history, lockout duration, min password length, maximum password age and bad lockout attempt.",
      "protected": []
    },
    {
      "id": "s0099",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "pdbedit -P \"bad lockout attempt\""
        }
      ]
    },
    {
      "id": "s0100",
      "kind": "term",
      "text": "[[p0]]|[[p1]] account-policy-value",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-C"
        },
        {
          "token": "[[p1]]",
          "text": "--value"
        }
      ]
    },
    {
      "id": "s0101",
      "kind": "paragraph",
      "text": "Sets an account policy to a specified value. This option may only be used in conjunction with the [[p0]][[p1]][[p2]] option.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "-P"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0102",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "pdbedit -P \"bad lockout attempt\" -C 3"
        }
      ]
    },
    {
      "id": "s0103",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-y"
        },
        {
          "token": "[[p1]]",
          "text": "--policies"
        }
      ]
    },
    {
      "id": "s0104",
      "kind": "paragraph",
      "text": "If you specify [[p0]][[p1]][[p2]], then [[p3]][[p4]][[p5]] applies to the account policies instead of the user database.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "-y"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        },
        {
          "token": "[[p3]]",
          "text": "<em>"
        },
        {
          "token": "[[p4]]",
          "text": "-i in-backend -e out-backend"
        },
        {
          "token": "[[p5]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0105",
      "kind": "paragraph",
      "text": "This option will allow one to migrate account policies from their default tdb-store into a passdb backend, e.g. an LDAP directory server.",
      "protected": []
    },
    {
      "id": "s0106",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "pdbedit -y -i tdbsam: -e ldapsam:ldap://my.ldap.host"
        }
      ]
    },
    {
      "id": "s0107",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--force-initialized-passwords"
        }
      ]
    },
    {
      "id": "s0108",
      "kind": "paragraph",
      "text": "This option forces all users to change their password upon next login.",
      "protected": []
    },
    {
      "id": "s0109",
      "kind": "term",
      "text": "[[p0]]|[[p1]] description",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-N"
        },
        {
          "token": "[[p1]]",
          "text": "--account-desc"
        }
      ]
    },
    {
      "id": "s0110",
      "kind": "paragraph",
      "text": "This option can be used while adding or modifying a user account. It will specify the user's description field.",
      "protected": []
    },
    {
      "id": "s0111",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-N \"test description\""
        }
      ]
    },
    {
      "id": "s0112",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-Z"
        },
        {
          "token": "[[p1]]",
          "text": "--logon-hours-reset"
        }
      ]
    },
    {
      "id": "s0113",
      "kind": "paragraph",
      "text": "This option can be used while adding or modifying a user account. It will reset the user's allowed logon hours. A user may login at any time afterwards.",
      "protected": []
    },
    {
      "id": "s0114",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-Z"
        }
      ]
    },
    {
      "id": "s0115",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-z"
        },
        {
          "token": "[[p1]]",
          "text": "--bad-password-count-reset"
        }
      ]
    },
    {
      "id": "s0116",
      "kind": "paragraph",
      "text": "This option can be used while adding or modifying a user account. It will reset the stored bad login counter from a specified user.",
      "protected": []
    },
    {
      "id": "s0117",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-z"
        }
      ]
    },
    {
      "id": "s0118",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--policies-reset"
        }
      ]
    },
    {
      "id": "s0119",
      "kind": "paragraph",
      "text": "This option can be used to reset the general password policies stored for a domain to their default values.",
      "protected": []
    },
    {
      "id": "s0120",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--policies-reset"
        }
      ]
    },
    {
      "id": "s0121",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-I"
        },
        {
          "token": "[[p1]]",
          "text": "--domain"
        }
      ]
    },
    {
      "id": "s0122",
      "kind": "paragraph",
      "text": "This option can be used while adding or modifying a user account. It will specify the user's domain field.",
      "protected": []
    },
    {
      "id": "s0123",
      "kind": "paragraph",
      "text": "Example: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-I \"MYDOMAIN\""
        }
      ]
    },
    {
      "id": "s0124",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--time-format"
        }
      ]
    },
    {
      "id": "s0125",
      "kind": "paragraph",
      "text": "This option is currently not being used.",
      "protected": []
    },
    {
      "id": "s0126",
      "kind": "term",
      "text": "-?|[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--help"
        }
      ]
    },
    {
      "id": "s0127",
      "kind": "paragraph",
      "text": "Print a summary of command line options.",
      "protected": []
    },
    {
      "id": "s0128",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--usage"
        }
      ]
    },
    {
      "id": "s0129",
      "kind": "paragraph",
      "text": "Display brief usage message.",
      "protected": []
    },
    {
      "id": "s0130",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=level",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-d"
        },
        {
          "token": "[[p1]]",
          "text": "--debuglevel"
        }
      ]
    },
    {
      "id": "s0131",
      "kind": "paragraph",
      "text": "[[p0]][[p1]][[p2]] is an integer from 0 to 10. The default value if this parameter is not specified is 1 for client applications.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "level"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0132",
      "kind": "paragraph",
      "text": "The higher this value, the more detail will be logged to the log files about the activities of the server. At level 0, only critical errors and serious warnings will be logged. Level 1 is a reasonable level for day-to-day running - it generates a small amount of information about operations carried out.",
      "protected": []
    },
    {
      "id": "s0133",
      "kind": "paragraph",
      "text": "Levels above 1 will generate considerable amounts of log data, and should only be used when investigating a problem. Levels above 3 are designed for use only by developers and generate HUGE amounts of log data, most of which is extremely cryptic.",
      "protected": []
    },
    {
      "id": "s0134",
      "kind": "paragraph",
      "text": "Note that specifying this parameter here will override the [[p0]] parameter in the [[p1]] file.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "log level"
        },
        {
          "token": "[[p1]]",
          "text": "${prefix}/etc/smb.conf"
        }
      ]
    },
    {
      "id": "s0135",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--debug-stdout"
        }
      ]
    },
    {
      "id": "s0136",
      "kind": "paragraph",
      "text": "This will redirect debug output to STDOUT. By default all clients are logging to STDERR.",
      "protected": []
    },
    {
      "id": "s0137",
      "kind": "term",
      "text": "[[p0]]=<configuration file>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--configfile"
        }
      ]
    },
    {
      "id": "s0138",
      "kind": "paragraph",
      "text": "The file specified contains the configuration details required by the client. The information in this file can be general for client and server or only provide client specific like options such as [[p0]]. See [[p1]] for more information. The default configuration file name is determined at compile time.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "client smb encrypt"
        },
        {
          "token": "[[p1]]",
          "text": "${prefix}/etc/smb.conf"
        }
      ]
    },
    {
      "id": "s0139",
      "kind": "term",
      "text": "[[p0]]=<name>=<value>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--option"
        }
      ]
    },
    {
      "id": "s0140",
      "kind": "paragraph",
      "text": "Set the [[p0]] option \"<name>\" to value \"<value>\" from the command line. This overrides compiled-in defaults and options read from the configuration file. If a name or a value includes a space, wrap whole [[p1]]=name=value into quotes.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "smb.conf(5)"
        },
        {
          "token": "[[p1]]",
          "text": "--option"
        }
      ]
    },
    {
      "id": "s0141",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=logdirectory",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-l"
        },
        {
          "token": "[[p1]]",
          "text": "--log-basename"
        }
      ]
    },
    {
      "id": "s0142",
      "kind": "paragraph",
      "text": "Base directory name for log/debug files. The extension [[p0]] will be appended (e.g. log.smbclient, log.smbd, etc...). The log file is never removed by the client.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "\".progname\""
        }
      ]
    },
    {
      "id": "s0143",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--leak-report"
        }
      ]
    },
    {
      "id": "s0144",
      "kind": "paragraph",
      "text": "Enable talloc leak reporting on exit.",
      "protected": []
    },
    {
      "id": "s0145",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--leak-report-full"
        }
      ]
    },
    {
      "id": "s0146",
      "kind": "paragraph",
      "text": "Enable full talloc leak reporting on exit.",
      "protected": []
    },
    {
      "id": "s0147",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-V"
        },
        {
          "token": "[[p1]]",
          "text": "--version"
        }
      ]
    },
    {
      "id": "s0148",
      "kind": "paragraph",
      "text": "Prints the program version number.",
      "protected": []
    },
    {
      "id": "s0149",
      "kind": "heading",
      "text": "NOTES",
      "protected": []
    },
    {
      "id": "s0150",
      "kind": "paragraph",
      "text": "This command may be used only by root.",
      "protected": []
    },
    {
      "id": "s0151",
      "kind": "heading",
      "text": "VERSION",
      "protected": []
    },
    {
      "id": "s0152",
      "kind": "paragraph",
      "text": "This man page is part of version 4.25.0 of the Samba suite.",
      "protected": []
