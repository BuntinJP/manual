  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "vfs_readahead — pre-load the kernel buffer cache",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "vfs objects = readahead"
          }
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This VFS module is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "samba(7)",
            "href": "https://www.samba.org/samba/docs/current/man-html/samba.7.html"
          }
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "This [[p0]] VFS module detects read requests at multiples of a given offset (hex 0x80000 by default) and then tells the kernel via either the readahead system call (on Linux) or the posix_fadvise system call to pre-fetch this data into the buffer cache.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "vfs_readahead"
          }
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "This module is useful for Windows Vista clients reading data using the Windows Explorer program, which asynchronously does multiple file read requests at offset boundaries of 0x80000 bytes.",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "The offset multiple used is given by the readahead:offset option, which defaults to 0x80000.",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "The size of the disk read operations performed by [[p0]] is determined by the readahead:length option. By default this is set to the same value as the readahead:offset option and if not set explicitly will use the current value of readahead:offset.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "vfs_readahead"
          }
        }
      ]
    },
    {
      "id": "s0011",
      "kind": "paragraph",
      "text": "This module is stackable.",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "paragraph",
      "text": "The following suffixes may be applied to BYTES:",
      "protected": []
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "[[p0]] - BYTES is a number of kilobytes",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "K"
          }
        }
      ]
    },
    {
      "id": "s0015",
      "kind": "paragraph",
      "text": "[[p0]] - BYTES is a number of megabytes",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "M"
          }
        }
      ]
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "[[p0]] - BYTES is a number of gigabytes",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "G"
          }
        }
      ]
    },
    {
      "id": "s0017",
      "kind": "term",
      "text": "readahead:offset = BYTES",
      "protected": []
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "The offset multiple that causes readahead to be requested of the kernel buffer cache.",
      "protected": []
    },
    {
      "id": "s0019",
      "kind": "term",
      "text": "readahead:length = BYTES",
      "protected": []
    },
    {
      "id": "s0020",
      "kind": "paragraph",
      "text": "The number of bytes requested to be read into the kernel buffer cache on each readahead call.",
      "protected": []
    },
    {
      "id": "s0021",
      "kind": "heading",
      "text": "EXAMPLES",
      "protected": []
    },
    {
      "id": "s0022",
      "kind": "heading",
      "text": "VERSION",
      "protected": []
    },
    {
      "id": "s0023",
      "kind": "paragraph",
      "text": "This man page is part of version 4.25.0 of the Samba suite.",
      "protected": []
    },
    {
      "id": "s0024",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0025",
      "kind": "paragraph",
      "text": "The original Samba software and related utilities were created by Andrew Tridgell. Samba is now developed by the Samba Team as an Open Source project similar to the way the Linux kernel is developed.",
      "protected": []
    }
  ],
