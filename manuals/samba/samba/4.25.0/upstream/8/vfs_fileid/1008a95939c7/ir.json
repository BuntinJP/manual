    {
      "type": "paragraph",
      "segment": "s0040"
    },
    {
      "type": "literal",
      "text": "        [global]\n\tvfs objects = fileid\n\tfileid:algorithm = fsid"
    },
    {
      "type": "paragraph",
      "segment": "s0041"
    },
    {
      "type": "literal",
      "text": "        [global]\n\tvfs objects = fileid\n\tfileid:algorithm = next_module\n\tfileid:nolock_paths = . ContendedFolder1 /path/to/contended.exe\n\tfileid:nolock_max_slots = 256"
