    {
      "type": "heading",
      "level": 3,
      "anchor": "EXAMPLES",
      "segment": "s0016"
    },
    {
      "type": "paragraph",
      "segment": "s0017"
    },
    {
      "type": "literal",
      "text": "        [avid_mac]\n\tpath = /avid\n\tvfs objects = media_harmony\n\tcache locked write times = no\n        [avid_win]\n\tpath = /avid\n\tvfs objects = media_harmony\n\tcache locked write times = no\n\tveto files = /.DS_Store/._@/.Trash@/.Spotlight@/.hidden/.hotfiles@/.vol/\n\tdelete veto files = yes"
    },
    {
      "type": "paragraph",
      "segment": "s0018"
    },
    {
      "type": "literal",
      "text": "\ttouch '/avid/OMFI MediaFiles_192.168.1.10_david' \\\n\t\t'/avid/OMFI MediaFiles_192.168.1.11_susan' \\\n\t\t'/avid/Avid MediaFiles/MXF/1_192.168.1.10_david' \\\n\t\t'/avid/Avid MediaFiles/MXF/1_192.168.1.11_susan'"
    },
    {
      "type": "paragraph",
      "segment": "s0019"
    },
    {
      "type": "literal",
      "text": "\ttouch '/avid/OMFI MediaFiles_192.168.1.10_david' \\\n\t\t'/avid/Avid MediaFiles/MXF/1_192.168.1.10_david'"
    },
    {
