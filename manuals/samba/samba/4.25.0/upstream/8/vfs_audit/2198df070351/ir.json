      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "vfs objects = audit"
          }
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This VFS module is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "samba(7)",
            "href": "https://www.samba.org/samba/docs/current/man-html/samba.7.html"
          }
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "The [[p0]] VFS module records selected client operations to the system log using [[p1]].",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "vfs_audit"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "link",
            "text": "syslog(3)",
            "href": "https://www.samba.org/samba/docs/current/man-html/syslog.3.html"
          }
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "The following Samba VFS operations are recorded:",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "connect",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "disconnect",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "paragraph",
      "text": "opendir",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "mkdir",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "paragraph",
      "text": "rmdir",
      "protected": []
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "open",
      "protected": []
    },
    {
      "id": "s0015",
      "kind": "paragraph",
      "text": "close",
      "protected": []
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "rename",
      "protected": []
    },
    {
      "id": "s0017",
      "kind": "paragraph",
      "text": "unlink",
      "protected": []
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "chmod",
      "protected": []
    },
    {
      "id": "s0019",
      "kind": "paragraph",
