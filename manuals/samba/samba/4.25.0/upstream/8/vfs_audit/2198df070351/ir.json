      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "vfs_audit — record selected Samba VFS operations in the system log",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
