      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0022",
      "kind": "term",
      "text": "audit:facility = FACILITY",
      "protected": []
    },
    {
      "id": "s0023",
      "kind": "paragraph",
      "text": "Log messages to the named [[p0]] facility.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "syslog(3)",
            "href": "https://www.samba.org/samba/docs/current/man-html/syslog.3.html"
          }
        }
      ]
    },
    {
      "id": "s0024",
      "kind": "term",
      "text": "audit:priority = PRIORITY",
      "protected": []
    },
    {
      "id": "s0025",
      "kind": "paragraph",
      "text": "Log messages with the named [[p0]] priority.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "syslog(3)",
            "href": "https://www.samba.org/samba/docs/current/man-html/syslog.3.html"
