        }
      ]
    },
    {
      "id": "s0026",
      "kind": "heading",
      "text": "EXAMPLES",
      "protected": []
    },
    {
      "id": "s0027",
      "kind": "paragraph",
      "text": "Log operations on all shares using the LOCAL1 facility and NOTICE priority:",
      "protected": []
    },
    {
