  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "vfs_shell_snap — Shell script callouts for snapshot creation and deletion",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "vfs objects = shell_snap"
          }
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This VFS module is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "samba(8)",
            "href": "https://www.samba.org/samba/docs/current/man-html/samba.8.html"
          }
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "The [[p0]] VFS provides shell-script callouts for snapshot creation and deletion operations issued by remote clients using the File Server Remote VSS Protocol (FSRVP).",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "vfs_shell_snap"
          }
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "The following shell callouts may be configured in smb.conf:",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "shell_snap:check path command",
            "href": "https://www.samba.org/samba/docs/current/man-html/smb.conf.5.html#SHELL_SNAP:CHECKPATHCOMMAND"
          }
        }
      ]
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "Called when an FSRVP client wishes to check whether a given share supports snapshot create/delete requests.",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "paragraph",
      "text": "The command is called with a single [[p0]][[p1]][[p2]] argument.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "share_path"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        }
      ]
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "The command must return 0 if [[p0]][[p1]][[p2]] is capable of being snapshotted.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "share_path"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        }
      ]
    },
    {
      "id": "s0013",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "shell_snap:create command",
            "href": "https://www.samba.org/samba/docs/current/man-html/smb.conf.5.html#SHELL_SNAP:CREATECOMMAND"
          }
        }
      ]
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "Called when an FSRVP client wishes to create a snapshot.",
      "protected": []
    },
    {
      "id": "s0015",
      "kind": "paragraph",
      "text": "The command is called with a single [[p0]][[p1]][[p2]] argument.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "share_path"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        }
      ]
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "The command must return 0 status if the snapshot was successfully taken.",
      "protected": []
    },
    {
      "id": "s0017",
      "kind": "paragraph",
      "text": "The command must output the path of the newly created snapshot to stdout.",
      "protected": []
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "shell_snap:delete command",
            "href": "https://www.samba.org/samba/docs/current/man-html/smb.conf.5.html#SHELL_SNAP:DELETECOMMAND"
          }
        }
      ]
    },
    {
      "id": "s0019",
      "kind": "paragraph",
      "text": "Called when an FSRVP client wishes to delete a snapshot.",
      "protected": []
    },
    {
      "id": "s0020",
      "kind": "paragraph",
      "text": "The command is called with [[p0]][[p1]][[p2]] and [[p3]][[p4]][[p5]] arguments.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "base_share_path"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        },
        {
          "token": "[[p3]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p4]]",
          "inline": {
            "tag": "code",
            "text": "snapshot_share_path"
          }
        },
        {
          "token": "[[p5]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        }
      ]
    },
    {
      "id": "s0021",
      "kind": "paragraph",
      "text": "The command must return 0 status if the snapshot was successfully removed.",
      "protected": []
    },
    {
      "id": "s0022",
      "kind": "paragraph",
      "text": "All commands are executed as the authenticated FSRVP client user.",
      "protected": []
    },
    {
      "id": "s0023",
      "kind": "paragraph",
      "text": "This module is stackable.",
      "protected": []
    },
    {
      "id": "s0024",
      "kind": "heading",
      "text": "CONFIGURATION",
      "protected": []
    },
    {
      "id": "s0025",
      "kind": "paragraph",
      "text": "Samba's FSRVP server must be configured in the [global] section:",
      "protected": []
    },
    {
      "id": "s0026",
      "kind": "heading",
      "text": "VERSION",
      "protected": []
    },
    {
      "id": "s0027",
      "kind": "paragraph",
      "text": "This man page is part of version 4.25.0 of the Samba suite.",
      "protected": []
    },
    {
      "id": "s0028",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0029",
      "kind": "paragraph",
      "text": "The original Samba software and related utilities were created by Andrew Tridgell. Samba is now developed by the Samba Team as an Open Source project similar to the way the Linux kernel is developed.",
      "protected": []
    }
  ],
