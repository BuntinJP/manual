    {
      "type": "heading",
      "level": 3,
      "anchor": "CONFIGURATION",
      "segment": "s0024"
    },
    {
      "type": "literal",
      "text": "\t\t[share]\n\t\tvfs objects = shell_snap\n\t\tshell_snap:check path command = snap_check_path.sh\n\t\tshell_snap:create command = snap_create.sh\n\t\tshell_snap:delete command = snap_delete.sh"
    },
    {
      "type": "paragraph",
      "segment": "s0025"
    },
    {
      "type": "literal",
      "text": "\t\t[global]\n\t\tregistry shares = yes\n\t\tinclude = registry"
    },
