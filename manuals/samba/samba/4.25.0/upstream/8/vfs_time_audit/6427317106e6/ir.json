  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "vfs_time_audit — samba vfs module to log slow VFS operations",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "vfs objects = time_audit"
          }
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This VFS module is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "samba(7)",
            "href": "https://www.samba.org/samba/docs/current/man-html/samba.7.html"
          }
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "The [[p0]] VFS module logs system calls that take longer than the number of milliseconds defined by the variable [[p1]]. It will log the calls and the time spent in it.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "time_audit"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "time_audit:timeout"
          }
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "It's kind of comparable with [[p0]] and is helpful to reveal performance problems with the underlying file and storage subsystems.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "strace -T"
          }
        }
      ]
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "This module is stackable.",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "term",
      "text": "time_audit:timeout = number of milliseconds",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "VFS calls that take longer than the defined number of milliseconds that should be logged. The default is 10000 (10s).",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "heading",
      "text": "EXAMPLES",
      "protected": []
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "This would log VFS calls that take longer than 3 seconds:",
      "protected": []
    },
    {
      "id": "s0015",
      "kind": "heading",
      "text": "VERSION",
      "protected": []
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "This man page is part of version 4.25.0 of the Samba suite.",
      "protected": []
    },
    {
      "id": "s0017",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "The original Samba software and related utilities were created by Andrew Tridgell. Samba is now developed by the Samba Team as an Open Source project similar to the way the Linux kernel is developed.",
      "protected": []
    },
    {
      "id": "s0019",
      "kind": "paragraph",
      "text": "The time_audit VFS module was created with contributions from Abhidnya Chirmule.",
      "protected": []
    }
  ],
