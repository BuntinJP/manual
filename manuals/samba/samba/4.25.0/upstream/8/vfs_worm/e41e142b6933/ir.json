  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "vfs_worm — disallows writes for older file",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "vfs objects = worm"
          }
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This VFS module is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "samba(7)",
            "href": "https://www.samba.org/samba/docs/current/man-html/samba.7.html"
          }
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "The [[p0]] module controls the writability of files and folders depending on their change time and a adjustable grace period.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "vfs_worm"
          }
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "If the change time of a file or directory is older than the specified grace period, the write access will be denied, independent of further access controls (e.g. by the filesystem).",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "In the case that the grace period is not exceed, the worm module will not impact any access controls.",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "term",
      "text": "worm:grace_period = SECONDS",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "Period in seconds which defines the time how long the write access should be handled by the normal access controls. After this grace period the file or directory becomes read only.",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "heading",
      "text": "EXAMPLES",
      "protected": []
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "Deny the write access to files and folders, which are older than five minutes (300 seconds):",
      "protected": []
    },
    {
      "id": "s0015",
      "kind": "heading",
      "text": "VERSION",
      "protected": []
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "This man page is part of version 4.25.0 of the Samba suite.",
      "protected": []
    },
    {
      "id": "s0017",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "The original Samba software and related utilities were created by Andrew Tridgell. Samba is now developed by the Samba Team as an Open Source project similar to the way the Linux kernel is developed.",
      "protected": []
    }
  ],
