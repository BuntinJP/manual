    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "winbind_krb5_localauth — A plugin for MIT Kerberos for mapping user accounts.",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "This plugin is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "samba(7)",
            "href": "https://www.samba.org/samba/docs/current/man-html/samba.7.html"
          }
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "paragraph",
      "text": "[[p0]] is a plugin that permits the MIT Kerberos libraries that Kerberos principals can be validated against local user accounts.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "winbind_krb5_localauth"
          }
        }
      ]
    },
    {
      "id": "s0006",
      "kind": "heading",
      "text": "PREREQUISITES",
      "protected": []
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "MIT Kerberos (at least version 1.12) is required.",
      "protected": []
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "The plugin queries the [[p0]] daemon which needs to be configured and started separately.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "winbindd(8)",
            "href": "https://www.samba.org/samba/docs/current/man-html/winbindd.8.html"
          }
        }
      ]
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "The following sections needs to be added to the [[p0]] file.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "krb5.conf"
          }
        }
      ]
    },
    {
      "id": "s0010",
      "kind": "heading",
      "text": "VERSION",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "paragraph",
      "text": "This man page is part of version 4.25.0 of the Samba suite.",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "paragraph",
      "text": "The original Samba software and related utilities were created by Andrew Tridgell. Samba is now developed by the Samba Team as an Open Source project similar to the way the Linux kernel is developed.",
      "protected": []
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "The winbind_krb5_localauth manpage was written by Andreas Schneider.",
      "protected": []
    }
  ],
