    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "smbpasswd — change a user's SMB password",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]] [[[p1]]] [[[p2]] <config file>] [[[p3]]] [[[p4]]] [[[p5]]] [[[p6]] debuglevel] [[[p7]]] [[[p8]] <remote machine>] [[[p9]] <name resolve order>] [[[p10]]] [[[p11]] username[[[p12]]assword]] [[[p13]]] [[[p14]]] [[[p15]] pass] [[[p16]]] [[[p17]]] [[[p18]]] [username]",
      "protected": [
