{
  "schemaVersion": 1,
  "parserVersion": 1,
  "sourceSha256": "24b63fe6cc2b0cfb3d59a524a979ca5b483e2f91a1f035ef9a619262098d0114",
  "extraction": {
    "selector": ".refentry",
    "kind": "semantic-html",
