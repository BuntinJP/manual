    {
      "type": "paragraph",
      "segment": "s0018"
    },
    {
      "type": "literal",
      "text": "        [avid_mac]\n\tpath = /avid\n\tvfs objects = unityed_media\n        [avid_win]\n\tpath = /avid\n\tvfs objects = unityed_media\n\tveto files = /.DS_Store/._@/.Trash@/.Spotlight@/.hidden/.hotfiles@/.vol/\n\tdelete veto files = yes"
