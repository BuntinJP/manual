    {
      "id": "s0007",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "This tool is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "samba(1)"
        }
      ]
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "[[p0]] is a filter that accepts formatted event log records on standard input and writes them to the Samba event log store. Windows client can then manipulate these record using the usual administration tools.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "eventlogadm"
        }
      ]
    },
    {
      "id": "s0010",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "term",
      "text": "[[p0]] [[p1]][[p2]][[p3]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-s"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "FILENAME"
        },
        {
          "token": "[[p3]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "The [[p0]] option causes [[p1]] to load the configuration file given as FILENAME instead of the default one used by Samba.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-s"
        },
        {
          "token": "[[p1]]",
          "text": "eventlogadm"
        }
      ]
    },
    {
      "id": "s0013",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-d"
        }
      ]
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "The [[p0]] option causes [[p1]] to emit debugging information.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-d"
        },
        {
          "token": "[[p1]]",
          "text": "eventlogadm"
        }
      ]
    },
    {
      "id": "s0015",
      "kind": "term",
      "text": "[[p0]] [[p1]] [[p2]][[p3]][[p4]] [[p5]][[p6]][[p7]] [[p8]][[p9]][[p10]]",
      "protected": [
