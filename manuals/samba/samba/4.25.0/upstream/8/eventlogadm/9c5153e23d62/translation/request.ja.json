        }
      ]
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "The [[p0]] option creates a new event log source.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-o addsource"
        }
      ]
    },
    {
      "id": "s0017",
      "kind": "term",
      "text": "[[p0]] [[p1]] [[p2]][[p3]][[p4]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-o"
        },
        {
          "token": "[[p1]]",
          "text": "write"
        },
        {
          "token": "[[p2]]",
          "text": "<em>"
        },
        {
          "token": "[[p3]]",
          "text": "EVENTLOG"
        },
        {
          "token": "[[p4]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "The [[p0]] reads event log records from standard input and writes them to the Samba event log store named by EVENTLOG.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-o write"
        }
      ]
    },
    {
      "id": "s0019",
      "kind": "term",
      "text": "[[p0]] [[p1]] [[p2]][[p3]][[p4]] [[p5]][[p6]][[p7]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-o"
        },
        {
          "token": "[[p1]]",
          "text": "dump"
        },
        {
          "token": "[[p2]]",
          "text": "<em>"
        },
        {
          "token": "[[p3]]",
          "text": "EVENTLOG"
        },
        {
          "token": "[[p4]]",
          "text": "</em>"
        },
        {
          "token": "[[p5]]",
          "text": "<em>"
        },
        {
          "token": "[[p6]]",
          "text": "RECORD_NUMBER"
        },
        {
          "token": "[[p7]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0020",
      "kind": "paragraph",
      "text": "The [[p0]] reads event log records from a EVENTLOG tdb and dumps them to standard output on screen.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-o dump"
        }
      ]
    },
    {
      "id": "s0021",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-h"
        }
      ]
    },
    {
      "id": "s0022",
      "kind": "paragraph",
      "text": "Print usage information.",
      "protected": []
    },
    {
      "id": "s0023",
      "kind": "heading",
      "text": "EVENTLOG RECORD FORMAT",
      "protected": []
    },
    {
      "id": "s0024",
      "kind": "paragraph",
      "text": "For the write operation, [[p0]] expects to be able to read structured records from standard input. These records are a sequence of lines, with the record key and data separated by a colon character. Records are separated by at least one or more blank line.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "eventlogadm"
        }
      ]
    },
    {
      "id": "s0025",
      "kind": "paragraph",
      "text": "The event log record field are:",
      "protected": []
    },
    {
      "id": "s0026",
      "kind": "paragraph",
      "text": "[[p0]] - This field should be 0, since [[p1]] will calculate this value.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "LEN"
        },
        {
          "token": "[[p1]]",
          "text": "eventlogadm"
        }
      ]
    },
    {
      "id": "s0027",
      "kind": "paragraph",
      "text": "[[p0]] - This must be the value 1699505740.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "RS1"
        }
      ]
    },
    {
      "id": "s0028",
      "kind": "paragraph",
      "text": "[[p0]] - This field should be 0.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "RCN"
        }
      ]
    },
    {
      "id": "s0029",
      "kind": "paragraph",
      "text": "[[p0]] - The time the eventlog record was generated; format is the number of seconds since 00:00:00 January 1, 1970, UTC.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "TMG"
        }
      ]
    },
    {
      "id": "s0030",
      "kind": "paragraph",
      "text": "[[p0]] - The time the eventlog record was written; format is the number of seconds since 00:00:00 January 1, 1970, UTC.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "TMW"
        }
      ]
    },
    {
      "id": "s0031",
      "kind": "paragraph",
      "text": "[[p0]] - The eventlog ID.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "EID"
        }
      ]
    },
    {
      "id": "s0032",
      "kind": "paragraph",
      "text": "[[p0]] - The event type -- one of \"INFO\", \"ERROR\", \"WARNING\", \"AUDIT SUCCESS\" or \"AUDIT FAILURE\".",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "ETP"
        }
      ]
    },
    {
      "id": "s0033",
      "kind": "paragraph",
      "text": "[[p0]] - The event category; this depends on the message file. It is primarily used as a means of filtering in the eventlog viewer.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "ECT"
        }
      ]
    },
    {
      "id": "s0034",
      "kind": "paragraph",
      "text": "[[p0]] - This field should be 0.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "RS2"
        }
      ]
    },
    {
      "id": "s0035",
      "kind": "paragraph",
      "text": "[[p0]] - This field should be 0.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "CRN"
        }
      ]
    },
    {
      "id": "s0036",
      "kind": "paragraph",
      "text": "[[p0]] - This field should be 0.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "USL"
        }
      ]
    },
    {
      "id": "s0037",
      "kind": "paragraph",
      "text": "[[p0]] - This field contains the source name associated with the event log. If a message file is used with an event log, there will be a registry entry for associating this source name with a message file DLL.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "SRC"
        }
      ]
    },
    {
      "id": "s0038",
      "kind": "paragraph",
      "text": "[[p0]] - The name of the machine on which the eventlog was generated. This is typically the host name.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "SRN"
        }
      ]
    },
    {
      "id": "s0039",
      "kind": "paragraph",
      "text": "[[p0]] - The text associated with the eventlog. There may be more than one string in a record.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "STR"
        }
      ]
    },
    {
      "id": "s0040",
      "kind": "paragraph",
      "text": "[[p0]] - This field should be left unset.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "DAT"
        }
      ]
    },
    {
      "id": "s0041",
      "kind": "heading",
      "text": "EXAMPLES",
      "protected": []
    },
    {
