  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "nmbd — NetBIOS name server to provide NetBIOS over IP naming services to clients",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]] [[[p1]]|[[p2]]] [[[p3]]|[[p4]]] [[[p5]]|[[p6]]] [[[p7]]] [[[p8]]|[[p9]]] [[[p10]] <port number(s)>] [[[p11]] <profiling level>] [[[p12]] <debug level>] [[[p13]]] [[[p14]]=<configuration file>] [[[p15]]=<name>=<value>] [[[p16]]|[[p17]] <log directory>] [[[p18]]] [[[p19]]] [[[p20]]|[[p21]]]",
      "protected": [
