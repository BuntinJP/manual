  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "vfs_io_uring — Implement async io in Samba vfs using io_uring of Linux (>= 5.1).",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "vfs objects = io_uring"
          }
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This VFS module is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "samba(7)",
            "href": "https://www.samba.org/samba/docs/current/man-html/samba.7.html"
          }
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "The [[p0]] VFS module enables asynchronous pread, pwrite and fsync using the io_uring infrastructure of Linux (>= 5.1). This provides much less overhead compared to the usage of the pthreadpool for async io.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "io_uring"
          }
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "This module SHOULD be listed last in any module stack as it requires real kernel file descriptors.",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "heading",
      "text": "EXAMPLES",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "Straight forward use:",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "term",
      "text": "io_uring:num_entries = NUMBER_OF_QUEUE_ENTRIES",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "paragraph",
      "text": "The number of entries in the submission queue. The maximum allowed value depends on the kernel version and the kernel will roundup the value to a power of 2.",
      "protected": []
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "The default is '128'.",
      "protected": []
    },
    {
      "id": "s0015",
      "kind": "term",
      "text": "io_uring:sqpoll = BOOL",
      "protected": []
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "Use the IORING_SETUP_SQPOLL feature.",
      "protected": []
    },
    {
      "id": "s0017",
      "kind": "paragraph",
      "text": "The default is 'no'.",
      "protected": []
    },
    {
      "id": "s0018",
      "kind": "heading",
      "text": "SEE ALSO",
      "protected": []
    },
    {
      "id": "s0019",
      "kind": "paragraph",
      "text": "[[p0]].",
      "protected": [
        {
          "token": "[[p0]]",
