    {
      "type": "paragraph",
      "segment": "s0013"
    },
    {
      "type": "literal",
      "text": "\t\t[share]\n\t\tvfs objects = ceph_new\n\t\tpath = /non-mounted/cephfs/path\n\t\tkernel share modes = no"
    },
