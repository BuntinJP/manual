    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "vfs_fake_perms — enable read only Roaming Profiles",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
