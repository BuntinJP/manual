    {
      "type": "heading",
      "level": 3,
      "anchor": "SMB-URLS",
      "segment": "s0011"
    },
    {
      "type": "paragraph",
      "segment": "s0012"
    },
    {
      "type": "literal",
      "text": "smb://[[[domain;]user[:password@]]server[/share[/path[/file]]]]"
    },
    {
      "type": "literal",
      "text": "smb:// means all the workgroups"
    },
    {
      "type": "literal",
      "text": "smb://name/ means, if name is a workgroup, all the servers in this workgroup, or if name is a server, all the shares on this server."
    },
    {
      "type": "heading",
      "level": 3,
      "anchor": "EXAMPLES",
      "segment": "s0013"
    },
    {
      "type": "literal",
      "text": "# Recursively download 'src' directory\nsmbget --recursive smb://rhonwyn/jelmer/src\n# Download FreeBSD ISO and enable resuming\nsmbget --resume smb://rhonwyn/isos/FreeBSD5.1.iso\n# Recursively download all ISOs\nsmbget --recursive --resume smb://rhonwyn/isos\n# Backup my data on rhonwyn\nsmbget --recursive --resume smb://rhonwyn/"
    },
