      "kind": "heading",
      "text": "SMB URLS",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "SMB URL's should be specified in the following format:",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "heading",
      "text": "EXAMPLES",
      "protected": []
    },
    {
      "id": "s0014",
      "kind": "heading",
      "text": "BUGS",
      "protected": []
    },
    {
      "id": "s0015",
      "kind": "paragraph",
      "text": "Permission denied is returned in some cases where the cause of the error is unknown (such as an illegally formatted smb:// url or trying to get a directory without [[p0]] turned on).",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--recursive"
          }
        }
      ]
