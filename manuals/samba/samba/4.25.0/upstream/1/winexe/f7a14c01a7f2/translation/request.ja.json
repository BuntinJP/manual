      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "winexe — Winexe is a Remote Windows-command executor",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]] [[[p1]]] [[[p2]]] [[[p3]] [DOMAIN/]USERNAME[[[p4]]ASSWORD]] [[[p5]] FILE] [[[p6]] [0|1]] [[[p7]] [0|1]] [[[p8]]|[[p9]]=DEBUGLEVEL] [[[p10]]] [[[p11]]=CONFIGFILE] [[[p12]]=name=value] [[[p13]]|[[p14]]=LOGFILEBASE] [[[p15]]] [[[p16]]] [[[p17]]|[[p18]]=NAME-RESOLVE-ORDER] [[[p19]]|[[p20]]=SOCKETOPTIONS] [[[p21]]|[[p22]]=MAXPROTOCOL] [[[p23]]|[[p24]]=NETBIOSNAME] [[[p25]]=SCOPE] [[[p26]]|[[p27]]=WORKGROUP] [[[p28]]=REALM] [[[p29]]|[[p30]]=[DOMAIN/]USERNAME%[PASSWORD]] [[[p31]]|[[p32]]] [[[p33]]=STRING] [[[p34]]] [[[p35]]|[[p36]]=FILE] [[[p37]]|[[p38]]] [[[p39]]=DN] [[[p40]]=desired|required|off] [[[p41]]=CCACHE] [[[p42]]] [[[p43]]=sign|encrypt|off] [[[p44]]|[[p45]]] [-?|[[p46]]] [[[p47]]]",
