    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This tool is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "samba(7)"
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "The [[p0]] allows remote command execution on native Windows operating systems.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "winexe"
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--uninstall"
        }
      ]
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "Uninstall winexe service after remote execution.",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--reinstall"
        }
      ]
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "Reinstall winexe service before remote execution.",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "term",
      "text": "[[p0]] [[p1]][[p2]][[p3]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--runas"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "[DOMAIN/]USERNAME[%PASSWORD]]"
        },
        {
          "token": "[[p3]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "Run as the given user (BEWARE: this password is sent in cleartext over the network!)",
      "protected": []
    },
    {
      "id": "s0015",
      "kind": "term",
      "text": "[[p0]] [[p1]][[p2]][[p3]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--runas-file"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "FILE"
        },
        {
          "token": "[[p3]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "Run as user options defined in a file.",
      "protected": []
    },
    {
      "id": "s0017",
      "kind": "term",
      "text": "[[p0]] [[p1]][[p2]][[p3]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--interactive"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "[0|1]"
        },
        {
          "token": "[[p3]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "Desktop interaction.",
      "protected": []
    },
    {
      "id": "s0019",
      "kind": "paragraph",
      "text": "There are two options:",
      "protected": []
    },
    {
      "id": "s0020",
      "kind": "paragraph",
      "text": "0 - disallow",
      "protected": []
    },
    {
      "id": "s0021",
      "kind": "paragraph",
      "text": "1 - allow. If allow, also use the [[p0]] switch (Windows requirement). Vista does not support this option.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--system"
        }
      ]
    },
    {
      "id": "s0022",
      "kind": "term",
      "text": "[[p0]] [[p1]][[p2]][[p3]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--ostype"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "[0|1|2]"
        },
        {
          "token": "[[p3]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0023",
      "kind": "paragraph",
      "text": "Determines which version (32-bit or 64-bit) of service will be installed.",
      "protected": []
    },
    {
      "id": "s0024",
      "kind": "paragraph",
      "text": "There are three options:",
      "protected": []
    },
    {
      "id": "s0025",
      "kind": "paragraph",
      "text": "0 - 32-bit",
      "protected": []
    },
    {
      "id": "s0026",
      "kind": "paragraph",
      "text": "1 - 64-bit",
      "protected": []
    },
    {
      "id": "s0027",
      "kind": "paragraph",
      "text": "2 - winexe will decide",
      "protected": []
    },
    {
      "id": "s0028",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=level",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-d"
        },
        {
          "token": "[[p1]]",
          "text": "--debuglevel"
        }
      ]
    },
    {
      "id": "s0029",
      "kind": "paragraph",
      "text": "[[p0]][[p1]][[p2]] is an integer from 0 to 10. The default value if this parameter is not specified is 1 for client applications.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "level"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0030",
      "kind": "paragraph",
      "text": "The higher this value, the more detail will be logged to the log files about the activities of the server. At level 0, only critical errors and serious warnings will be logged. Level 1 is a reasonable level for day-to-day running - it generates a small amount of information about operations carried out.",
      "protected": []
    },
    {
      "id": "s0031",
      "kind": "paragraph",
      "text": "Levels above 1 will generate considerable amounts of log data, and should only be used when investigating a problem. Levels above 3 are designed for use only by developers and generate HUGE amounts of log data, most of which is extremely cryptic.",
      "protected": []
    },
    {
      "id": "s0032",
      "kind": "paragraph",
      "text": "Note that specifying this parameter here will override the [[p0]] parameter in the [[p1]] file.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "log level"
        },
        {
          "token": "[[p1]]",
          "text": "${prefix}/etc/smb.conf"
        }
      ]
    },
    {
      "id": "s0033",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--debug-stdout"
        }
      ]
    },
    {
      "id": "s0034",
      "kind": "paragraph",
      "text": "This will redirect debug output to STDOUT. By default all clients are logging to STDERR.",
      "protected": []
    },
    {
      "id": "s0035",
      "kind": "term",
      "text": "[[p0]]=<configuration file>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--configfile"
        }
      ]
    },
    {
      "id": "s0036",
      "kind": "paragraph",
      "text": "The file specified contains the configuration details required by the client. The information in this file can be general for client and server or only provide client specific like options such as [[p0]]. See [[p1]] for more information. The default configuration file name is determined at compile time.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "client smb encrypt"
        },
        {
          "token": "[[p1]]",
          "text": "${prefix}/etc/smb.conf"
        }
      ]
    },
    {
      "id": "s0037",
      "kind": "term",
      "text": "[[p0]]=<name>=<value>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--option"
        }
      ]
    },
    {
      "id": "s0038",
      "kind": "paragraph",
      "text": "Set the [[p0]] option \"<name>\" to value \"<value>\" from the command line. This overrides compiled-in defaults and options read from the configuration file. If a name or a value includes a space, wrap whole [[p1]]=name=value into quotes.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "smb.conf(5)"
        },
        {
          "token": "[[p1]]",
          "text": "--option"
        }
      ]
    },
    {
      "id": "s0039",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=logdirectory",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-l"
        },
        {
          "token": "[[p1]]",
          "text": "--log-basename"
        }
      ]
    },
    {
      "id": "s0040",
      "kind": "paragraph",
      "text": "Base directory name for log/debug files. The extension [[p0]] will be appended (e.g. log.smbclient, log.smbd, etc...). The log file is never removed by the client.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "\".progname\""
        }
      ]
    },
    {
      "id": "s0041",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--leak-report"
        }
      ]
    },
    {
      "id": "s0042",
      "kind": "paragraph",
      "text": "Enable talloc leak reporting on exit.",
      "protected": []
    },
    {
      "id": "s0043",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--leak-report-full"
        }
      ]
    },
    {
      "id": "s0044",
      "kind": "paragraph",
      "text": "Enable full talloc leak reporting on exit.",
      "protected": []
    },
    {
      "id": "s0045",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-V"
        },
        {
          "token": "[[p1]]",
          "text": "--version"
        }
      ]
    },
    {
      "id": "s0046",
      "kind": "paragraph",
      "text": "Prints the program version number.",
      "protected": []
    },
    {
      "id": "s0047",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=NAME-RESOLVE-ORDER",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-R"
        },
        {
          "token": "[[p1]]",
          "text": "--name-resolve"
        }
      ]
    },
    {
      "id": "s0048",
      "kind": "paragraph",
      "text": "This option is used to determine what naming services and in what order to resolve host names to IP addresses. The option takes a space-separated string of different name resolution options. The best is to wrap the whole [[p0]]=NAME-RESOLVE-ORDER into quotes.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--name-resolve"
        }
      ]
    },
    {
      "id": "s0049",
      "kind": "paragraph",
      "text": "The options are: \"lmhosts\", \"host\", \"wins\" and \"bcast\". They cause names to be resolved as follows:",
      "protected": []
    },
    {
      "id": "s0050",
      "kind": "paragraph",
      "text": "[[p0]]: Lookup an IP address in the Samba lmhosts file. If the line in lmhosts has no name type attached to the NetBIOS name (see the [[p1]] for details) then any name type matches for lookup.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "lmhosts"
        },
        {
          "token": "[[p1]]",
          "text": "lmhosts(5)"
        }
      ]
    },
    {
      "id": "s0051",
      "kind": "paragraph",
      "text": "[[p0]]: Do a standard host name to IP address resolution, using the system [[p1]], NIS, or DNS lookups. This method of name resolution is operating system dependent, for instance on IRIX or Solaris this may be controlled by the [[p2]] file). Note that this method is only used if the NetBIOS name type being queried is the 0x20 (server) name type, otherwise it is ignored.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "host"
        },
        {
          "token": "[[p1]]",
          "text": "/etc/hosts"
        },
        {
          "token": "[[p2]]",
          "text": "/etc/nsswitch.conf"
        }
      ]
    },
    {
      "id": "s0052",
      "kind": "paragraph",
      "text": "[[p0]]: Query a name with the IP address listed in the [[p1]][[p2]][[p3]] parameter. If no WINS server has been specified this method will be ignored.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "wins"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "wins server"
        },
        {
          "token": "[[p3]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0053",
      "kind": "paragraph",
      "text": "[[p0]]: Do a broadcast on each of the known local interfaces listed in the [[p1]][[p2]][[p3]] parameter. This is the least reliable of the name resolution methods as it depends on the target host being on a locally connected subnet.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "bcast"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "interfaces"
        },
        {
          "token": "[[p3]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0054",
      "kind": "paragraph",
      "text": "If this parameter is not set then the name resolve order defined in the [[p0]] file parameter ([[p1]]) will be used.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "${prefix}/etc/smb.conf"
        },
        {
          "token": "[[p1]]",
          "text": "name resolve order"
        }
      ]
    },
    {
      "id": "s0055",
      "kind": "paragraph",
      "text": "The default order is lmhosts, host, wins, bcast. Without this parameter or any entry in the [[p0]] parameter of the [[p1]] file, the name resolution methods will be attempted in this order.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "name resolve order"
        },
        {
          "token": "[[p1]]",
          "text": "${prefix}/etc/smb.conf"
        }
      ]
    },
    {
      "id": "s0056",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=SOCKETOPTIONS",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-O"
        },
        {
          "token": "[[p1]]",
          "text": "--socket-options"
        }
      ]
    },
    {
      "id": "s0057",
      "kind": "paragraph",
      "text": "TCP socket options to set on the client socket. See the socket options parameter in the [[p0]] manual page for the list of valid options.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "${prefix}/etc/smb.conf"
        }
      ]
    },
    {
      "id": "s0058",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=MAXPROTOCOL",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-m"
        },
        {
          "token": "[[p1]]",
          "text": "--max-protocol"
        }
      ]
    },
    {
      "id": "s0059",
      "kind": "paragraph",
      "text": "The value of the parameter (a string) is the highest protocol level that will be supported by the client.",
      "protected": []
    },
    {
      "id": "s0060",
      "kind": "paragraph",
      "text": "Note that specifying this parameter here will override the [[p0]] parameter in the [[p1]] file.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "client max protocol"
        },
        {
          "token": "[[p1]]",
          "text": "${prefix}/etc/smb.conf"
        }
      ]
    },
    {
      "id": "s0061",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=NETBIOSNAME",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-n"
        },
        {
          "token": "[[p1]]",
          "text": "--netbiosname"
        }
      ]
    },
    {
      "id": "s0062",
      "kind": "paragraph",
      "text": "This option allows you to override the NetBIOS name that Samba uses for itself. This is identical to setting the [[p0]] parameter in the [[p1]] file. However, a command line setting will take precedence over settings in [[p2]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "netbios name"
        },
        {
          "token": "[[p1]]",
          "text": "${prefix}/etc/smb.conf"
        },
        {
          "token": "[[p2]]",
          "text": "${prefix}/etc/smb.conf"
        }
      ]
    },
    {
      "id": "s0063",
      "kind": "term",
      "text": "[[p0]]=SCOPE",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--netbios-scope"
        }
      ]
    },
    {
      "id": "s0064",
      "kind": "paragraph",
      "text": "This specifies a NetBIOS scope that [[p0]] will use to communicate with when generating NetBIOS names. For details on the use of NetBIOS scopes, see rfc1001.txt and rfc1002.txt. NetBIOS scopes are [[p1]]very[[p2]] rarely used, only set this parameter if you are the system administrator in charge of all the NetBIOS systems you communicate with.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "nmblookup"
        },
        {
          "token": "[[p1]]",
          "text": "<em>"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0065",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=WORKGROUP",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-W"
        },
        {
          "token": "[[p1]]",
          "text": "--workgroup"
        }
      ]
    },
    {
      "id": "s0066",
      "kind": "paragraph",
      "text": "Set the SMB domain of the username. This overrides the default domain which is the domain defined in smb.conf. If the domain specified is the same as the servers NetBIOS name, it causes the client to log on using the servers local SAM (as opposed to the Domain SAM).",
      "protected": []
    },
    {
      "id": "s0067",
      "kind": "paragraph",
      "text": "Note that specifying this parameter here will override the [[p0]] parameter in the [[p1]] file.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "workgroup"
        },
        {
          "token": "[[p1]]",
          "text": "${prefix}/etc/smb.conf"
        }
      ]
    },
    {
      "id": "s0068",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=REALM",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-r"
        },
        {
          "token": "[[p1]]",
          "text": "--realm"
        }
      ]
    },
    {
      "id": "s0069",
      "kind": "paragraph",
      "text": "Set the realm for the domain.",
      "protected": []
    },
    {
      "id": "s0070",
      "kind": "paragraph",
      "text": "Note that specifying this parameter here will override the [[p0]] parameter in the [[p1]] file.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "realm"
        },
        {
          "token": "[[p1]]",
          "text": "${prefix}/etc/smb.conf"
        }
      ]
    },
    {
      "id": "s0071",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=[DOMAIN\\]USERNAME[[[p2]]ASSWORD]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-U"
        },
        {
          "token": "[[p1]]",
          "text": "--user"
        },
        {
          "token": "[[p2]]",
          "text": "%P"
        }
      ]
    },
    {
      "id": "s0072",
      "kind": "paragraph",
      "text": "Sets the SMB username or username and password.",
      "protected": []
    },
    {
      "id": "s0073",
      "kind": "paragraph",
      "text": "If [[p0]]ASSWORD is not specified, the user will be prompted. The client will first check the [[p1]] environment variable (which is also permitted to also contain the password separated by a %), then the [[p2]] variable (which is not permitted to contain a password) and if either exists, the value is used. If these environmental variables are not found, the username found in a Kerberos Credentials cache may be used.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "%P"
        },
        {
          "token": "[[p1]]",
          "text": "USER"
        },
        {
          "token": "[[p2]]",
          "text": "LOGNAME"
        }
      ]
    },
    {
      "id": "s0074",
      "kind": "paragraph",
      "text": "A third option is to use a credentials file which contains the plaintext of the username and password. This option is mainly provided for scripts where the admin does not wish to pass the credentials on the command line or via environment variables. If this method is used, make certain that the permissions on the file restrict access from unwanted users. See the [[p0]][[p1]][[p2]] for more details.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "-A"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0075",
      "kind": "paragraph",
      "text": "Be cautious about including passwords in scripts or passing user-supplied values onto the command line. For security it is better to let the Samba client tool ask for the password if needed, or obtain the password once with [[p0]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "kinit"
        }
      ]
    },
    {
      "id": "s0076",
      "kind": "paragraph",
      "text": "While Samba will attempt to scrub the password from the process title (as seen in ps), this is after startup and so is subject to a race.",
      "protected": []
    },
    {
      "id": "s0077",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-N"
        },
        {
          "token": "[[p1]]",
          "text": "--no-pass"
        }
      ]
    },
    {
      "id": "s0078",
      "kind": "paragraph",
      "text": "If specified, this parameter suppresses the normal password prompt from the client to the user. This is useful when accessing a service that does not require a password.",
      "protected": []
    },
    {
      "id": "s0079",
      "kind": "paragraph",
      "text": "Unless a password is specified on the command line or this parameter is specified, the client will request a password.",
      "protected": []
    },
    {
      "id": "s0080",
      "kind": "paragraph",
      "text": "If a password is specified on the command line and this option is also defined the password on the command line will be silently ignored and no password will be used.",
      "protected": []
    },
    {
      "id": "s0081",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--password"
        }
      ]
    },
    {
      "id": "s0082",
      "kind": "paragraph",
      "text": "Specify the password on the commandline.",
      "protected": []
    },
    {
      "id": "s0083",
      "kind": "paragraph",
      "text": "Be cautious about including passwords in scripts or passing user-supplied values onto the command line. For security it is better to let the Samba client tool ask for the password if needed, or obtain the password once with [[p0]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "kinit"
        }
      ]
    },
    {
      "id": "s0084",
      "kind": "paragraph",
      "text": "If [[p0]] is not specified, the tool will check the [[p1]] environment variable, followed by [[p2]] which is expected to contain an open file descriptor (FD) number.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--password"
        },
        {
          "token": "[[p1]]",
          "text": "PASSWD"
        },
        {
          "token": "[[p2]]",
          "text": "PASSWD_FD"
        }
      ]
    },
    {
      "id": "s0085",
      "kind": "paragraph",
      "text": "Finally it will check [[p0]] (containing a file path to be opened). The file should only contain the password. Make certain that the permissions on the file restrict access from unwanted users!",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "PASSWD_FILE"
        }
      ]
    },
    {
      "id": "s0086",
      "kind": "paragraph",
      "text": "While Samba will attempt to scrub the password from the process title (as seen in ps), this is after startup and so is subject to a race.",
      "protected": []
    },
    {
      "id": "s0087",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--pw-nt-hash"
        }
      ]
    },
    {
      "id": "s0088",
      "kind": "paragraph",
      "text": "The supplied password is the NT hash.",
      "protected": []
    },
    {
      "id": "s0089",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=filename",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-A"
        },
        {
          "token": "[[p1]]",
          "text": "--authentication-file"
        }
      ]
    },
    {
      "id": "s0090",
      "kind": "paragraph",
      "text": "This option allows you to specify a file from which to read the username and password used in the connection. The format of the file is:",
      "protected": []
    },
    {
      "id": "s0091",
      "kind": "paragraph",
      "text": "Make certain that the permissions on the file restrict access from unwanted users!",
      "protected": []
    },
    {
      "id": "s0092",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-P"
        },
        {
          "token": "[[p1]]",
          "text": "--machine-pass"
        }
      ]
    },
    {
      "id": "s0093",
      "kind": "paragraph",
      "text": "Use stored machine account password.",
      "protected": []
    },
    {
      "id": "s0094",
      "kind": "term",
      "text": "[[p0]]=DN",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--simple-bind-dn"
        }
      ]
    },
    {
      "id": "s0095",
      "kind": "paragraph",
      "text": "DN to use for a simple bind.",
      "protected": []
    },
    {
      "id": "s0096",
      "kind": "term",
      "text": "[[p0]]=desired|required|off",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--use-kerberos"
        }
      ]
    },
    {
      "id": "s0097",
      "kind": "paragraph",
      "text": "This parameter determines whether Samba client tools will try to authenticate using Kerberos. For Kerberos authentication you should use DNS names instead of IP addresses when connecting to a service. By default Samba client tools will try to use the default Kerberos credential cache (ccache). In case the ccache does not exist or [[p0]]|[[p1]] option was specified, clients will ask to enter a password and will obtain a Kerberos ticket (kinit) for you. If you want to use an alternative Kerberos credentical cache, use the [[p2]] option.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-U"
        },
        {
          "token": "[[p1]]",
          "text": "--user"
        },
        {
          "token": "[[p2]]",
          "text": "--use-krb5-ccache"
        }
      ]
    },
    {
      "id": "s0098",
      "kind": "paragraph",
      "text": "Note that specifying this parameter here will override the [[p0]] parameter in the [[p1]] file.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "client use kerberos"
        },
        {
          "token": "[[p1]]",
          "text": "${prefix}/etc/smb.conf"
        }
      ]
    },
    {
      "id": "s0099",
      "kind": "term",
      "text": "[[p0]]=CCACHE",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--use-krb5-ccache"
        }
      ]
    },
    {
      "id": "s0100",
      "kind": "paragraph",
      "text": "Specifies the credential cache location for Kerberos authentication.",
      "protected": []
    },
    {
      "id": "s0101",
      "kind": "paragraph",
      "text": "This will enforce [[p0]]=required.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--use-kerberos"
        }
      ]
    },
    {
      "id": "s0102",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--use-winbind-ccache"
        }
      ]
    },
    {
      "id": "s0103",
      "kind": "paragraph",
      "text": "Try to use the credential cache by winbind.",
      "protected": []
    },
    {
      "id": "s0104",
      "kind": "term",
      "text": "[[p0]]=sign|encrypt|off",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--client-protection"
        }
      ]
    },
    {
      "id": "s0105",
      "kind": "paragraph",
      "text": "Sets the connection protection the client tool should use.",
      "protected": []
    },
    {
      "id": "s0106",
      "kind": "paragraph",
      "text": "Note that specifying this parameter here will override the [[p0]] parameter in the [[p1]] file.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "client protection"
        },
        {
          "token": "[[p1]]",
          "text": "${prefix}/etc/smb.conf"
        }
      ]
    },
    {
      "id": "s0107",
      "kind": "paragraph",
      "text": "In case you need more fine grained control you can use: [[p0]], [[p1]], [[p2]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--option=clientsmbencrypt=OPTION"
        },
        {
          "token": "[[p1]]",
          "text": "--option=clientipcsigning=OPTION"
        },
        {
          "token": "[[p2]]",
          "text": "--option=clientsigning=OPTION"
        }
      ]
    },
    {
      "id": "s0108",
      "kind": "term",
      "text": "-?|[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--help"
        }
      ]
    },
    {
      "id": "s0109",
      "kind": "paragraph",
      "text": "Print a summary of command line options.",
      "protected": []
    },
    {
      "id": "s0110",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--usage"
        }
      ]
    },
    {
      "id": "s0111",
      "kind": "paragraph",
      "text": "Display brief usage message.",
      "protected": []
    },
    {
      "id": "s0112",
      "kind": "heading",
      "text": "EXIT STATUS",
      "protected": []
    },
    {
      "id": "s0113",
      "kind": "paragraph",
      "text": "The winexe program returns 0 if the operation succeeded, or 1 if the operation failed.",
      "protected": []
    },
    {
      "id": "s0114",
      "kind": "heading",
      "text": "VERSION",
      "protected": []
    },
    {
      "id": "s0115",
      "kind": "paragraph",
      "text": "This man page is part of version 4.25.0 of the Samba suite.",
      "protected": []
    },
    {
      "id": "s0116",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0117",
      "kind": "paragraph",
      "text": "The original Samba software and related utilities were created by Andrew Tridgell. Samba is now developed by the Samba Team as an Open Source project similar to the way the Linux kernel is developed.",
      "protected": []
    },
    {
      "id": "s0118",
      "kind": "paragraph",
      "text": "The [[p0]] and it's native Windows counterpart were written by Andrzej Hajda. The Samba client tool winexe was later rewritten by Volker Lendecke.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "winexe"
        }
      ]
    },
    {
      "id": "s0119",
      "kind": "paragraph",
      "text": "This manpage was written by Guenther Deschner.",
      "protected": []
    }
  ]
}
