            "text": "--flow-compact"
          }
        }
      ]
    },
    {
      "id": "s0004",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0005",
      "kind": "paragraph",
      "text": "[[p0]] {path} [[[p1]]=PID] [[[p2]]=ID] [[[p3]]] [[[p4]]] [[[p5]]] [[[p6]]] [[[p7]]|[[p8]]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
