    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "samba-log-parser — Samba (winbind) trace parser.",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "paragraph",
      "text": "options: [[p0]], [[p1]] show this help message and exit [[p2]] ID specify the traceid of the trace records [[p3]] PID specify the pid of winbind client [[p4]] breakdown the traces into per traceid files [[p5]] merge logs by timestamp [[p6]] show the request/sub-request flow traces [[p7]] show the request/sub-request flow traces without dcerpc details",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-h"
          }
        },
        {
          "token": "[[p1]]",
