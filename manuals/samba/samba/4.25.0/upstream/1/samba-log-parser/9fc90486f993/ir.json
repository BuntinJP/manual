    {
      "id": "s0006",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "This tool is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "samba(7)",
            "href": "https://www.samba.org/samba/docs/current/man-html/samba.7.html"
          }
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "The [[p0]] program parses samba winbind logs.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "samba-log-parser"
          }
        }
      ]
    },
    {
      "id": "s0009",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "The following options are available to the [[p0]] program.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "samba-log-parser"
          }
        }
      ]
    },
    {
      "id": "s0011",
      "kind": "term",
      "text": "[[p0]]=PID",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--pid"
          }
        }
      ]
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "Display traces for winbind client with the matching PID.",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "term",
      "text": "[[p0]]=ID",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--traceid"
          }
        }
      ]
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "Display traces with matching traceid debug header field.",
      "protected": []
    },
    {
      "id": "s0015",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--breakdown"
          }
        }
      ]
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "Break down all traces to separate files in the current working directory. For each traceid, three files are created: traceid.full traceid.flow traceid.flowcompact",
      "protected": []
    },
    {
      "id": "s0017",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--merge-by-timestamp"
          }
        }
      ]
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "Sort the trace lines according to the timestamp. Works with log files without traceid header field as well.",
      "protected": []
    },
    {
      "id": "s0019",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--flow"
          }
        }
      ]
    },
    {
      "id": "s0020",
      "kind": "paragraph",
      "text": "Display the request/sub-request flow.",
      "protected": []
    },
    {
      "id": "s0021",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--flow-compact"
          }
        }
      ]
    },
    {
      "id": "s0022",
      "kind": "paragraph",
      "text": "Display the request/sub-request flow without dcerpc call details.",
      "protected": []
    },
    {
      "id": "s0023",
      "kind": "heading",
      "text": "EXAMPLES",
      "protected": []
    },
    {
      "id": "s0024",
      "kind": "paragraph",
      "text": "Show the flow traces for trace id [[p0]][[p1]][[p2]] from log file log.winbind:",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "1234"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        }
      ]
    },
    {
      "id": "s0025",
      "kind": "paragraph",
      "text": "Show the full traces for winbind client with PID [[p0]][[p1]][[p2]] sorted using the timestamp for log files found in the samba log directory:",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "999999"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        }
      ]
    },
    {
      "id": "s0026",
      "kind": "paragraph",
      "text": "Break down the traces into separate files according to traceid sorted using the timestamp for log files found in the samba log directory:",
      "protected": []
    },
    {
      "id": "s0027",
      "kind": "paragraph",
      "text": "Sort traces using the timestamp for log files found in the samba log directory. Traces do not need to contain the traceid header field.",
      "protected": []
    },
    {
      "id": "s0028",
      "kind": "heading",
      "text": "VERSION",
      "protected": []
    },
    {
      "id": "s0029",
      "kind": "paragraph",
      "text": "This man page is part of version 4.25.0 of the Samba suite.",
      "protected": []
    },
    {
      "id": "s0030",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0031",
      "kind": "paragraph",
      "text": "The original Samba software and related utilities were created by Andrew Tridgell. Samba is now developed by the Samba Team as an Open Source project similar to the way the Linux kernel is developed.",
      "protected": []
    }
  ],
