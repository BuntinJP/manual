    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "samba-log-parser — Samba (winbind) trace parser.",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "paragraph",
      "text": "options: [[p0]], [[p1]] show this help message and exit [[p2]] ID specify the traceid of the trace records [[p3]] PID specify the pid of winbind client [[p4]] breakdown the traces into per traceid files [[p5]] merge logs by timestamp [[p6]] show the request/sub-request flow traces [[p7]] show the request/sub-request flow traces without dcerpc details",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-h"
        },
        {
          "token": "[[p1]]",
          "text": "--help"
        },
        {
          "token": "[[p2]]",
          "text": "--traceid"
        },
        {
          "token": "[[p3]]",
          "text": "--pid"
        },
        {
          "token": "[[p4]]",
          "text": "--breakdown"
        },
        {
          "token": "[[p5]]",
          "text": "--merge-by-timestamp"
        },
        {
          "token": "[[p6]]",
          "text": "--flow"
        },
        {
          "token": "[[p7]]",
          "text": "--flow-compact"
        }
      ]
    },
    {
      "id": "s0004",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0005",
      "kind": "paragraph",
      "text": "[[p0]] {path} [[[p1]]=PID] [[[p2]]=ID] [[[p3]]] [[[p4]]] [[[p5]]] [[[p6]]] [[[p7]]|[[p8]]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "samba-log-parser"
        },
        {
          "token": "[[p1]]",
          "text": "--pid"
        },
        {
          "token": "[[p2]]",
          "text": "--traceid"
        },
        {
          "token": "[[p3]]",
          "text": "--breakdown"
        },
        {
          "token": "[[p4]]",
          "text": "--merge-by-timestamp"
        },
        {
          "token": "[[p5]]",
          "text": "--flow"
        },
        {
