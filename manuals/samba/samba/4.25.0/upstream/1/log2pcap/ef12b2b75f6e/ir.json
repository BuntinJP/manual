      "segment": "s0020"
    },
    {
      "type": "paragraph",
      "segment": "s0021"
    },
    {
      "type": "literal",
      "text": "\t\t\t$ log2pcap < /var/log/* > trace.pcap"
    },
    {
      "type": "paragraph",
      "segment": "s0022"
    },
    {
      "type": "literal",
      "text": "\t$ log2pcap -h samba.log | text2pcap -T 139,139 - trace.pcap"
