  },
  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "log2pcap — Extract network traces from Samba log files",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]] [[[p1]]] [[[p2]]] [logfile] [pcap_file]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "log2pcap"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "-h"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "code",
            "text": "-q"
          }
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This tool is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "samba(7)",
            "href": "https://www.samba.org/samba/docs/current/man-html/samba.7.html"
          }
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "[[p0]] reads in a samba log file and generates a pcap file (readable by most sniffers, such as ethereal or tcpdump) based on the packet dumps in the log file.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "log2pcap"
          }
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "The log file must have a [[p0]][[p1]][[p2]] of at least [[p3]] to get the SMB header/parameters right, [[p4]] to get the first 512 data bytes of the packet and [[p5]] to get the whole packet.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "log level"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        },
        {
          "token": "[[p3]]",
          "inline": {
            "tag": "code",
            "text": "5"
          }
        },
        {
          "token": "[[p4]]",
          "inline": {
            "tag": "code",
            "text": "10"
          }
        },
        {
          "token": "[[p5]]",
          "inline": {
            "tag": "code",
            "text": "50"
          }
        }
      ]
    },
    {
      "id": "s0009",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-h"
          }
        }
      ]
    },
    {
      "id": "s0011",
      "kind": "paragraph",
      "text": "If this parameter is specified the output file will be a hex dump, in a format that is readable by the text2pcap utility.",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-q"
          }
        }
      ]
    },
    {
      "id": "s0013",
      "kind": "paragraph",
      "text": "Be quiet. No warning messages about missing or incomplete data will be given.",
      "protected": []
    },
    {
      "id": "s0014",
      "kind": "term",
      "text": "logfile",
      "protected": []
    },
    {
      "id": "s0015",
      "kind": "paragraph",
      "text": "Samba log file. log2pcap will try to read the log from stdin if the log file is not specified.",
      "protected": []
    },
    {
      "id": "s0016",
      "kind": "term",
      "text": "pcap_file",
      "protected": []
    },
    {
      "id": "s0017",
      "kind": "paragraph",
      "text": "Name of the output file to write the pcap (or hexdump) data to. If this argument is not specified, output data will be written to stdout.",
      "protected": []
    },
    {
      "id": "s0018",
      "kind": "term",
      "text": "-?|[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--help"
          }
        }
      ]
    },
    {
      "id": "s0019",
      "kind": "paragraph",
      "text": "Print a summary of command line options.",
      "protected": []
    },
    {
      "id": "s0020",
      "kind": "heading",
      "text": "EXAMPLES",
      "protected": []
    },
    {
      "id": "s0021",
      "kind": "paragraph",
      "text": "Extract all network traffic from all samba log files:",
      "protected": []
    },
    {
      "id": "s0022",
      "kind": "paragraph",
      "text": "Convert to pcap using text2pcap:",
      "protected": []
    },
    {
      "id": "s0023",
      "kind": "heading",
      "text": "VERSION",
      "protected": []
    },
    {
      "id": "s0024",
      "kind": "paragraph",
      "text": "This man page is part of version 4.25.0 of the Samba suite.",
      "protected": []
    },
    {
      "id": "s0025",
      "kind": "heading",
      "text": "BUGS",
      "protected": []
    },
    {
      "id": "s0026",
      "kind": "paragraph",
      "text": "Only SMB data is extracted from the samba logs, no LDAP, NetBIOS lookup or other data.",
      "protected": []
    },
    {
      "id": "s0027",
      "kind": "paragraph",
      "text": "The generated TCP and IP headers don't contain a valid checksum.",
      "protected": []
    },
    {
      "id": "s0028",
      "kind": "heading",
      "text": "SEE ALSO",
      "protected": []
    },
    {
      "id": "s0029",
      "kind": "paragraph",
      "text": "[[p0]], [[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "text2pcap(1)",
            "href": "https://www.samba.org/samba/docs/current/man-html/text2pcap.1.html"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "link",
            "text": "ethereal(1)",
            "href": "https://www.samba.org/samba/docs/current/man-html/ethereal.1.html"
          }
        }
      ]
    },
    {
      "id": "s0030",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0031",
      "kind": "paragraph",
      "text": "The original Samba software and related utilities were created by Andrew Tridgell. Samba is now developed by the Samba Team as an Open Source project similar to the way the Linux kernel is developed.",
      "protected": []
    },
    {
      "id": "s0032",
      "kind": "paragraph",
      "text": "This manpage was written by Jelmer Vernooij.",
      "protected": []
    }
  ],
