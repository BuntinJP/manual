            "text": "-x"
          }
        },
        {
          "token": "[[p8]]",
          "inline": {
            "tag": "code",
            "text": "-X"
          }
        },
        {
          "token": "[[p9]]",
          "inline": {
            "tag": "code",
            "text": "-N"
          }
        },
        {
          "token": "[[p10]]",
