  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "smbtar — shell script for backing up SMB/CIFS shares directly to UNIX tape drives",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]] [[[p1]]] [[[p2]]] [[[p3]]] [[[p4]]] {[[p5]] server} [[[p6]] password] [[[p7]] services] [[[p8]]] [[[p9]] filename] [[[p10]] blocksize] [[[p11]] directory] [[[p12]] loglevel] [[[p13]] user] [[[p14]] tape] {filenames}",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "smbtar"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "-r"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
