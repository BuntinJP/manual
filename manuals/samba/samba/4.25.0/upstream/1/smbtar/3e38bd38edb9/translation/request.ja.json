  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "smbtar — shell script for backing up SMB/CIFS shares directly to UNIX tape drives",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]] [[[p1]]] [[[p2]]] [[[p3]]] [[[p4]]] {[[p5]] server} [[[p6]] password] [[[p7]] services] [[[p8]]] [[[p9]] filename] [[[p10]] blocksize] [[[p11]] directory] [[[p12]] loglevel] [[[p13]] user] [[[p14]] tape] {filenames}",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "smbtar"
        },
        {
          "token": "[[p1]]",
          "text": "-r"
        },
        {
          "token": "[[p2]]",
          "text": "-i"
        },
        {
          "token": "[[p3]]",
          "text": "-a"
        },
        {
          "token": "[[p4]]",
          "text": "-v"
        },
        {
          "token": "[[p5]]",
          "text": "-s"
        },
        {
          "token": "[[p6]]",
          "text": "-p"
        },
        {
          "token": "[[p7]]",
          "text": "-x"
        },
        {
          "token": "[[p8]]",
          "text": "-X"
        },
        {
          "token": "[[p9]]",
          "text": "-N"
        },
        {
          "token": "[[p10]]",
          "text": "-b"
        },
        {
          "token": "[[p11]]",
          "text": "-d"
        },
        {
          "token": "[[p12]]",
          "text": "-l"
        },
        {
          "token": "[[p13]]",
          "text": "-u"
        },
        {
          "token": "[[p14]]",
          "text": "-t"
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This tool is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "samba(7)"
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "[[p0]] is a very small shell script on top of [[p1]] which dumps SMB shares directly to tape.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "smbtar"
        },
        {
          "token": "[[p1]]",
          "text": "smbclient(1)"
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "term",
      "text": "[[p0]] server",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-s"
        }
      ]
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "The SMB/CIFS server that the share resides upon.",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "term",
      "text": "[[p0]] service",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-x"
        }
      ]
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "The share name on the server to connect to. The default is \"backup\".",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-X"
        }
      ]
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "Exclude mode. Exclude filenames... from tar create or restore.",
      "protected": []
    },
    {
      "id": "s0015",
      "kind": "term",
      "text": "[[p0]] directory",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-d"
        }
      ]
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "Change to initial [[p0]][[p1]][[p2]] before restoring / backing up files.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "directory"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0017",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-v"
        }
      ]
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "Verbose mode.",
      "protected": []
    },
    {
      "id": "s0019",
      "kind": "term",
      "text": "[[p0]] password",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-p"
        }
      ]
    },
    {
      "id": "s0020",
      "kind": "paragraph",
      "text": "The password to use to access a share. Default: none",
      "protected": []
    },
    {
      "id": "s0021",
      "kind": "term",
      "text": "[[p0]] user",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-u"
        }
      ]
    },
    {
      "id": "s0022",
      "kind": "paragraph",
      "text": "The user id to connect as. Default: UNIX login name.",
      "protected": []
    },
    {
      "id": "s0023",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-a"
        }
      ]
    },
    {
      "id": "s0024",
      "kind": "paragraph",
      "text": "Reset DOS archive bit mode to indicate file has been archived.",
      "protected": []
    },
    {
      "id": "s0025",
      "kind": "term",
      "text": "[[p0]] tape",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-t"
        }
      ]
    },
    {
      "id": "s0026",
      "kind": "paragraph",
      "text": "Tape device. May be regular file or tape device. Default: [[p0]][[p1]][[p2]] environmental variable; if not set, a file called [[p3]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "$TAPE"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        },
        {
          "token": "[[p3]]",
          "text": "tar.out"
        }
      ]
    },
    {
      "id": "s0027",
      "kind": "term",
      "text": "[[p0]] blocksize",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-b"
        }
      ]
    },
    {
      "id": "s0028",
      "kind": "paragraph",
      "text": "Blocking factor. Defaults to 20. See [[p0]] for a fuller explanation.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "tar(1)"
        }
      ]
    },
    {
      "id": "s0029",
      "kind": "term",
      "text": "[[p0]] filename",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-N"
        }
      ]
    },
    {
      "id": "s0030",
      "kind": "paragraph",
      "text": "Backup only files newer than filename. Could be used (for example) on a log file to implement incremental backups.",
      "protected": []
    },
    {
      "id": "s0031",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-i"
        }
      ]
    },
    {
      "id": "s0032",
      "kind": "paragraph",
      "text": "Incremental mode; tar files are only backed up if they have the archive bit set. The archive bit is reset after each file is read.",
      "protected": []
    },
    {
      "id": "s0033",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-r"
        }
      ]
    },
    {
      "id": "s0034",
      "kind": "paragraph",
      "text": "Restore. Files are restored to the share from the tar file.",
      "protected": []
    },
    {
      "id": "s0035",
      "kind": "term",
      "text": "[[p0]] log level",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-l"
        }
      ]
    },
    {
      "id": "s0036",
      "kind": "paragraph",
      "text": "Log (debug) level. Corresponds to the [[p0]][[p1]][[p2]] flag of [[p3]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "-d"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        },
        {
          "token": "[[p3]]",
          "text": "smbclient(1)"
        }
      ]
    },
    {
      "id": "s0037",
      "kind": "heading",
      "text": "ENVIRONMENT VARIABLES",
      "protected": []
    },
    {
      "id": "s0038",
      "kind": "paragraph",
      "text": "The [[p0]][[p1]][[p2]] variable specifies the default tape device to write to. May be overridden with the [[p3]] option.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "$TAPE"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        },
        {
          "token": "[[p3]]",
          "text": "-t"
        }
      ]
    },
    {
      "id": "s0039",
      "kind": "heading",
      "text": "BUGS",
      "protected": []
    },
    {
      "id": "s0040",
      "kind": "paragraph",
      "text": "The [[p0]] script has different options from ordinary tar and from smbclient's tar command.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "smbtar"
        }
      ]
    },
    {
      "id": "s0041",
      "kind": "heading",
      "text": "CAVEATS",
      "protected": []
    },
    {
      "id": "s0042",
      "kind": "paragraph",
      "text": "Sites that are more careful about security may not like the way the script handles PC passwords. Backup and restore work on entire shares; should work on file lists. smbtar works best with GNU tar and may not work well with other versions.",
      "protected": []
    },
    {
      "id": "s0043",
      "kind": "heading",
      "text": "DIAGNOSTICS",
      "protected": []
    },
    {
      "id": "s0044",
      "kind": "paragraph",
      "text": "See the [[p0]]DIAGNOSTICS[[p1]] section for the [[p2]] command.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "</em>"
        },
        {
          "token": "[[p2]]",
          "text": "smbclient(1)"
        }
      ]
    },
    {
      "id": "s0045",
      "kind": "heading",
      "text": "VERSION",
      "protected": []
    },
    {
      "id": "s0046",
      "kind": "paragraph",
      "text": "This man page is part of version 4.25.0 of the Samba suite.",
      "protected": []
    },
    {
      "id": "s0047",
      "kind": "heading",
      "text": "SEE ALSO",
      "protected": []
    },
    {
      "id": "s0048",
      "kind": "paragraph",
      "text": "[[p0]], [[p1]], [[p2]].",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "smbd(8)"
        },
        {
          "token": "[[p1]]",
          "text": "smbclient(1)"
        },
        {
          "token": "[[p2]]",
          "text": "smb.conf(5)"
        }
      ]
    },
    {
      "id": "s0049",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0050",
      "kind": "paragraph",
      "text": "The original Samba software and related utilities were created by Andrew Tridgell. Samba is now developed by the Samba Team as an Open Source project similar to the way the Linux kernel is developed.",
      "protected": []
    },
    {
      "id": "s0051",
      "kind": "paragraph",
      "text": "Ricky Poulten wrote the tar extension and this man page. The [[p0]] script was heavily rewritten and improved by Martin Kraemer. Many thanks to everyone who suggested extensions, improvements, bug fixes, etc. The man page sources were converted to YODL format (another excellent piece of Open Source software, available at ftp://ftp.icce.rug.nl/pub/unix/) and updated for the Samba 2.0 release by Jeremy Allison. The conversion to DocBook for Samba 2.2 was done by Gerald Carter. The conversion to DocBook XML 4.2 for Samba 3.0 was done by Alexander Bokovoy.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "smbtar"
        }
      ]
    }
  ]
