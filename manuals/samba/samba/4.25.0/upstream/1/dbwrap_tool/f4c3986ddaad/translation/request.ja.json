        },
        {
          "token": "[[p7]]",
          "text": "--debug-stdout"
        },
        {
          "token": "[[p8]]",
          "text": "--configfile"
        },
        {
          "token": "[[p9]]",
          "text": "--option"
        },
        {
          "token": "[[p10]]",
