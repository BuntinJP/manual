        },
        {
          "token": "[[p11]]",
          "text": "--log-basename"
        },
        {
          "token": "[[p12]]",
          "text": "--leak-report"
        },
        {
          "token": "[[p13]]",
          "text": "--leak-report-full"
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This tool is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "samba(7)"
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "The dbwrap_tool program is used to read and manipulate TDB/CTDB databases using the dbwrap interface.",
      "protected": []
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "The following database operations are available:",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "fetch: fetch a record",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "store: create or modify a record",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "paragraph",
      "text": "delete: remove a record",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "exists: test for existence of a record",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "paragraph",
      "text": "erase: remove all records",
      "protected": []
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "listkeys: list all available records",
      "protected": []
    },
    {
      "id": "s0015",
      "kind": "paragraph",
      "text": "listwatchers: list processes, which are waiting for changes in a record",
      "protected": []
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "The following types are available:",
      "protected": []
    },
    {
      "id": "s0017",
      "kind": "paragraph",
      "text": "int32: signed 32bit integer",
      "protected": []
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "uint32: unsigned 32bit integer",
      "protected": []
    },
    {
      "id": "s0019",
      "kind": "paragraph",
      "text": "string: \"hello world\"",
      "protected": []
    },
    {
      "id": "s0020",
      "kind": "paragraph",
      "text": "hex: hex strings like \"68656C6C6F20776F726C6400\" (\"hello world\")",
      "protected": []
    },
    {
      "id": "s0021",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0022",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--persistent"
        }
      ]
    },
    {
      "id": "s0023",
      "kind": "paragraph",
      "text": "Open the database as a persistent database.",
      "protected": []
    },
    {
      "id": "s0024",
      "kind": "paragraph",
      "text": "Exactly one of [[p0]] and [[p1]] must be specified.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--persistent"
        },
        {
          "token": "[[p1]]",
          "text": "--non-persistent"
        }
      ]
    },
    {
      "id": "s0025",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--non-persistent"
        }
      ]
    },
    {
      "id": "s0026",
      "kind": "paragraph",
      "text": "Open the database as a non-persistent database.",
      "protected": []
    },
    {
      "id": "s0027",
      "kind": "paragraph",
      "text": "Caveat: opening a database as non-persistent when there is currently no other opener will wipe the database.",
      "protected": []
    },
    {
      "id": "s0028",
      "kind": "paragraph",
      "text": "Exactly one of [[p0]] and [[p1]] must be specified.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--persistent"
        },
        {
          "token": "[[p1]]",
          "text": "--non-persistent"
        }
      ]
    },
    {
      "id": "s0029",
      "kind": "term",
      "text": "-?|[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--help"
        }
      ]
    },
    {
      "id": "s0030",
      "kind": "paragraph",
      "text": "Print a summary of command line options.",
      "protected": []
    },
    {
      "id": "s0031",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--usage"
        }
      ]
    },
    {
      "id": "s0032",
      "kind": "paragraph",
      "text": "Display brief usage message.",
      "protected": []
    },
    {
      "id": "s0033",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=level",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-d"
        },
        {
          "token": "[[p1]]",
          "text": "--debuglevel"
        }
      ]
    },
    {
      "id": "s0034",
      "kind": "paragraph",
      "text": "[[p0]][[p1]][[p2]] is an integer from 0 to 10. The default value if this parameter is not specified is 1 for client applications.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "level"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0035",
      "kind": "paragraph",
      "text": "The higher this value, the more detail will be logged to the log files about the activities of the server. At level 0, only critical errors and serious warnings will be logged. Level 1 is a reasonable level for day-to-day running - it generates a small amount of information about operations carried out.",
      "protected": []
    },
    {
      "id": "s0036",
      "kind": "paragraph",
      "text": "Levels above 1 will generate considerable amounts of log data, and should only be used when investigating a problem. Levels above 3 are designed for use only by developers and generate HUGE amounts of log data, most of which is extremely cryptic.",
      "protected": []
    },
    {
      "id": "s0037",
      "kind": "paragraph",
      "text": "Note that specifying this parameter here will override the [[p0]] parameter in the [[p1]] file.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "log level"
        },
        {
          "token": "[[p1]]",
          "text": "${prefix}/etc/smb.conf"
        }
      ]
    },
    {
      "id": "s0038",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--debug-stdout"
        }
      ]
    },
    {
      "id": "s0039",
      "kind": "paragraph",
      "text": "This will redirect debug output to STDOUT. By default all clients are logging to STDERR.",
      "protected": []
    },
    {
      "id": "s0040",
      "kind": "term",
      "text": "[[p0]]=<configuration file>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--configfile"
        }
      ]
    },
    {
      "id": "s0041",
      "kind": "paragraph",
      "text": "The file specified contains the configuration details required by the client. The information in this file can be general for client and server or only provide client specific like options such as [[p0]]. See [[p1]] for more information. The default configuration file name is determined at compile time.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "client smb encrypt"
        },
        {
          "token": "[[p1]]",
          "text": "${prefix}/etc/smb.conf"
        }
      ]
    },
    {
      "id": "s0042",
      "kind": "term",
      "text": "[[p0]]=<name>=<value>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--option"
        }
      ]
    },
    {
      "id": "s0043",
      "kind": "paragraph",
      "text": "Set the [[p0]] option \"<name>\" to value \"<value>\" from the command line. This overrides compiled-in defaults and options read from the configuration file. If a name or a value includes a space, wrap whole [[p1]]=name=value into quotes.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "smb.conf(5)"
        },
        {
          "token": "[[p1]]",
          "text": "--option"
        }
      ]
    },
    {
      "id": "s0044",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=logdirectory",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-l"
        },
        {
          "token": "[[p1]]",
          "text": "--log-basename"
        }
      ]
    },
    {
      "id": "s0045",
      "kind": "paragraph",
      "text": "Base directory name for log/debug files. The extension [[p0]] will be appended (e.g. log.smbclient, log.smbd, etc...). The log file is never removed by the client.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "\".progname\""
        }
      ]
    },
    {
      "id": "s0046",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--leak-report"
        }
      ]
    },
    {
      "id": "s0047",
      "kind": "paragraph",
      "text": "Enable talloc leak reporting on exit.",
      "protected": []
    },
    {
      "id": "s0048",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--leak-report-full"
        }
      ]
    },
    {
      "id": "s0049",
      "kind": "paragraph",
      "text": "Enable full talloc leak reporting on exit.",
      "protected": []
    },
    {
      "id": "s0050",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-V"
        },
        {
          "token": "[[p1]]",
          "text": "--version"
        }
      ]
    },
    {
      "id": "s0051",
      "kind": "paragraph",
      "text": "Prints the program version number.",
      "protected": []
    },
    {
