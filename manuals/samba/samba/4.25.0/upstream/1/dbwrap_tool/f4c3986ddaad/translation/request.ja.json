  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "dbwrap_tool — low level TDB/CTDB manipulation tool using the dbwrap interface",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]] [-?|[[p1]]] [[[p2]]] [[[p3]]] [[[p4]]] [[[p5]]|[[p6]]=DEBUGLEVEL] [[[p7]]] [[[p8]]=CONFIGFILE] [[[p9]]=name=value] [[[p10]]|[[p11]]=LOGFILEBASE] [[[p12]]] [[[p13]]] {<database>} {<operation>} [<key> [<type> [<value>]]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "dbwrap_tool"
        },
        {
          "token": "[[p1]]",
          "text": "--help"
        },
        {
          "token": "[[p2]]",
          "text": "--usage"
        },
        {
          "token": "[[p3]]",
          "text": "--persistent"
        },
        {
          "token": "[[p4]]",
          "text": "--non-persistent"
        },
        {
          "token": "[[p5]]",
          "text": "-d"
        },
        {
          "token": "[[p6]]",
