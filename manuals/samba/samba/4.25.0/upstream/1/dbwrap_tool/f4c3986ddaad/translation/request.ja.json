    },
    {
      "id": "s0067",
      "kind": "heading",
      "text": "EXAMPLES",
      "protected": []
    },
    {
      "id": "s0068",
      "kind": "term",
      "text": "List all keys from winbindd_idmap.tdb",
      "protected": []
    },
    {
      "id": "s0069",
      "kind": "paragraph",
      "text": "[[p0]] [[p1]] winbindd_idmap.tdb listkeys",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "dbwrap_tool"
        },
        {
          "token": "[[p1]]",
          "text": "--persistent"
        }
      ]
    },
    {
      "id": "s0070",
      "kind": "term",
      "text": "Fetch record with key \"USER HWM\" as uint32",
      "protected": []
    },
    {
      "id": "s0071",
      "kind": "paragraph",
      "text": "[[p0]] [[p1]] winbindd_idmap.tdb fetch \"USER HWM\" uint32",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "dbwrap_tool"
        },
        {
          "token": "[[p1]]",
          "text": "--persistent"
        }
      ]
    },
    {
      "id": "s0072",
      "kind": "term",
      "text": "Remove record with key \"USER HWM\"",
      "protected": []
    },
    {
      "id": "s0073",
      "kind": "paragraph",
      "text": "[[p0]] [[p1]] winbindd_idmap.tdb remove \"USER HWM\"",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "dbwrap_tool"
        },
        {
          "token": "[[p1]]",
          "text": "--persistent"
        }
      ]
    },
    {
      "id": "s0074",
      "kind": "term",
      "text": "Store and overwrite record \"USER HWM\" with value 214",
      "protected": []
    },
    {
      "id": "s0075",
      "kind": "paragraph",
      "text": "uint32: [[p0]] [[p1]] winbindd_idmap.tdb store \"USER HWM\" uint32 214",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "dbwrap_tool"
        },
        {
          "token": "[[p1]]",
          "text": "--persistent"
        }
      ]
    },
    {
      "id": "s0076",
      "kind": "paragraph",
      "text": "hex: [[p0]] [[p1]] winbindd_idmap.tdb store \"USER HWM\" hex D6000000",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "dbwrap_tool"
        },
        {
          "token": "[[p1]]",
          "text": "--persistent"
        }
      ]
    },
    {
