      "kind": "paragraph",
      "text": "[[p0]] [[[p1]]|[[p2]]] [[[p3]]|[[p4]]] [-?|[[p5]]] [[[p6]]] [[[p7]]|[[p8]]=DEBUGLEVEL] [[[p9]]] [[[p10]]=CONFIGFILE] [[[p11]]=name=value] [[[p12]]|[[p13]]=LOGFILEBASE] [[[p14]]] [[[p15]]] [[[p16]]|[[p17]]=[DOMAIN/]USERNAME[[[p18]]ASSWORD]] [[[p19]]|[[p20]]] [[[p21]]=STRING] [[[p22]]] [[[p23]]|[[p24]]=FILE] [[[p25]]|[[p26]]] [[[p27]]=DN] [[[p28]]=desired|required|off] [[[p29]]=CCACHE] [[[p30]]] [[[p31]]=sign|encrypt|off] [[[p32]]|[[p33]]]",
