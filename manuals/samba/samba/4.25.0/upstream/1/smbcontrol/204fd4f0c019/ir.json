{
  "schemaVersion": 1,
  "parserVersion": 1,
  "sourceSha256": "204fd4f0c019be559e1dc43230e419dff6e1ef36e4203484063da2fb05bc9d9f",
  "extraction": {
    "selector": ".refentry",
    "kind": "semantic-html",
    "warnings": []
  },
  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "smbcontrol — send messages to smbd, nmbd or winbindd processes",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]] [-?|[[p1]]] [[[p2]]] [[[p3]]|[[p4]]] [[[p5]]|[[p6]]=DEBUGLEVEL] [[[p7]]] [[[p8]]=CONFIGFILE] [[[p9]]=name=value] [[[p10]]|[[p11]]=LOGFILEBASE] [[[p12]]] [[[p13]]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "smbcontrol"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--help"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "code",
            "text": "--usage"
          }
        },
        {
          "token": "[[p3]]",
          "inline": {
            "tag": "code",
            "text": "-t"
          }
        },
        {
          "token": "[[p4]]",
          "inline": {
            "tag": "code",
            "text": "--timeout"
          }
        },
        {
          "token": "[[p5]]",
          "inline": {
            "tag": "code",
            "text": "-d"
          }
        },
        {
          "token": "[[p6]]",
          "inline": {
            "tag": "code",
            "text": "--debuglevel"
          }
        },
        {
          "token": "[[p7]]",
          "inline": {
            "tag": "code",
            "text": "--debug-stdout"
          }
        },
        {
          "token": "[[p8]]",
          "inline": {
            "tag": "code",
            "text": "--configfile"
          }
        },
        {
          "token": "[[p9]]",
          "inline": {
            "tag": "code",
            "text": "--option"
          }
        },
        {
          "token": "[[p10]]",
          "inline": {
            "tag": "code",
            "text": "-l"
          }
        },
        {
          "token": "[[p11]]",
          "inline": {
            "tag": "code",
            "text": "--log-basename"
          }
        },
        {
          "token": "[[p12]]",
          "inline": {
            "tag": "code",
            "text": "--leak-report"
          }
        },
        {
          "token": "[[p13]]",
          "inline": {
            "tag": "code",
            "text": "--leak-report-full"
          }
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "paragraph",
      "text": "[[p0]] [destination] [message-type] [parameter]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "smbcontrol"
          }
        }
      ]
    },
    {
      "id": "s0006",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "This tool is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "samba(7)",
            "href": "https://www.samba.org/samba/docs/current/man-html/samba.7.html"
          }
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "[[p0]] is a very small program, which sends messages to a [[p1]], a [[p2]], or a [[p3]] daemon running on the system.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "smbcontrol"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "link",
            "text": "smbd(8)",
            "href": "https://www.samba.org/samba/docs/current/man-html/smbd.8.html"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "link",
            "text": "nmbd(8)",
            "href": "https://www.samba.org/samba/docs/current/man-html/nmbd.8.html"
          }
        },
        {
          "token": "[[p3]]",
          "inline": {
            "tag": "link",
            "text": "winbindd(8)",
            "href": "https://www.samba.org/samba/docs/current/man-html/winbindd.8.html"
          }
        }
      ]
    },
    {
      "id": "s0009",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-t"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--timeout"
          }
        }
      ]
    },
    {
      "id": "s0011",
      "kind": "paragraph",
      "text": "Set timeout to seconds.",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "term",
      "text": "destination",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "paragraph",
      "text": "One of [[p0]][[p1]][[p2]], [[p3]][[p4]][[p5]], [[p6]][[p7]][[p8]] or a process ID.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "nmbd"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        },
        {
          "token": "[[p3]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p4]]",
          "inline": {
            "tag": "code",
            "text": "smbd"
          }
        },
        {
          "token": "[[p5]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        },
        {
          "token": "[[p6]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p7]]",
          "inline": {
            "tag": "code",
            "text": "winbindd"
          }
        },
        {
          "token": "[[p8]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        }
      ]
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "The [[p0]][[p1]][[p2]] destination causes the message to \"broadcast\" to all running daemons including nmbd and winbind. This is a change for Samba 3.3, prior to this the parameter smbd used to do this.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "all"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        }
      ]
    },
    {
      "id": "s0015",
      "kind": "paragraph",
      "text": "The [[p0]][[p1]][[p2]] destination causes the message to be sent to the smbd daemon specified in the [[p3]] file.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "smbd"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        },
        {
          "token": "[[p3]]",
          "inline": {
            "tag": "code",
            "text": "smbd.pid"
          }
        }
      ]
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "The [[p0]][[p1]][[p2]] destination causes the message to be sent to the nmbd daemon specified in the [[p3]] file.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "nmbd"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        },
        {
          "token": "[[p3]]",
          "inline": {
            "tag": "code",
            "text": "nmbd.pid"
          }
        }
      ]
    },
    {
      "id": "s0017",
      "kind": "paragraph",
      "text": "The [[p0]][[p1]][[p2]] destination causes the message to be sent to the winbind daemon specified in the [[p3]] file.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "winbindd"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        },
        {
          "token": "[[p3]]",
          "inline": {
            "tag": "code",
            "text": "winbindd.pid"
          }
        }
      ]
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "If a single process ID is given, the message is sent to only that process.",
      "protected": []
    },
    {
      "id": "s0019",
      "kind": "term",
      "text": "message-type",
      "protected": []
    },
    {
      "id": "s0020",
      "kind": "paragraph",
      "text": "Type of message to send. See the section [[p0]] for details.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "MESSAGE-TYPES"
          }
        }
      ]
    },
    {
      "id": "s0021",
      "kind": "term",
      "text": "parameters",
      "protected": []
    },
    {
      "id": "s0022",
      "kind": "paragraph",
      "text": "any parameters required for the message-type",
      "protected": []
    },
    {
      "id": "s0023",
      "kind": "term",
      "text": "-?|[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--help"
          }
        }
      ]
    },
    {
      "id": "s0024",
      "kind": "paragraph",
      "text": "Print a summary of command line options.",
      "protected": []
    },
    {
      "id": "s0025",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--usage"
          }
        }
      ]
    },
    {
      "id": "s0026",
      "kind": "paragraph",
      "text": "Display brief usage message.",
      "protected": []
    },
    {
      "id": "s0027",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=level",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-d"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--debuglevel"
          }
        }
      ]
    },
    {
      "id": "s0028",
      "kind": "paragraph",
      "text": "[[p0]][[p1]][[p2]] is an integer from 0 to 10. The default value if this parameter is not specified is 1 for client applications.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "level"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        }
      ]
    },
    {
      "id": "s0029",
      "kind": "paragraph",
      "text": "The higher this value, the more detail will be logged to the log files about the activities of the server. At level 0, only critical errors and serious warnings will be logged. Level 1 is a reasonable level for day-to-day running - it generates a small amount of information about operations carried out.",
      "protected": []
    },
    {
      "id": "s0030",
      "kind": "paragraph",
      "text": "Levels above 1 will generate considerable amounts of log data, and should only be used when investigating a problem. Levels above 3 are designed for use only by developers and generate HUGE amounts of log data, most of which is extremely cryptic.",
      "protected": []
    },
    {
      "id": "s0031",
      "kind": "paragraph",
      "text": "Note that specifying this parameter here will override the [[p0]] parameter in the [[p1]] file.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "log level",
            "href": "https://www.samba.org/samba/docs/current/man-html/smb.conf.5.html#LOGLEVEL"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "${prefix}/etc/smb.conf"
          }
        }
      ]
    },
    {
      "id": "s0032",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--debug-stdout"
          }
        }
      ]
    },
    {
      "id": "s0033",
      "kind": "paragraph",
      "text": "This will redirect debug output to STDOUT. By default all clients are logging to STDERR.",
      "protected": []
    },
    {
      "id": "s0034",
      "kind": "term",
      "text": "[[p0]]=<configuration file>",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--configfile"
          }
        }
      ]
    },
    {
      "id": "s0035",
      "kind": "paragraph",
      "text": "The file specified contains the configuration details required by the client. The information in this file can be general for client and server or only provide client specific like options such as [[p0]]. See [[p1]] for more information. The default configuration file name is determined at compile time.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "client smb encrypt",
            "href": "https://www.samba.org/samba/docs/current/man-html/smb.conf.5.html#CLIENTSMBENCRYPT"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "${prefix}/etc/smb.conf"
          }
        }
      ]
    },
    {
      "id": "s0036",
      "kind": "term",
      "text": "[[p0]]=<name>=<value>",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--option"
          }
        }
      ]
    },
    {
      "id": "s0037",
      "kind": "paragraph",
      "text": "Set the [[p0]] option \"<name>\" to value \"<value>\" from the command line. This overrides compiled-in defaults and options read from the configuration file. If a name or a value includes a space, wrap whole [[p1]]=name=value into quotes.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "smb.conf(5)",
            "href": "https://www.samba.org/samba/docs/current/man-html/smb.conf.5.html"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--option"
          }
        }
      ]
    },
    {
      "id": "s0038",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=logdirectory",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-l"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--log-basename"
          }
        }
      ]
    },
    {
      "id": "s0039",
      "kind": "paragraph",
      "text": "Base directory name for log/debug files. The extension [[p0]] will be appended (e.g. log.smbclient, log.smbd, etc...). The log file is never removed by the client.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "\".progname\""
          }
        }
      ]
    },
    {
      "id": "s0040",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--leak-report"
          }
        }
      ]
    },
    {
      "id": "s0041",
      "kind": "paragraph",
      "text": "Enable talloc leak reporting on exit.",
      "protected": []
    },
    {
      "id": "s0042",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--leak-report-full"
          }
        }
      ]
    },
    {
      "id": "s0043",
      "kind": "paragraph",
      "text": "Enable full talloc leak reporting on exit.",
      "protected": []
    },
    {
      "id": "s0044",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-V"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--version"
          }
        }
      ]
    },
    {
      "id": "s0045",
      "kind": "paragraph",
      "text": "Prints the program version number.",
      "protected": []
    },
    {
      "id": "s0046",
      "kind": "heading",
      "text": "MESSAGE-TYPES",
      "protected": []
    },
    {
      "id": "s0047",
      "kind": "paragraph",
      "text": "Available message types are:",
      "protected": []
    },
    {
      "id": "s0048",
      "kind": "term",
      "text": "close-share",
      "protected": []
    },
    {
      "id": "s0049",
      "kind": "paragraph",
      "text": "Order smbd to close the client connections to the named share. Note that this doesn't affect client connections to any other shares. This message-type takes an argument of the share name for which client connections will be closed, or the \"*\" character which will close all currently open shares. This may be useful if you made changes to the access controls on the share. This message can only be sent to [[p0]].",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "smbd"
          }
        }
      ]
    },
    {
      "id": "s0050",
      "kind": "term",
      "text": "close-denied-share",
      "protected": []
    },
    {
      "id": "s0051",
      "kind": "paragraph",
      "text": "Behave like [[p0]], but don't disconnect users that are still allowed to access the share. It can safely be sent to all smbds after changing share access controls. It will only affect users who have been denied access since having connected initially. This message can only be sent to [[p1]].",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "close-share"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "smbd"
          }
        }
      ]
    },
    {
      "id": "s0052",
      "kind": "term",
      "text": "debug",
      "protected": []
    },
    {
      "id": "s0053",
      "kind": "paragraph",
      "text": "Set debug level to the value specified by the parameter. This can be sent to any of the destinations. If this message is sent to either the smbd or winbindd daemons, the parent process will rebroadcast the message to all child processes changing the debug level in each one.",
      "protected": []
    },
    {
      "id": "s0054",
      "kind": "term",
      "text": "kill-client-ip",
      "protected": []
    },
    {
      "id": "s0055",
      "kind": "paragraph",
      "text": "Order smbd to close the client connections from a given IP address. This message-type takes an argument of the IP address from which client connections will be closed. This message can only be sent to [[p0]].",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "smbd"
          }
        }
      ]
    },
    {
      "id": "s0056",
      "kind": "term",
      "text": "force-election",
      "protected": []
    },
    {
      "id": "s0057",
      "kind": "paragraph",
      "text": "This message causes the [[p0]] daemon to force a new browse master election.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "nmbd"
          }
        }
      ]
    },
    {
      "id": "s0058",
      "kind": "term",
      "text": "ping",
      "protected": []
    },
    {
      "id": "s0059",
      "kind": "paragraph",
      "text": "Send specified number of \"ping\" messages and wait for the same number of reply \"pong\" messages. This can be sent to any of the destinations.",
      "protected": []
    },
    {
      "id": "s0060",
      "kind": "term",
      "text": "profile",
      "protected": []
    },
    {
      "id": "s0061",
      "kind": "paragraph",
      "text": "Change profile settings of a daemon, based on the parameter. The parameter can be \"on\" to turn on profile stats collection, \"off\" to turn off profile stats collection, \"count\" to enable only collection of count stats (time stats are disabled), and \"flush\" to zero the current profile stats. This can be sent to any smbd or nmbd destinations.",
      "protected": []
    },
    {
      "id": "s0062",
      "kind": "term",
      "text": "debuglevel",
      "protected": []
    },
    {
      "id": "s0063",
      "kind": "paragraph",
      "text": "Request debuglevel of a certain daemon and write it to stdout. This can be sent to any of the destinations.",
      "protected": []
    },
    {
      "id": "s0064",
      "kind": "term",
      "text": "profilelevel",
      "protected": []
    },
    {
      "id": "s0065",
      "kind": "paragraph",
      "text": "Request profilelevel of a certain daemon and write it to stdout. This can be sent to any smbd or nmbd destinations.",
      "protected": []
    },
    {
      "id": "s0066",
      "kind": "term",
      "text": "printnotify",
      "protected": []
    },
    {
      "id": "s0067",
      "kind": "paragraph",
      "text": "Order smbd to send a printer notify message to any Windows NT clients connected to a printer. This message-type takes the following arguments:",
      "protected": []
    },
    {
      "id": "s0068",
      "kind": "term",
      "text": "queuepause printername",
      "protected": []
    },
    {
      "id": "s0069",
      "kind": "paragraph",
      "text": "Send a queue pause change notify message to the printer specified.",
      "protected": []
    },
    {
      "id": "s0070",
      "kind": "term",
      "text": "queueresume printername",
      "protected": []
    },
    {
      "id": "s0071",
      "kind": "paragraph",
      "text": "Send a queue resume change notify message for the printer specified.",
      "protected": []
    },
    {
      "id": "s0072",
      "kind": "term",
      "text": "jobpause printername unixjobid",
      "protected": []
    },
    {
      "id": "s0073",
      "kind": "paragraph",
      "text": "Send a job pause change notify message for the printer and unix jobid specified.",
      "protected": []
    },
    {
      "id": "s0074",
      "kind": "term",
      "text": "jobresume printername unixjobid",
      "protected": []
    },
    {
      "id": "s0075",
      "kind": "paragraph",
      "text": "Send a job resume change notify message for the printer and unix jobid specified.",
      "protected": []
    },
    {
      "id": "s0076",
      "kind": "term",
      "text": "jobdelete printername unixjobid",
      "protected": []
    },
    {
      "id": "s0077",
      "kind": "paragraph",
      "text": "Send a job delete change notify message for the printer and unix jobid specified.",
      "protected": []
    },
    {
      "id": "s0078",
      "kind": "paragraph",
      "text": "Note that this message only sends notification that an event has occurred. It doesn't actually cause the event to happen.",
      "protected": []
    },
    {
      "id": "s0079",
      "kind": "paragraph",
      "text": "This message can only be sent to [[p0]].",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "smbd"
          }
        }
      ]
    },
    {
      "id": "s0080",
      "kind": "term",
      "text": "dmalloc-mark",
      "protected": []
    },
    {
      "id": "s0081",
      "kind": "paragraph",
      "text": "Set a mark for dmalloc. Can be sent to both smbd and nmbd. Only available if samba is built with dmalloc support.",
      "protected": []
    },
    {
      "id": "s0082",
      "kind": "term",
      "text": "dmalloc-log-changed",
      "protected": []
    },
    {
      "id": "s0083",
      "kind": "paragraph",
      "text": "Dump the pointers that have changed since the mark set by dmalloc-mark. Can be sent to both smbd and nmbd. Only available if samba is built with dmalloc support.",
      "protected": []
    },
    {
      "id": "s0084",
      "kind": "term",
      "text": "shutdown",
      "protected": []
    },
    {
      "id": "s0085",
      "kind": "paragraph",
      "text": "Shut down specified daemon. Can be sent to both smbd and nmbd.",
      "protected": []
    },
    {
      "id": "s0086",
      "kind": "term",
      "text": "pool-usage",
      "protected": []
    },
    {
      "id": "s0087",
      "kind": "paragraph",
      "text": "Print a human-readable description of all talloc(pool) memory usage by the specified daemon/process. Available for both smbd and nmbd.",
      "protected": []
    },
    {
      "id": "s0088",
      "kind": "term",
      "text": "ringbuf-log",
      "protected": []
    },
    {
      "id": "s0089",
      "kind": "paragraph",
      "text": "Fetch and print the ringbuf log. Requires [[p0]][[p1]][[p2]]. Available for smbd, winbindd and nmbd.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "logging = ringbuf"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        }
      ]
    },
    {
      "id": "s0090",
      "kind": "term",
      "text": "drvupgrade",
      "protected": []
    },
    {
      "id": "s0091",
      "kind": "paragraph",
      "text": "Force clients of printers using specified driver to update their local version of the driver. Can only be sent to smbd.",
      "protected": []
    },
    {
      "id": "s0092",
      "kind": "term",
      "text": "reload-config",
      "protected": []
    },
    {
      "id": "s0093",
      "kind": "paragraph",
      "text": "Force daemon to reload smb.conf configuration file. Can be sent to [[p0]], [[p1]], or [[p2]].",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "smbd"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "nmbd"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "code",
            "text": "winbindd"
          }
        }
      ]
    },
    {
      "id": "s0094",
      "kind": "term",
      "text": "reload-printers",
      "protected": []
    },
    {
      "id": "s0095",
      "kind": "paragraph",
      "text": "Force smbd to reload printers. Can only be sent to [[p0]].",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "smbd"
          }
        }
      ]
    },
    {
      "id": "s0096",
      "kind": "term",
      "text": "idmap",
      "protected": []
    },
    {
      "id": "s0097",
      "kind": "paragraph",
      "text": "Notify about changes of id mapping. Can be sent to [[p0]] or (not implemented yet) [[p1]].",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "smbd"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "winbindd"
          }
        }
      ]
    },
    {
      "id": "s0098",
      "kind": "term",
      "text": "flush [uid|gid]",
      "protected": []
    },
    {
      "id": "s0099",
      "kind": "paragraph",
      "text": "Flush caches for sid <-> gid and/or sid <-> uid mapping.",
      "protected": []
    },
    {
      "id": "s0100",
      "kind": "term",
      "text": "delete <ID>",
      "protected": []
    },
    {
      "id": "s0101",
      "kind": "paragraph",
      "text": "Remove a mapping from cache. The mapping is given by <ID> which may either be a sid: S-x-..., a gid: \"GID number\" or a uid: \"UID number\".",
      "protected": []
    },
    {
      "id": "s0102",
      "kind": "term",
      "text": "kill <ID>",
      "protected": []
    },
    {
      "id": "s0103",
      "kind": "paragraph",
      "text": "Remove a mapping from cache. Terminate [[p0]] if the id is currently in use.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "smbd"
          }
        }
      ]
    },
    {
      "id": "s0104",
      "kind": "term",
      "text": "num-children",
      "protected": []
    },
    {
      "id": "s0105",
      "kind": "paragraph",
      "text": "Query the number of smbd child processes. This message can only be sent to [[p0]].",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "smbd"
          }
        }
      ]
    },
    {
      "id": "s0106",
      "kind": "term",
      "text": "reload-certs",
      "protected": []
    },
    {
      "id": "s0107",
      "kind": "paragraph",
      "text": "Instruct the LDAP server of a Samba AD DC to reload the TLS certificates protecting ldaps:// connections. This message can only be sent to [[p0]].",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "ldap_server"
          }
        }
      ]
    },
    {
      "id": "s0108",
      "kind": "heading",
      "text": "VERSION",
      "protected": []
    },
    {
      "id": "s0109",
      "kind": "paragraph",
      "text": "This man page is part of version 4.25.0 of the Samba suite.",
      "protected": []
    },
    {
      "id": "s0110",
      "kind": "heading",
      "text": "SEE ALSO",
      "protected": []
    },
    {
      "id": "s0111",
      "kind": "paragraph",
      "text": "[[p0]] and [[p1]].",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "nmbd(8)",
            "href": "https://www.samba.org/samba/docs/current/man-html/nmbd.8.html"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "link",
            "text": "smbd(8)",
            "href": "https://www.samba.org/samba/docs/current/man-html/smbd.8.html"
          }
        }
      ]
    },
    {
      "id": "s0112",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0113",
      "kind": "paragraph",
      "text": "The original Samba software and related utilities were created by Andrew Tridgell. Samba is now developed by the Samba Team as an Open Source project similar to the way the Linux kernel is developed.",
      "protected": []
    }
  ],
