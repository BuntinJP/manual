      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This tool is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "samba(1)",
            "href": "https://www.samba.org/samba/docs/current/man-html/samba.1.html"
          }
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "mvxattr is a simple utility to recursively rename extended attributes.",
      "protected": []
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "By default all symlinks are ignored, use [[p0]] to follow them.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-l"
          }
        }
      ]
    },
    {
