    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "profiles — A utility to report and change SIDs in registry files",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]] [[[p1]]|[[p2]]=STRING] [[[p3]]|[[p4]]=STRING] [[[p5]]|[[p6]]] [-?|[[p7]]] [[[p8]]] [[[p9]]|[[p10]]=DEBUGLEVEL] [[[p11]]] [[[p12]]=CONFIGFILE] [[[p13]]=name=value] [[[p14]]|[[p15]]=LOGFILEBASE] [[[p16]]] [[[p17]]] {FILE}",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "profiles"
        },
        {
          "token": "[[p1]]",
          "text": "-c"
        },
        {
          "token": "[[p2]]",
          "text": "--change-sid"
        },
        {
          "token": "[[p3]]",
          "text": "-n"
        },
        {
          "token": "[[p4]]",
