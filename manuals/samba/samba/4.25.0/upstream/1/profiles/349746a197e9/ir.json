  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "Name",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "profiles — A utility to report and change SIDs in registry files",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Synopsis",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]] [[[p1]]|[[p2]]=STRING] [[[p3]]|[[p4]]=STRING] [[[p5]]|[[p6]]] [-?|[[p7]]] [[[p8]]] [[[p9]]|[[p10]]=DEBUGLEVEL] [[[p11]]] [[[p12]]=CONFIGFILE] [[[p13]]=name=value] [[[p14]]|[[p15]]=LOGFILEBASE] [[[p16]]] [[[p17]]] {FILE}",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "profiles"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "-c"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "code",
            "text": "--change-sid"
          }
        },
        {
          "token": "[[p3]]",
          "inline": {
            "tag": "code",
            "text": "-n"
          }
        },
        {
          "token": "[[p4]]",
          "inline": {
            "tag": "code",
            "text": "--new-sid"
          }
        },
        {
          "token": "[[p5]]",
          "inline": {
            "tag": "code",
            "text": "-v"
          }
        },
        {
          "token": "[[p6]]",
          "inline": {
            "tag": "code",
            "text": "--verbose"
          }
        },
        {
          "token": "[[p7]]",
          "inline": {
            "tag": "code",
            "text": "--help"
          }
        },
        {
          "token": "[[p8]]",
          "inline": {
            "tag": "code",
            "text": "--usage"
          }
        },
        {
          "token": "[[p9]]",
          "inline": {
            "tag": "code",
            "text": "-d"
          }
        },
        {
          "token": "[[p10]]",
          "inline": {
            "tag": "code",
            "text": "--debuglevel"
          }
        },
        {
          "token": "[[p11]]",
          "inline": {
            "tag": "code",
            "text": "--debug-stdout"
          }
        },
        {
          "token": "[[p12]]",
          "inline": {
            "tag": "code",
            "text": "--configfile"
          }
        },
        {
          "token": "[[p13]]",
          "inline": {
            "tag": "code",
            "text": "--option"
          }
        },
        {
          "token": "[[p14]]",
          "inline": {
            "tag": "code",
            "text": "-l"
          }
        },
        {
          "token": "[[p15]]",
          "inline": {
            "tag": "code",
            "text": "--log-basename"
          }
        },
        {
          "token": "[[p16]]",
          "inline": {
            "tag": "code",
            "text": "--leak-report"
          }
        },
        {
          "token": "[[p17]]",
          "inline": {
            "tag": "code",
            "text": "--leak-report-full"
          }
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This tool is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "samba(7)",
            "href": "https://www.samba.org/samba/docs/current/man-html/samba.7.html"
          }
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "[[p0]] is a utility that reports and changes SIDs in windows registry files. It currently only supports NT.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "profiles"
          }
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "term",
      "text": "file",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "Registry file to view or edit.",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "term",
      "text": "[[p0]],[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-v"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--verbose"
          }
        }
      ]
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "Increases verbosity of messages.",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "term",
      "text": "[[p0]] SID1 [[p1]] SID2, [[p2]] SID1 [[p3]] SID2",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-c"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "-n"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "code",
            "text": "--change-sid"
          }
        },
        {
          "token": "[[p3]]",
          "inline": {
            "tag": "code",
            "text": "--new-sid"
          }
        }
      ]
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "Change all occurrences of SID1 in [[p0]] by SID2.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "file"
          }
        }
      ]
    },
    {
      "id": "s0015",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=level",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-d"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--debuglevel"
          }
        }
      ]
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "[[p0]][[p1]][[p2]] is an integer from 0 to 10. The default value if this parameter is not specified is 1 for client applications.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "level"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        }
      ]
    },
    {
      "id": "s0017",
      "kind": "paragraph",
      "text": "The higher this value, the more detail will be logged to the log files about the activities of the server. At level 0, only critical errors and serious warnings will be logged. Level 1 is a reasonable level for day-to-day running - it generates a small amount of information about operations carried out.",
      "protected": []
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "Levels above 1 will generate considerable amounts of log data, and should only be used when investigating a problem. Levels above 3 are designed for use only by developers and generate HUGE amounts of log data, most of which is extremely cryptic.",
      "protected": []
    },
    {
      "id": "s0019",
      "kind": "paragraph",
      "text": "Note that specifying this parameter here will override the [[p0]] parameter in the [[p1]] file.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "log level",
            "href": "https://www.samba.org/samba/docs/current/man-html/smb.conf.5.html#LOGLEVEL"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "${prefix}/etc/smb.conf"
          }
        }
      ]
    },
    {
      "id": "s0020",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--debug-stdout"
          }
        }
      ]
    },
    {
      "id": "s0021",
      "kind": "paragraph",
      "text": "This will redirect debug output to STDOUT. By default all clients are logging to STDERR.",
      "protected": []
    },
    {
      "id": "s0022",
      "kind": "term",
      "text": "[[p0]]=<configuration file>",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--configfile"
          }
        }
      ]
    },
    {
      "id": "s0023",
      "kind": "paragraph",
      "text": "The file specified contains the configuration details required by the client. The information in this file can be general for client and server or only provide client specific like options such as [[p0]]. See [[p1]] for more information. The default configuration file name is determined at compile time.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "client smb encrypt",
            "href": "https://www.samba.org/samba/docs/current/man-html/smb.conf.5.html#CLIENTSMBENCRYPT"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "${prefix}/etc/smb.conf"
          }
        }
      ]
    },
    {
      "id": "s0024",
      "kind": "term",
      "text": "[[p0]]=<name>=<value>",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--option"
          }
        }
      ]
    },
    {
      "id": "s0025",
      "kind": "paragraph",
      "text": "Set the [[p0]] option \"<name>\" to value \"<value>\" from the command line. This overrides compiled-in defaults and options read from the configuration file. If a name or a value includes a space, wrap whole [[p1]]=name=value into quotes.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "smb.conf(5)",
            "href": "https://www.samba.org/samba/docs/current/man-html/smb.conf.5.html"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--option"
          }
        }
      ]
    },
    {
      "id": "s0026",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=logdirectory",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-l"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--log-basename"
          }
        }
      ]
    },
    {
      "id": "s0027",
      "kind": "paragraph",
      "text": "Base directory name for log/debug files. The extension [[p0]] will be appended (e.g. log.smbclient, log.smbd, etc...). The log file is never removed by the client.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "\".progname\""
          }
        }
      ]
    },
    {
      "id": "s0028",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--leak-report"
          }
        }
      ]
    },
    {
      "id": "s0029",
      "kind": "paragraph",
      "text": "Enable talloc leak reporting on exit.",
      "protected": []
    },
    {
      "id": "s0030",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--leak-report-full"
          }
        }
      ]
    },
    {
      "id": "s0031",
      "kind": "paragraph",
      "text": "Enable full talloc leak reporting on exit.",
      "protected": []
    },
    {
      "id": "s0032",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-V"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--version"
          }
        }
      ]
    },
    {
      "id": "s0033",
      "kind": "paragraph",
      "text": "Prints the program version number.",
      "protected": []
    },
    {
      "id": "s0034",
      "kind": "term",
      "text": "-?|[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--help"
          }
        }
      ]
    },
    {
      "id": "s0035",
      "kind": "paragraph",
      "text": "Print a summary of command line options.",
      "protected": []
    },
    {
      "id": "s0036",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--usage"
          }
        }
      ]
    },
    {
      "id": "s0037",
      "kind": "paragraph",
      "text": "Display brief usage message.",
      "protected": []
    },
    {
      "id": "s0038",
      "kind": "heading",
      "text": "VERSION",
      "protected": []
    },
    {
      "id": "s0039",
      "kind": "paragraph",
      "text": "This man page is part of version 4.25.0 of the Samba suite.",
      "protected": []
    },
    {
      "id": "s0040",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0041",
      "kind": "paragraph",
      "text": "The original Samba software and related utilities were created by Andrew Tridgell. Samba is now developed by the Samba Team as an Open Source project similar to the way the Linux kernel is developed.",
      "protected": []
    },
    {
      "id": "s0042",
      "kind": "paragraph",
      "text": "The profiles man page was written by Jelmer Vernooij.",
      "protected": []
    }
  ],
