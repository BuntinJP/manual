    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This tool is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "samba(7)",
            "href": "https://www.samba.org/samba/docs/current/man-html/samba.7.html"
          }
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "[[p0]] is a very simple program to list the current Samba connections.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "smbstatus"
          }
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-P"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--profile"
          }
        }
      ]
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "If samba has been compiled with the profiling option, print only the contents of the profiling shared memory area.",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-R"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--profile-rates"
          }
        }
      ]
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "If samba has been compiled with the profiling option, print the contents of the profiling shared memory area and the call rates.",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-b"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--brief"
          }
        }
      ]
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "gives brief output.",
      "protected": []
    },
    {
      "id": "s0015",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-v"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--verbose"
          }
        }
      ]
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "gives verbose output.",
      "protected": []
    },
    {
      "id": "s0017",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-L"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--locks"
          }
        }
      ]
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "causes smbstatus to only list locks.",
      "protected": []
    },
    {
      "id": "s0019",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-B"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--byterange"
          }
        }
      ]
    },
    {
      "id": "s0020",
      "kind": "paragraph",
      "text": "causes smbstatus to include byte range locks.",
      "protected": []
    },
    {
      "id": "s0021",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-p"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--processes"
          }
        }
      ]
    },
    {
      "id": "s0022",
      "kind": "paragraph",
      "text": "print a list of [[p0]] processes and exit. Useful for scripting.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "link",
            "text": "smbd(8)",
            "href": "https://www.samba.org/samba/docs/current/man-html/smbd.8.html"
          }
        }
      ]
    },
    {
      "id": "s0023",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-S"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--shares"
          }
        }
      ]
    },
    {
      "id": "s0024",
      "kind": "paragraph",
      "text": "causes smbstatus to only list shares.",
      "protected": []
    },
    {
      "id": "s0025",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-N"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--notify"
          }
        }
      ]
    },
    {
      "id": "s0026",
      "kind": "paragraph",
      "text": "causes smbstatus to display registered file notifications",
      "protected": []
    },
    {
      "id": "s0027",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-f"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--fast"
          }
        }
      ]
    },
    {
      "id": "s0028",
      "kind": "paragraph",
      "text": "causes smbstatus to not check if the status data is valid by checking if the processes that the status data refer to all still exist. This speeds up execution on busy systems and clusters but might display stale data of processes that died without cleaning up properly.",
      "protected": []
    },
    {
      "id": "s0029",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=<username>",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-u"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--user"
          }
        }
      ]
    },
    {
      "id": "s0030",
      "kind": "paragraph",
      "text": "selects information relevant to [[p0]][[p1]][[p2]] only.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "username"
          }
        },
        {
          "token": "[[p2]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        }
      ]
    },
    {
      "id": "s0031",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-n"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--numeric"
          }
        }
      ]
    },
    {
      "id": "s0032",
      "kind": "paragraph",
      "text": "causes smbstatus to display numeric UIDs and GIDs instead of resolving them to names.",
      "protected": []
    },
    {
      "id": "s0033",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-j"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--json"
          }
        }
      ]
    },
    {
      "id": "s0034",
      "kind": "paragraph",
      "text": "Output more detailed information in JSON format instead of human readable. The output has the following format:",
      "protected": []
    },
    {
      "id": "s0035",
      "kind": "paragraph",
      "text": "If oplocks are used:",
      "protected": []
    },
    {
      "id": "s0036",
      "kind": "paragraph",
      "text": "If leases are used:",
      "protected": []
    },
    {
      "id": "s0037",
      "kind": "paragraph",
      "text": "With byte-range locks ([[p0]], [[p1]]):",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-B"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--byterange"
          }
        }
      ]
    },
    {
      "id": "s0038",
      "kind": "paragraph",
      "text": "With notifies ([[p0]], [[p1]]):",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-N"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--notify"
          }
        }
      ]
    },
    {
      "id": "s0039",
      "kind": "paragraph",
      "text": "For profiling ([[p0]], [[p1]]):",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-P"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "--profile"
          }
        }
      ]
    },
    {
      "id": "s0040",
      "kind": "term",
      "text": "-?|[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--help"
          }
        }
      ]
    },
    {
      "id": "s0041",
      "kind": "paragraph",
      "text": "Print a summary of command line options.",
      "protected": []
    },
    {
      "id": "s0042",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
