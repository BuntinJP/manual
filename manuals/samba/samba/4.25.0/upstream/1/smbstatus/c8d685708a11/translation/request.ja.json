    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This tool is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "samba(7)"
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "[[p0]] is a very simple program to list the current Samba connections.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "smbstatus"
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-P"
        },
        {
          "token": "[[p1]]",
          "text": "--profile"
        }
      ]
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "If samba has been compiled with the profiling option, print only the contents of the profiling shared memory area.",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-R"
        },
        {
          "token": "[[p1]]",
          "text": "--profile-rates"
        }
      ]
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "If samba has been compiled with the profiling option, print the contents of the profiling shared memory area and the call rates.",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-b"
        },
        {
          "token": "[[p1]]",
          "text": "--brief"
        }
      ]
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "gives brief output.",
      "protected": []
    },
    {
      "id": "s0015",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-v"
        },
        {
          "token": "[[p1]]",
          "text": "--verbose"
        }
      ]
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "gives verbose output.",
      "protected": []
    },
    {
      "id": "s0017",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-L"
        },
        {
          "token": "[[p1]]",
          "text": "--locks"
        }
      ]
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "causes smbstatus to only list locks.",
      "protected": []
    },
    {
      "id": "s0019",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-B"
        },
        {
          "token": "[[p1]]",
          "text": "--byterange"
        }
      ]
    },
    {
      "id": "s0020",
      "kind": "paragraph",
      "text": "causes smbstatus to include byte range locks.",
      "protected": []
    },
    {
      "id": "s0021",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-p"
        },
        {
          "token": "[[p1]]",
          "text": "--processes"
        }
      ]
    },
    {
      "id": "s0022",
      "kind": "paragraph",
      "text": "print a list of [[p0]] processes and exit. Useful for scripting.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "smbd(8)"
        }
      ]
    },
    {
      "id": "s0023",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-S"
        },
        {
          "token": "[[p1]]",
          "text": "--shares"
        }
      ]
    },
    {
      "id": "s0024",
      "kind": "paragraph",
      "text": "causes smbstatus to only list shares.",
      "protected": []
    },
    {
      "id": "s0025",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-N"
        },
        {
          "token": "[[p1]]",
          "text": "--notify"
        }
      ]
    },
    {
      "id": "s0026",
      "kind": "paragraph",
      "text": "causes smbstatus to display registered file notifications",
      "protected": []
    },
    {
      "id": "s0027",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-f"
        },
        {
          "token": "[[p1]]",
          "text": "--fast"
        }
      ]
    },
    {
      "id": "s0028",
      "kind": "paragraph",
      "text": "causes smbstatus to not check if the status data is valid by checking if the processes that the status data refer to all still exist. This speeds up execution on busy systems and clusters but might display stale data of processes that died without cleaning up properly.",
      "protected": []
    },
    {
      "id": "s0029",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=<username>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-u"
        },
        {
          "token": "[[p1]]",
          "text": "--user"
        }
      ]
    },
    {
      "id": "s0030",
      "kind": "paragraph",
      "text": "selects information relevant to [[p0]][[p1]][[p2]] only.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "username"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0031",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-n"
        },
        {
          "token": "[[p1]]",
          "text": "--numeric"
        }
      ]
    },
    {
      "id": "s0032",
      "kind": "paragraph",
      "text": "causes smbstatus to display numeric UIDs and GIDs instead of resolving them to names.",
      "protected": []
    },
    {
      "id": "s0033",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-j"
        },
        {
          "token": "[[p1]]",
          "text": "--json"
        }
      ]
    },
    {
      "id": "s0034",
      "kind": "paragraph",
      "text": "Output more detailed information in JSON format instead of human readable. The output has the following format:",
      "protected": []
    },
    {
      "id": "s0035",
      "kind": "paragraph",
      "text": "If oplocks are used:",
      "protected": []
    },
    {
      "id": "s0036",
      "kind": "paragraph",
      "text": "If leases are used:",
      "protected": []
    },
    {
      "id": "s0037",
      "kind": "paragraph",
      "text": "With byte-range locks ([[p0]], [[p1]]):",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-B"
        },
        {
          "token": "[[p1]]",
          "text": "--byterange"
        }
      ]
    },
    {
      "id": "s0038",
      "kind": "paragraph",
      "text": "With notifies ([[p0]], [[p1]]):",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-N"
        },
        {
          "token": "[[p1]]",
          "text": "--notify"
        }
      ]
    },
    {
      "id": "s0039",
      "kind": "paragraph",
      "text": "For profiling ([[p0]], [[p1]]):",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-P"
        },
        {
          "token": "[[p1]]",
          "text": "--profile"
        }
      ]
    },
    {
      "id": "s0040",
      "kind": "term",
      "text": "-?|[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--help"
        }
      ]
    },
    {
      "id": "s0041",
      "kind": "paragraph",
      "text": "Print a summary of command line options.",
      "protected": []
    },
    {
      "id": "s0042",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--usage"
        }
      ]
    },
    {
      "id": "s0043",
      "kind": "paragraph",
      "text": "Display brief usage message.",
      "protected": []
    },
    {
      "id": "s0044",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=level",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-d"
        },
        {
          "token": "[[p1]]",
          "text": "--debuglevel"
        }
      ]
    },
    {
      "id": "s0045",
      "kind": "paragraph",
      "text": "[[p0]][[p1]][[p2]] is an integer from 0 to 10. The default value if this parameter is not specified is 1 for client applications.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "level"
        },
        {
          "token": "[[p2]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0046",
      "kind": "paragraph",
      "text": "The higher this value, the more detail will be logged to the log files about the activities of the server. At level 0, only critical errors and serious warnings will be logged. Level 1 is a reasonable level for day-to-day running - it generates a small amount of information about operations carried out.",
      "protected": []
    },
    {
      "id": "s0047",
      "kind": "paragraph",
      "text": "Levels above 1 will generate considerable amounts of log data, and should only be used when investigating a problem. Levels above 3 are designed for use only by developers and generate HUGE amounts of log data, most of which is extremely cryptic.",
      "protected": []
    },
    {
      "id": "s0048",
      "kind": "paragraph",
      "text": "Note that specifying this parameter here will override the [[p0]] parameter in the [[p1]] file.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "log level"
        },
        {
          "token": "[[p1]]",
          "text": "${prefix}/etc/smb.conf"
        }
      ]
    },
    {
      "id": "s0049",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--debug-stdout"
        }
      ]
    },
    {
      "id": "s0050",
      "kind": "paragraph",
      "text": "This will redirect debug output to STDOUT. By default all clients are logging to STDERR.",
      "protected": []
    },
    {
      "id": "s0051",
      "kind": "term",
      "text": "[[p0]]=<configuration file>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--configfile"
        }
      ]
    },
    {
      "id": "s0052",
      "kind": "paragraph",
      "text": "The file specified contains the configuration details required by the client. The information in this file can be general for client and server or only provide client specific like options such as [[p0]]. See [[p1]] for more information. The default configuration file name is determined at compile time.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "client smb encrypt"
        },
        {
          "token": "[[p1]]",
          "text": "${prefix}/etc/smb.conf"
        }
      ]
    },
    {
      "id": "s0053",
      "kind": "term",
      "text": "[[p0]]=<name>=<value>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--option"
        }
      ]
    },
    {
      "id": "s0054",
      "kind": "paragraph",
      "text": "Set the [[p0]] option \"<name>\" to value \"<value>\" from the command line. This overrides compiled-in defaults and options read from the configuration file. If a name or a value includes a space, wrap whole [[p1]]=name=value into quotes.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "smb.conf(5)"
        },
        {
          "token": "[[p1]]",
          "text": "--option"
        }
      ]
    },
    {
      "id": "s0055",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=logdirectory",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-l"
        },
        {
          "token": "[[p1]]",
          "text": "--log-basename"
        }
      ]
    },
    {
      "id": "s0056",
      "kind": "paragraph",
      "text": "Base directory name for log/debug files. The extension [[p0]] will be appended (e.g. log.smbclient, log.smbd, etc...). The log file is never removed by the client.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "\".progname\""
        }
      ]
    },
    {
      "id": "s0057",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--leak-report"
        }
      ]
    },
    {
      "id": "s0058",
      "kind": "paragraph",
      "text": "Enable talloc leak reporting on exit.",
      "protected": []
    },
    {
      "id": "s0059",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "--leak-report-full"
        }
      ]
    },
    {
      "id": "s0060",
      "kind": "paragraph",
      "text": "Enable full talloc leak reporting on exit.",
      "protected": []
    },
    {
      "id": "s0061",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-V"
        },
        {
          "token": "[[p1]]",
          "text": "--version"
        }
      ]
    },
    {
      "id": "s0062",
      "kind": "paragraph",
      "text": "Prints the program version number.",
      "protected": []
    },
    {
