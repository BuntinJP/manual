    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This tool is part of the [[p0]] suite.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "samba(7)"
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "The [[p0]] program manipulates share permissions on SMB file shares.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "sharesec"
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "The following options are available to the [[p0]] program. The format of ACLs is described in the section ACL FORMAT",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "sharesec"
        }
      ]
    },
    {
      "id": "s0010",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=ACL",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-a"
        },
        {
          "token": "[[p1]]",
          "text": "--add"
        }
      ]
    },
    {
      "id": "s0011",
      "kind": "paragraph",
      "text": "Add the ACEs specified to the ACL list.",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-D"
        },
        {
          "token": "[[p1]]",
          "text": "--delete"
        }
      ]
    },
    {
      "id": "s0013",
      "kind": "paragraph",
      "text": "Delete the entire security descriptor.",
      "protected": []
    },
    {
      "id": "s0014",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-F"
        },
        {
          "token": "[[p1]]",
          "text": "--force"
        }
      ]
    },
    {
      "id": "s0015",
      "kind": "paragraph",
      "text": "Force storing the ACL.",
      "protected": []
    },
    {
      "id": "s0016",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=ACL",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-m"
        },
        {
          "token": "[[p1]]",
          "text": "--modify"
        }
      ]
    },
    {
      "id": "s0017",
      "kind": "paragraph",
      "text": "Modify existing ACEs.",
      "protected": []
    },
    {
      "id": "s0018",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-M"
        },
        {
          "token": "[[p1]]",
          "text": "--machine-sid"
        }
      ]
    },
    {
      "id": "s0019",
      "kind": "paragraph",
      "text": "Initialize the machine SID.",
      "protected": []
    },
    {
      "id": "s0020",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=ACL",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-r"
        },
        {
          "token": "[[p1]]",
          "text": "--remove"
        }
      ]
    },
    {
      "id": "s0021",
      "kind": "paragraph",
      "text": "Remove ACEs.",
      "protected": []
    },
    {
      "id": "s0022",
      "kind": "term",
      "text": "[[p0]]|[[p1]]=ACLS",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-R"
        },
        {
          "token": "[[p1]]",
          "text": "--replace"
        }
      ]
    },
    {
      "id": "s0023",
      "kind": "paragraph",
      "text": "Overwrite an existing share permission ACL.",
      "protected": []
    },
    {
      "id": "s0024",
      "kind": "term",
      "text": "[[p0]]|[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-v"
        },
        {
          "token": "[[p1]]",
          "text": "--view"
        }
      ]
    },
    {
      "id": "s0025",
      "kind": "paragraph",
      "text": "List a share acl",
      "protected": []
    },
    {
      "id": "s0026",
