      "protected": []
    },
    {
      "id": "s0002",
      "kind": "heading",
      "text": "winbind ID mapping plugin for cifs-utils",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "term",
      "text": "Manual section:",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "8",
      "protected": []
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "This plugin allows the utilities in cifs-utils to work in conjuction with the winbind facility of Samba suite. It handles several functions including mapping UID and GID to SIDs and vice versa.",
      "protected": []
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "Utilities are usually configured to use the correct plugin by creating a symlink at [[p0]]@pluginpath@[[p1]] that points to the correct plugin that you wish to use.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "This plugin requires that winbindd(8) be properly configured and running.",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "heading",
      "text": "SEE ALSO",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "getcifsacl(1), setcifsacl(1), cifs.idmap(8), samba(7), smb.conf(5), winbindd(8)",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "idmapwb.so was written by Jeff Layton <jlayton@samba.org>",
      "protected": []
    }
  ],
