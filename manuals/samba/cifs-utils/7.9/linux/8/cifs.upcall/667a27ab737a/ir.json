              "type": "literal",
              "text": "#OPERATION  TYPE           D C PROGRAM ARG1 ARG2...\n#=========  =============  = = ================================\ncreate      cifs.spnego    * * @sbindir@/cifs.upcall %k\ncreate      dns_resolver   * * @sbindir@/cifs.upcall %k"
