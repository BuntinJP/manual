  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "setcifsacl",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "heading",
      "text": "Userspace helper to alter components of a security descriptor for Common Internet File System (CIFS)",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "term",
      "text": "Manual section:",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "1",
      "protected": []
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "SYNOPSIS",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "setcifsacl [[[p0]]|[[p1]]|[[p2]]|[[p3]]|[[p4]]|[[p5]]|[[p6]]|[[p7]]|[[p8]]] \"{one or more ACEs or a SID}\" {file system object}",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-v"
        },
        {
          "token": "[[p1]]",
          "text": "-U"
        },
        {
          "token": "[[p2]]",
          "text": "-a"
        },
        {
          "token": "[[p3]]",
          "text": "-A"
        },
        {
          "token": "[[p4]]",
          "text": "-D"
        },
        {
          "token": "[[p5]]",
          "text": "-M"
        },
        {
          "token": "[[p6]]",
          "text": "-S"
        },
        {
          "token": "[[p7]]",
          "text": "-o"
        },
        {
          "token": "[[p8]]",
          "text": "-g"
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "This tool is part of the cifs-utils suite.",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "setcifsacl is a userspace helper program for the Linux CIFS client file system. It is intended to alter an ACL or set owner/group SID of a security descriptor for a file system object. Whether a security descriptor to be set is applied or not is determined by the CIFS/SMB server.",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "This program uses a plugin to handle the mapping of user and group names to SIDs. [[p0]]@pluginpath@[[p1]] should be a symlink that points to the correct plugin to use.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<em>"
        },
        {
          "token": "[[p1]]",
          "text": "</em>"
        }
      ]
    },
    {
      "id": "s0011",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-h"
        }
      ]
    },
    {
      "id": "s0013",
      "kind": "paragraph",
      "text": "Print usage message and exit.",
      "protected": []
    },
    {
      "id": "s0014",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-v"
        }
      ]
    },
    {
      "id": "s0015",
      "kind": "paragraph",
      "text": "Print version number and exit.",
      "protected": []
    },
    {
      "id": "s0016",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-U"
        }
      ]
    },
    {
      "id": "s0017",
      "kind": "paragraph",
      "text": "Apply ACE editing actions ([[p0]], [[p1]], [[p2]], [[p3]]) to SACL (aUdit ACL). The actions are appliend to DACL if [[p4]] is not specified.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-a"
        },
        {
          "token": "[[p1]]",
          "text": "-D"
        },
        {
          "token": "[[p2]]",
          "text": "-M"
        },
        {
          "token": "[[p3]]",
          "text": "-S"
        },
        {
          "token": "[[p4]]",
          "text": "-U"
        }
      ]
    },
    {
      "id": "s0018",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-a"
        }
      ]
    },
    {
      "id": "s0019",
      "kind": "paragraph",
      "text": "Add one or more ACEs to an ACL of a security descriptor. An ACE is added even if the same ACE exists in the ACL.",
      "protected": []
    },
    {
      "id": "s0020",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-A"
        }
      ]
    },
    {
      "id": "s0021",
      "kind": "paragraph",
      "text": "Add one or more ACEs to the ACL of a security descriptor, while maintaining the preferred order of the ACEs. The preferred order of ACEs are described in the following documentation: [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "https://docs.microsoft.com/en-us/windows/win32/secauthz/order-of-aces-in-a-dacl"
        }
      ]
    },
    {
      "id": "s0022",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-D"
        }
      ]
    },
    {
      "id": "s0023",
      "kind": "paragraph",
      "text": "Delete one or more ACEs from an ACL of a security descriptor. Entire ACE has to match in an existing ACL for the listed ACEs to be deleted.",
      "protected": []
    },
    {
      "id": "s0024",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-M"
        }
      ]
    },
    {
      "id": "s0025",
      "kind": "paragraph",
      "text": "Modify one or more ACEs from an ACL of a security descriptor. SID and type are used to match for existing ACEs to be modified with the list of ACEs specified.",
      "protected": []
    },
    {
      "id": "s0026",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-S"
        }
      ]
    },
    {
      "id": "s0027",
      "kind": "paragraph",
      "text": "Set an ACL of security descriptor with the list of ACEs Existing ACL is replaced entirely with the specified ACEs.",
      "protected": []
    },
    {
      "id": "s0028",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-o"
        }
      ]
    },
    {
      "id": "s0029",
      "kind": "paragraph",
      "text": "Set owner SID to one specified as a command line argument.",
      "protected": []
    },
    {
      "id": "s0030",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-g"
        }
      ]
    },
    {
      "id": "s0031",
      "kind": "paragraph",
      "text": "Set group SID to one specified as a command line argument.",
      "protected": []
    },
    {
      "id": "s0032",
      "kind": "paragraph",
      "text": "The owner/group SID can be specified as a name or a raw SID value. Every ACE entry starts with \"ACL:\" One or more ACEs are specified within double quotes. Multiple ACEs are separated by a comma.",
      "protected": []
    },
    {
      "id": "s0033",
      "kind": "paragraph",
      "text": "Following fields of a DACL ACE can be modified with possible values:",
      "protected": []
    },
    {
      "id": "s0034",
      "kind": "paragraph",
      "text": "SID - Either a name or a raw SID value.",
      "protected": []
    },
    {
      "id": "s0035",
      "kind": "paragraph",
      "text": "type - ALLOWED (0x0), DENIED (0x1), OBJECT_ALLOWED (0x5), OBJECT_DENIED (0x6)",
      "protected": []
    },
    {
      "id": "s0036",
      "kind": "paragraph",
      "text": "flags - OBJECT_INHERIT_FLAG (OI or 0x1), CONTAINER_INHERIT_FLAG (CI or 0x2), NO_PROPAGATE_INHERIT_FLAG (NI or 0x4), INHERIT_ONLY_FLAG (IO or 0x8), INHERITED_ACE_FLAG (IA or 0x10) or a combination/OR of these values.",
      "protected": []
    },
    {
      "id": "s0037",
      "kind": "paragraph",
      "text": "mask - Either one of FULL, CHANGE, READ, a combination of R W X D P O, or a hex value.",
      "protected": []
    },
    {
      "id": "s0038",
      "kind": "paragraph",
      "text": "Following fields of a SACL ACE can be modified with possible values:",
      "protected": []
    },
    {
      "id": "s0039",
      "kind": "paragraph",
      "text": "SID - Either a name or a raw SID value.",
      "protected": []
    },
    {
      "id": "s0040",
      "kind": "paragraph",
      "text": "type - AUDIT (0x2), AUDIT_OBJECT (0x7), AUDIT_CALLBACK (0xD), AUDIT_CALLBACK_OBJECT (0xF), MANDATORY_LABEL (0x11), RESOURCE_ATTRIBUTE (0x12), SCOPED_POLICY_ID (0x13)",
      "protected": []
    },
    {
      "id": "s0041",
      "kind": "paragraph",
      "text": "flags - SUCCESSFULL_ACCESS (SA or 0x40), FAILED_ACCESS (FA or 0x80)",
      "protected": []
    },
    {
      "id": "s0042",
      "kind": "paragraph",
      "text": "mask - Either one of FULL, CHANGE, READ, a combination of R W X D P O, or a hex value.",
      "protected": []
    },
    {
      "id": "s0043",
      "kind": "heading",
      "text": "EXAMPLES",
      "protected": []
    },
    {
      "id": "s0044",
      "kind": "heading",
      "text": "Add an ACE",
      "protected": []
    },
    {
      "id": "s0045",
      "kind": "paragraph",
      "text": "setcifsacl [[p0]] \"ACL:CIFSTESTDOM\\user2:DENIED/0x1/D\" <file_name>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-a"
        }
      ]
    },
    {
      "id": "s0046",
      "kind": "paragraph",
      "text": "setcifsacl [[p0]] \"ACL:CIFSTESTDOM\\user1:ALLOWED/OI|CI|NI/D\" <file_name>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-a"
        }
      ]
    },
    {
      "id": "s0047",
      "kind": "paragraph",
      "text": "setcifsacl [[p0]] [[p1]] \"ACL:CIFSTESTDOM\\user1:AUDIT/SA/D\" <file_name>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-U"
        },
        {
          "token": "[[p1]]",
          "text": "-a"
        }
      ]
    },
    {
      "id": "s0048",
      "kind": "heading",
      "text": "Add an ACE and reorder ACL",
      "protected": []
    },
    {
      "id": "s0049",
      "kind": "paragraph",
      "text": "setcifsacl [[p0]] \"ACL:CIFSTESTDOMuser3:ALLOWED/OI/FULL\" <file_name> setcifsacl [[p1]] \"ACL:CIFSTESTDOMuser2:DENIED/0x1/D\" <file_name> setcifsacl [[p2]] \"ACL:CIFSTESTDOMuser1:ALLOWED/OI|CI|NI/D\" <file_name>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-A"
        },
        {
          "token": "[[p1]]",
          "text": "-A"
        },
        {
          "token": "[[p2]]",
          "text": "-A"
        }
      ]
    },
    {
      "id": "s0050",
      "kind": "paragraph",
      "text": "After setting above mentioned ACEs, below is output of getcifsacl: ACL:CIFSTESTDOMuser2:DENIED/0x1/D ACL:CIFSTESTDOMuser3:ALLOWED/OI/FULL ACL:CIFSTESTDOMuser1:ALLOWED/OI|CI|NI/D",
      "protected": []
    },
    {
      "id": "s0051",
      "kind": "heading",
      "text": "Delete an ACE",
      "protected": []
    },
    {
      "id": "s0052",
      "kind": "paragraph",
      "text": "setcifsacl [[p0]] \"ACL:S-1-1-0:0x1/OI/0x1201ff\" <file_name>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-D"
        }
      ]
    },
    {
      "id": "s0053",
      "kind": "paragraph",
      "text": "setcifsacl [[p0]] [[p1]] \"ACL:S-1-1-0:0x2/FA/0xf01ff\" <file_name>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-U"
        },
        {
          "token": "[[p1]]",
          "text": "-D"
        }
      ]
    },
    {
      "id": "s0054",
      "kind": "heading",
      "text": "Modify an ACE",
      "protected": []
    },
    {
      "id": "s0055",
      "kind": "paragraph",
      "text": "setcifsacl [[p0]] \"ACL:CIFSTESTDOM\\user1:ALLOWED/0x1f/CHANGE\" <file_name>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-M"
        }
      ]
    },
    {
      "id": "s0056",
      "kind": "paragraph",
      "text": "setcifsacl [[p0]] [[p1]] \"ACL:CIFSTESTDOM\\user1:AUDIT_OBJECT/SA/CHANGE\" <file_name>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-U"
        },
        {
          "token": "[[p1]]",
          "text": "-M"
        }
      ]
    },
    {
      "id": "s0057",
      "kind": "heading",
      "text": "Set an ACL",
      "protected": []
    },
    {
      "id": "s0058",
      "kind": "paragraph",
      "text": "setcifsacl [[p0]] \"ACL:CIFSTESTDOM\\Administrator:0x0/0x0/FULL,ACL:CIFSTESTDOM\\user2:0x0/0x0/FULL\" <file_name>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-S"
        }
      ]
    },
    {
      "id": "s0059",
      "kind": "paragraph",
      "text": "setcifsacl [[p0]] [[p1]] \"ACL:CIFSTESTDOM\\Administrator:AUDIT/SA/FULL,ACL:CIFSTESTDOM\\user2:0x7/0x80/FULL\" <file_name>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-U"
        },
        {
          "token": "[[p1]]",
          "text": "-S"
        }
      ]
    },
    {
      "id": "s0060",
      "kind": "heading",
      "text": "Set owner SID",
      "protected": []
    },
    {
      "id": "s0061",
      "kind": "paragraph",
      "text": "setcifsacl [[p0]] \"S-1-5-21-3338130290-3403600371-1423429424-2102\" <file_name>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-o"
        }
      ]
    },
    {
      "id": "s0062",
      "kind": "heading",
      "text": "Set group SID",
      "protected": []
    },
    {
      "id": "s0063",
      "kind": "paragraph",
      "text": "setcifsacl [[p0]] \"Administrators@BUILTIN\" <file_name>",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-g"
        }
      ]
    },
    {
      "id": "s0064",
      "kind": "heading",
      "text": "NOTES",
      "protected": []
    },
    {
      "id": "s0065",
      "kind": "paragraph",
      "text": "Kernel support for getcifsacl/setcifsacl utilities was initially introduced in the 2.6.37 kernel.",
      "protected": []
    },
    {
      "id": "s0066",
      "kind": "heading",
      "text": "SEE ALSO",
      "protected": []
    },
    {
      "id": "s0067",
      "kind": "paragraph",
      "text": "mount.cifs(8), getcifsacl(1)",
      "protected": []
    },
    {
      "id": "s0068",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0069",
      "kind": "paragraph",
      "text": "Shirish Pargaonkar wrote the setcifsacl program.",
      "protected": []
    },
    {
      "id": "s0070",
      "kind": "paragraph",
      "text": "The Linux CIFS Mailing list is the preferred place to ask questions regarding these programs.",
      "protected": []
    }
  ]
}
