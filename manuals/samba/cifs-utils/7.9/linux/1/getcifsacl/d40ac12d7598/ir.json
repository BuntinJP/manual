  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "getcifsacl",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "heading",
      "text": "Userspace helper to display an ACL in a security descriptor for Common Internet File System (CIFS)",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "term",
      "text": "Manual section:",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "1",
      "protected": []
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "SYNOPSIS",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "getcifsacl [[[p0]]|[[p1]]] {file system object}",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-v"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "-r"
          }
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "This tool is part of the cifs-utils suite.",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "getcifsacl is a userspace helper program for the Linux CIFS client file system. It is intended to display a security descriptor, including DACL and SACL for a file system object.",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "This program uses a plugin to handle the mapping of SIDs to user and group names. [[p0]]@pluginpath@[[p1]] should be a symlink that points to the correct plugin to use.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "style-open",
            "style": "em"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "style-close",
            "style": "em"
          }
        }
      ]
    },
    {
      "id": "s0011",
      "kind": "paragraph",
      "text": "Fields of an ACE such as SID, type, flags, and mask are displayed separated by /. Numeric values of type, flags, and mask are displayed in hexadecimal format.",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-v"
          }
        }
      ]
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "Print version number and exit.",
      "protected": []
    },
    {
      "id": "s0015",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-r"
          }
        }
      ]
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "Display a security descriptor in raw mode. Values such as type and flags are displayed in hexadecimal format, a SID is not mapped to a name.",
      "protected": []
    },
    {
      "id": "s0017",
      "kind": "term",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-R"
          }
        }
      ]
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "List the ACLs of all files and directories recursively.",
      "protected": []
    },
    {
      "id": "s0019",
      "kind": "heading",
      "text": "NOTES",
      "protected": []
    },
    {
      "id": "s0020",
      "kind": "paragraph",
      "text": "Kernel support for getcifsacl/setcifsacl utilities was initially introduced in the 2.6.37 kernel.",
      "protected": []
    },
    {
      "id": "s0021",
      "kind": "heading",
      "text": "SEE ALSO",
      "protected": []
    },
    {
      "id": "s0022",
      "kind": "paragraph",
      "text": "mount.cifs(8), setcifsacl(1)",
      "protected": []
    },
    {
      "id": "s0023",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0024",
      "kind": "paragraph",
      "text": "Shirish Pargaonkar wrote the getcifsacl program.",
      "protected": []
    },
    {
      "id": "s0025",
      "kind": "paragraph",
      "text": "The Linux CIFS Mailing list is the preferred place to ask questions regarding these programs.",
      "protected": []
    }
  ],
