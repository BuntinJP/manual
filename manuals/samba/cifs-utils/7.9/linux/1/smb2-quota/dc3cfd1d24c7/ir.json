  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "smb2-quota",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "heading",
      "text": "Userspace helper to display quota information for the Linux SMB client file system (CIFS)",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "term",
      "text": "Manual section:",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "1",
      "protected": []
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "SYNOPSIS",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "smb2-quota [[[p0]]] {options} {file system object}",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-h"
          }
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0008",
      "kind": "paragraph",
      "text": "This tool is part of the cifs-utils suite.",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "smb2-quota is a userspace helper program for the Linux SMB client file system (CIFS).",
      "protected": []
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "This tool works by making an CIFS_QUERY_INFO IOCTL call to the Linux SMB client which in turn issues a SMB Query Info request and returns the result.",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "[[p0]]/[[p1]]: Print help explaining the command line options.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--help"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "-h"
          }
        }
      ]
    },
    {
      "id": "s0013",
      "kind": "paragraph",
      "text": "[[p0]]/[[p1]]: Print quota information for the volume in tabular format. Amount Used | Quota Limit | Warning Level | Percent Used | Status | SID",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--tabular"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "-t"
          }
        }
      ]
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "[[p0]]/[[p1]]: Print quota information for the volume in csv format. SID,Amount Used,Quota Limit,Warning Level",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--csv"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "-c"
          }
        }
      ]
    },
    {
      "id": "s0015",
      "kind": "paragraph",
      "text": "[[p0]]/[[p1]]: Print quota information for the volume in raw format. - SID - Quota Used - Quota Threshold - Quota Limit",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--list"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "-l"
          }
        }
      ]
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "[[p0]]/[[p1]] is the default action if none is given.",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "--tabular"
          }
        },
        {
          "token": "[[p1]]",
          "inline": {
            "tag": "code",
            "text": "-t"
          }
        }
      ]
    },
    {
      "id": "s0017",
      "kind": "heading",
      "text": "NOTES",
      "protected": []
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "Kernel support for smb2-quota requires the CIFS_QUERY_INFO IOCTL which was initially introduced in the 4.20 kernel and is only implemented for mount points using SMB2 or above (see mount.cifs(8) vers option).",
      "protected": []
    },
    {
      "id": "s0019",
      "kind": "heading",
      "text": "SEE ALSO",
      "protected": []
    },
    {
      "id": "s0020",
      "kind": "paragraph",
      "text": "smbinfo(1)",
      "protected": []
    },
    {
      "id": "s0021",
      "kind": "heading",
      "text": "AUTHOR",
      "protected": []
    },
    {
      "id": "s0022",
      "kind": "paragraph",
      "text": "Kenneth D'souza <kdsouza@redhat.com>",
      "protected": []
    },
    {
      "id": "s0023",
      "kind": "paragraph",
      "text": "The Linux CIFS Mailing list is the preferred place to ask questions regarding these programs.",
      "protected": []
    }
  ],
