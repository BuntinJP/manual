    {
      "id": "s0038",
      "kind": "heading",
      "text": "STANDARDS",
      "protected": []
    },
    {
      "id": "s0039",
      "kind": "paragraph",
      "text": "The [[p0]] utility is compliant with the IEEE Std 1003.1-2008 (“POSIX.1”) specification.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "cut"
        }
      ]
    },
    {
      "id": "s0040",
      "kind": "heading",
      "text": "HISTORY",
      "protected": []
    },
    {
      "id": "s0041",
      "kind": "paragraph",
      "text": "A [[p0]] command first appeared outside Bell Labs in AT&T System III UNIX and has been available since 4.3BSD-Reno.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "cut"
        }
      ]
