      "kind": "paragraph",
      "text": "[[p0]] [[p1]] [[[p2]]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-c"
          }
        },
        {
          "token": "[[p1]]",
