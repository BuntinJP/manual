    {
      "id": "s0001",
      "kind": "heading",
      "text": "NAME",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "[[p0]] — select portions of each line of a file",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "cut"
          }
        }
      ]
    },
