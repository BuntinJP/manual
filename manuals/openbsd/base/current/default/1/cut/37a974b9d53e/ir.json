          }
        }
      ]
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "[[p0]] [[p1]] [[[p2]]] [[[p3]] [[p4]]] [[[p5]]]",
      "protected": [
        {
          "token": "[[p0]]",
          "inline": {
            "tag": "code",
            "text": "-f"
          }
        },
        {
          "token": "[[p1]]",
