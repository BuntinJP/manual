  "segments": [
    {
      "id": "s0001",
      "kind": "heading",
      "text": "NAME",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "col - filter reverse line feeds from input",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "SYNOPSIS",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "[[p0]] [[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "col"
        },
        {
          "token": "[[p1]]",
          "text": "options"
        }
      ]
    },
    {
      "id": "s0005",
      "kind": "heading",
      "text": "DESCRIPTION",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "[[p0]] filters out reverse (and half-reverse) line feeds so the output is in the correct order, with only forward and half-forward line feeds. It also replaces any whitespace characters with tabs where possible. This can be useful in processing the output of [[p1]](1) and [[p2]](1).",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "col"
        },
        {
          "token": "[[p1]]",
          "text": "nroff"
        },
        {
          "token": "[[p2]]",
          "text": "tbl"
        }
      ]
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "[[p0]] reads from standard input and writes to standard output.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "col"
        }
      ]
    },
    {
      "id": "s0008",
      "kind": "heading",
      "text": "OPTIONS",
      "protected": []
    },
    {
      "id": "s0009",
      "kind": "paragraph",
      "text": "[[p0]], [[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-b"
        },
        {
          "token": "[[p1]]",
          "text": "--no-backspaces"
        }
      ]
    },
    {
      "id": "s0010",
      "kind": "paragraph",
      "text": "Do not output any backspaces, printing only the last character written to each column position.",
      "protected": []
    },
    {
      "id": "s0011",
      "kind": "paragraph",
      "text": "[[p0]], [[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-f"
        },
        {
          "token": "[[p1]]",
          "text": "--fine"
        }
      ]
    },
    {
      "id": "s0012",
      "kind": "paragraph",
      "text": "Permit half-forward line feeds. Normally characters destined for a half-line boundary are printed on the following line.",
      "protected": []
    },
    {
      "id": "s0013",
      "kind": "paragraph",
      "text": "[[p0]], [[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-h"
        },
        {
          "token": "[[p1]]",
          "text": "--tabs"
        }
      ]
    },
    {
      "id": "s0014",
      "kind": "paragraph",
      "text": "Output tabs instead of multiple spaces.",
      "protected": []
    },
    {
      "id": "s0015",
      "kind": "paragraph",
      "text": "[[p0]], [[p1]] [[p2]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-l"
        },
        {
          "token": "[[p1]]",
          "text": "--lines"
        },
        {
          "token": "[[p2]]",
          "text": "number"
        }
      ]
    },
    {
      "id": "s0016",
      "kind": "paragraph",
      "text": "Buffer at least [[p0]] lines in memory. By default, 128 lines are buffered.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "number"
        }
      ]
    },
    {
      "id": "s0017",
      "kind": "paragraph",
      "text": "[[p0]], [[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-p"
        },
        {
          "token": "[[p1]]",
          "text": "--pass"
        }
      ]
    },
    {
      "id": "s0018",
      "kind": "paragraph",
      "text": "Force unknown control sequences to be passed through unchanged. Normally [[p0]] will filter out any control sequences other than those recognized and interpreted by itself, which are listed below.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "col"
        }
      ]
    },
    {
      "id": "s0019",
      "kind": "paragraph",
      "text": "[[p0]], [[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-x"
        },
        {
          "token": "[[p1]]",
          "text": "--spaces"
        }
      ]
    },
    {
      "id": "s0020",
      "kind": "paragraph",
      "text": "Output multiple spaces instead of tabs.",
      "protected": []
    },
    {
      "id": "s0021",
      "kind": "paragraph",
      "text": "[[p0]], [[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-H"
        },
        {
          "token": "[[p1]]",
          "text": "--help"
        }
      ]
    },
    {
      "id": "s0022",
      "kind": "paragraph",
      "text": "Display help text and exit.",
      "protected": []
    },
    {
      "id": "s0023",
      "kind": "paragraph",
      "text": "[[p0]], [[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-V"
        },
        {
          "token": "[[p1]]",
          "text": "--version"
        }
      ]
    },
    {
      "id": "s0024",
      "kind": "paragraph",
      "text": "Display version and exit.",
      "protected": []
    },
    {
      "id": "s0025",
      "kind": "heading",
      "text": "CONFORMING TO",
      "protected": []
    },
    {
      "id": "s0026",
      "kind": "paragraph",
      "text": "The [[p0]] utility conforms to the Single UNIX Specification, Version 2. The [[p1]] option is an extension to the standard.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "col"
        },
        {
          "token": "[[p1]]",
          "text": "-l"
        }
      ]
    },
    {
      "id": "s0027",
      "kind": "heading",
      "text": "NOTES",
      "protected": []
    },
    {
      "id": "s0028",
      "kind": "paragraph",
      "text": "The control sequences for carriage motion that [[p0]] understands and their decimal values are listed in the following table:",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "col"
        }
      ]
    },
    {
      "id": "s0029",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "ESC-7"
        }
      ]
    },
    {
      "id": "s0030",
      "kind": "paragraph",
      "text": "reverse line feed (escape then 7)",
      "protected": []
    },
    {
      "id": "s0031",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "ESC-8"
        }
      ]
    },
    {
      "id": "s0032",
      "kind": "paragraph",
      "text": "half reverse line feed (escape then 8)",
      "protected": []
    },
    {
      "id": "s0033",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "ESC-9"
        }
      ]
    },
    {
      "id": "s0034",
      "kind": "paragraph",
      "text": "half forward line feed (escape then 9)",
      "protected": []
    },
    {
      "id": "s0035",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "backspace"
        }
      ]
    },
    {
      "id": "s0036",
      "kind": "paragraph",
      "text": "moves back one column (8); ignored in the first column",
      "protected": []
    },
    {
      "id": "s0037",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "newline"
        }
      ]
    },
    {
      "id": "s0038",
      "kind": "paragraph",
      "text": "forward line feed (10); also does carriage return",
      "protected": []
    },
    {
      "id": "s0039",
      "kind": "paragraph",
      "text": "[[p0]]carriage return[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<strong>"
        },
        {
          "token": "[[p1]]",
          "text": "</strong>"
        }
      ]
    },
    {
      "id": "s0040",
      "kind": "paragraph",
      "text": "(13)",
      "protected": []
    },
    {
      "id": "s0041",
      "kind": "paragraph",
      "text": "[[p0]]shift in[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<strong>"
        },
        {
          "token": "[[p1]]",
          "text": "</strong>"
        }
      ]
    },
    {
      "id": "s0042",
      "kind": "paragraph",
      "text": "shift to normal character set (15)",
      "protected": []
    },
    {
      "id": "s0043",
      "kind": "paragraph",
      "text": "[[p0]]shift out[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<strong>"
        },
        {
          "token": "[[p1]]",
          "text": "</strong>"
        }
      ]
    },
    {
      "id": "s0044",
      "kind": "paragraph",
      "text": "shift to alternate character set (14)",
      "protected": []
    },
    {
      "id": "s0045",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "space"
        }
      ]
    },
    {
      "id": "s0046",
      "kind": "paragraph",
      "text": "moves forward one column (32)",
      "protected": []
    },
    {
      "id": "s0047",
      "kind": "paragraph",
      "text": "[[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "tab"
        }
      ]
    },
    {
      "id": "s0048",
      "kind": "paragraph",
      "text": "moves forward to next tab stop (9)",
      "protected": []
    },
    {
      "id": "s0049",
      "kind": "paragraph",
      "text": "[[p0]]vertical tab[[p1]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "<strong>"
        },
        {
          "token": "[[p1]]",
          "text": "</strong>"
        }
      ]
    },
    {
      "id": "s0050",
      "kind": "paragraph",
      "text": "reverse line feed (11)",
      "protected": []
    },
    {
      "id": "s0051",
      "kind": "paragraph",
      "text": "All unrecognized control characters and escape sequences are discarded.",
      "protected": []
    },
    {
      "id": "s0052",
      "kind": "paragraph",
      "text": "[[p0]] keeps track of the character set as characters are read and makes sure the character set is correct when they are output.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "col"
        }
      ]
    },
    {
      "id": "s0053",
      "kind": "paragraph",
      "text": "If the input attempts to back up to the last flushed line, [[p0]] will display a warning message.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "col"
        }
      ]
    },
    {
      "id": "s0054",
      "kind": "heading",
      "text": "HISTORY",
      "protected": []
    },
    {
      "id": "s0055",
      "kind": "paragraph",
      "text": "A [[p0]] command appeared in Version 6 AT&T UNIX.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "col"
        }
      ]
    },
    {
