      "id": "s0001",
      "kind": "heading",
      "text": "ConvertX",
      "protected": []
    },
    {
      "id": "s0002",
      "kind": "paragraph",
      "text": "A self-hosted online file converter. Supports over a thousand different formats. Written with TypeScript, Bun and Elysia.",
      "protected": []
    },
    {
      "id": "s0003",
      "kind": "heading",
      "text": "Features",
      "protected": []
    },
    {
      "id": "s0004",
      "kind": "paragraph",
      "text": "Convert files to different formats",
      "protected": []
    },
    {
      "id": "s0005",
      "kind": "paragraph",
      "text": "Process multiple files at once",
      "protected": []
    },
    {
      "id": "s0006",
      "kind": "paragraph",
      "text": "Password protection",
      "protected": []
    },
    {
      "id": "s0007",
      "kind": "paragraph",
      "text": "Multiple accounts",
      "protected": []
    },
    {
      "id": "s0008",
      "kind": "heading",
      "text": "Converters supported",
      "protected": []
    },
