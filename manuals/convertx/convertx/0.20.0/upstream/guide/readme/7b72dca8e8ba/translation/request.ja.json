    },
    {
      "id": "s0136",
      "kind": "paragraph",
      "text": "AUTO_DELETE_EVERY_N_HOURS",
      "protected": []
    },
    {
      "id": "s0137",
      "kind": "paragraph",
      "text": "24",
      "protected": []
    },
    {
      "id": "s0138",
      "kind": "paragraph",
      "text": "Checks every n hours for files older then n hours and deletes them, set to 0 to disable",
      "protected": []
    },
    {
      "id": "s0139",
      "kind": "paragraph",
      "text": "WEBROOT",
      "protected": []
    },
    {
      "id": "s0140",
      "kind": "paragraph",
      "text": "The address to the root path setting this to \"/convert\" will serve the website on \"example.com/convert/\"",
      "protected": []
    },
    {
      "id": "s0141",
      "kind": "paragraph",
      "text": "BRANDING",
      "protected": []
    },
    {
      "id": "s0142",
      "kind": "paragraph",
      "text": "ConvertX",
      "protected": []
    },
    {
      "id": "s0143",
      "kind": "paragraph",
      "text": "Custom string that allows you to change the display name of the website in the header (max 26 characters)",
      "protected": []
    },
    {
      "id": "s0144",
      "kind": "paragraph",
      "text": "FFMPEG_ARGS",
      "protected": []
    },
    {
      "id": "s0145",
      "kind": "paragraph",
      "text": "Arguments to pass to the input file of ffmpeg, e.g. [[p0]]. See [[p1]] for more info about hw-acceleration.",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-hwaccel vaapi"
        },
        {
          "token": "[[p1]]",
          "text": "#190"
        }
      ]
    },
    {
      "id": "s0146",
      "kind": "paragraph",
      "text": "FFMPEG_OUTPUT_ARGS",
      "protected": []
    },
    {
      "id": "s0147",
      "kind": "paragraph",
      "text": "Arguments to pass to the output of ffmpeg, e.g. [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "-preset veryfast"
        }
      ]
    },
    {
      "id": "s0148",
      "kind": "paragraph",
      "text": "HIDE_HISTORY",
      "protected": []
    },
    {
      "id": "s0149",
      "kind": "paragraph",
      "text": "false",
      "protected": []
    },
    {
      "id": "s0150",
      "kind": "paragraph",
      "text": "Hide the history page",
      "protected": []
    },
    {
      "id": "s0151",
      "kind": "paragraph",
      "text": "LANGUAGE",
      "protected": []
    },
    {
      "id": "s0152",
      "kind": "paragraph",
      "text": "en",
      "protected": []
    },
    {
      "id": "s0153",
      "kind": "paragraph",
      "text": "Language to format date strings in, specified as a [[p0]]",
      "protected": [
        {
          "token": "[[p0]]",
          "text": "BCP 47 language tag"
        }
      ]
    },
    {
      "id": "s0154",
      "kind": "paragraph",
      "text": "UNAUTHENTICATED_USER_SHARING",
      "protected": []
    },
    {
      "id": "s0155",
      "kind": "paragraph",
      "text": "false",
      "protected": []
    },
    {
      "id": "s0156",
      "kind": "paragraph",
      "text": "Shares conversion history between all unauthenticated users",
      "protected": []
    },
    {
      "id": "s0157",
      "kind": "paragraph",
      "text": "MAX_CONVERT_PROCESS",
      "protected": []
    },
    {
      "id": "s0158",
      "kind": "paragraph",
      "text": "0",
      "protected": []
    },
    {
      "id": "s0159",
      "kind": "paragraph",
      "text": "Maximum number of concurrent conversion processes allowed. Set to 0 for unlimited.",
      "protected": []
    },
    {
      "id": "s0160",
      "kind": "paragraph",
      "text": "PORT",
      "protected": []
    },
    {
      "id": "s0161",
      "kind": "paragraph",
      "text": "3000",
      "protected": []
    },
    {
      "id": "s0162",
      "kind": "paragraph",
      "text": "Application listen port",
      "protected": []
    },
