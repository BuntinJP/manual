    "segments": {
      "s0001": "名前",
      "s0002": "vfs_audit — 選択された Samba VFS 操作をシステムログに記録する",
      "s0003": "書式",
      "s0004": "[[p0]]",
      "s0005": "説明",
      "s0006": "この VFS モジュールは [[p0]] スイートの一部です。",
      "s0007": "[[p0]] VFS モジュールは、[[p1]] を使用して選択されたクライアント操作をシステムログに記録します。",
      "s0008": "次の Samba VFS 操作が記録されます。",
      "s0009": "connect",
      "s0010": "disconnect",
      "s0011": "opendir",
      "s0012": "mkdir",
      "s0013": "rmdir",
      "s0014": "open",
      "s0015": "close",
      "s0016": "rename",
      "s0017": "unlink",
      "s0018": "chmod",
      "s0019": "fchmod",
      "s0020": "このモジュールはスタック可能です。",
      "s0021": "オプション",
      "s0022": "audit:facility = FACILITY",
      "s0023": "指定した [[p0]] ファシリティーにメッセージを記録します。",
      "s0024": "audit:priority = PRIORITY",
      "s0025": "指定した [[p0]] 優先度でメッセージを記録します。",
      "s0026": "使用例",
      "s0027": "LOCAL1 ファシリティーと NOTICE 優先度を使用して、すべての共有の操作を記録します。",
      "s0028": "バージョン",
      "s0029": "このマニュアルページは Samba スイートのバージョン 4.25.0 の一部です。",
      "s0030": "著者",
      "s0031": "元の Samba ソフトウェアと関連ユーティリティーは Andrew Tridgell が作成しました。現在、Samba は Linux カーネルと同様の開発方法で、Samba Team によるオープンソースプロジェクトとして開発されています。"
    }
  },
